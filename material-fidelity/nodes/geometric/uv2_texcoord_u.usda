#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "uv2_texcoord_u" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/uv2_texcoord_u/uv2_texcoord_u.mtlx"
                string sourceMaterial = "M_uv2_texcoord_u"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/uv2_texcoord_u/SR_uv2_texcoord_u.outputs:out>
        token outputs:surface.connect = </Looks/uv2_texcoord_u/SR_uv2_texcoord_u.outputs:out>

        def Shader "SR_uv2_texcoord_u"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_uv2_texcoord_u"
        {
            color3f outputs:out_base_color.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u/base_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                int inputs:index = 1
                float2 outputs:out
            }

            def Shader "split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "axis_value"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u/split.outputs:outx>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "inverse_axis_value"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1 = 1
                float inputs:in2.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u/axis_value.outputs:out>
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u/axis_value.outputs:out>
                float inputs:in2 = 0
                float inputs:in3.connect = </Looks/uv2_texcoord_u/NG_uv2_texcoord_u/inverse_axis_value.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/uv2_texcoord_u>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/uv2_texcoord_u.exr"
        }
    }
}
