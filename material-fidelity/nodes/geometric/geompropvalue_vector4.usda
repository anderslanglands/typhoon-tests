#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "geompropvalue_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/geompropvalue/geompropvalue_vector4.mtlx"
                string sourceMaterial = "M_geompropvalue_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/geompropvalue_vector4/surface.outputs:out>
        token outputs:surface.connect = </Looks/geompropvalue_vector4/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/geompropvalue_vector4/NG_geompropvalue_vector4.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/geompropvalue_vector4/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_geompropvalue_vector4"
        {
            color3f outputs:out_base_color.connect = </Looks/geompropvalue_vector4/NG_geompropvalue_vector4/to_color.outputs:out>

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_geompropvalue_vector4"
                string inputs:geomprop = "testVector4"
                float4 inputs:default = (0, 0, 0, 0)
                float4 outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_vector4_color3"
                float4 inputs:in.connect = </Looks/geompropvalue_vector4/NG_geompropvalue_vector4/node_under_test.outputs:out>
                color3f outputs:out
            }
        }

    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float4[] primvars:testVector4 = [(1, 0, 0, 1), (0, 1, 0, 1), (1, 1, 1, 1), (1, 0, 0, 1)] (
            interpolation = "vertex"
        )
        rel material:binding = </Looks/geompropvalue_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/geompropvalue_vector4.exr"
        }
    }
}
