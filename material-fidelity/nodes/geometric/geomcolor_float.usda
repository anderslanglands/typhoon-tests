#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "geomcolor_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/geomcolor/geomcolor_float.mtlx"
                string sourceMaterial = "M_geomcolor_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/geomcolor_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/geomcolor_float/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/geomcolor_float/NG_geomcolor_float.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/geomcolor_float/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_geomcolor_float"
        {
            color3f outputs:out_base_color.connect = </Looks/geomcolor_float/NG_geomcolor_float/to_color.outputs:out>

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_geomcolor_float"
                int inputs:index = 0
                float outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_float_color3"
                float inputs:in.connect = </Looks/geomcolor_float/NG_geomcolor_float/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float[] primvars:geomColor = [1, 0.65, 0.35, 0] (
            interpolation = "vertex"
        )
        rel material:binding = </Looks/geomcolor_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/geomcolor_float.exr"
        }
    }
}
