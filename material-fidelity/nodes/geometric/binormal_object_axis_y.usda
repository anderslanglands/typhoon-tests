#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "binormal_object_axis_y" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/binormal_object_axis_y/binormal_object_axis_y.mtlx"
                string sourceMaterial = "M_binormal_object_axis_y"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/binormal_object_axis_y/SR_binormal_object_axis_y.outputs:out>
        token outputs:surface.connect = </Looks/binormal_object_axis_y/SR_binormal_object_axis_y.outputs:out>

        def Shader "SR_binormal_object_axis_y"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_binormal_object_axis_y"
        {
            color3f outputs:out_base_color.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y/base_color.outputs:out>

            def Shader "bitangent0"
            {
                uniform token info:id = "ND_bitangent_vector3"
                int inputs:index = 0
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "split"
            {
                uniform token info:id = "ND_separate3_vector3"
                float3 inputs:in.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y/bitangent0.outputs:out>
                float outputs:outx
                float outputs:outy
                float outputs:outz
            }

            def Shader "axis_value"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y/split.outputs:outy>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "inverse_axis_value"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1 = 1
                float inputs:in2.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y/axis_value.outputs:out>
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y/axis_value.outputs:out>
                float inputs:in2 = 0
                float inputs:in3.connect = </Looks/binormal_object_axis_y/NG_binormal_object_axis_y/inverse_axis_value.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/binormal_object_axis_y>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/binormal_object_axis_y.exr"
        }
    }
}
