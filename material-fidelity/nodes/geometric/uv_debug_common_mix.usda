#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "uv_debug_common_mix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/uv_debug_common_mix/uv_debug_common_mix.mtlx"
                string sourceMaterial = "M_uv_debug_common_mix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/uv_debug_common_mix/SR_uv_debug_common_mix.outputs:out>
        token outputs:surface.connect = </Looks/uv_debug_common_mix/SR_uv_debug_common_mix.outputs:out>

        def Shader "SR_uv_debug_common_mix"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0, 0, 0)
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix.outputs:out_base_color>
            float inputs:specular = 0
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_uv_debug_common_mix"
        {
            color3f outputs:out_base_color.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "uv_color_hot"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.95
                float inputs:in2.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_split.outputs:outx>
                float inputs:in3 = 0.2
                color3f outputs:out
            }

            def Shader "uv_color_cool"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.1
                float inputs:in2.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_split.outputs:outy>
                float inputs:in3 = 0.8
                color3f outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_color_cool.outputs:out>
                color3f inputs:fg.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_color_hot.outputs:out>
                float inputs:mix.connect = </Looks/uv_debug_common_mix/NG_uv_debug_common_mix/uv_mix.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/uv_debug_common_mix>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/uv_debug_common_mix.exr"
        }
    }
}
