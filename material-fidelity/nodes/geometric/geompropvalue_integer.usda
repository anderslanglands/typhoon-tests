#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "geompropvalue_integer" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/geompropvalue/geompropvalue_integer.mtlx"
                string sourceMaterial = "M_geompropvalue_integer"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/geompropvalue_integer/surface.outputs:out>
        token outputs:surface.connect = </Looks/geompropvalue_integer/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/geompropvalue_integer/NG_geompropvalue_integer.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/geompropvalue_integer/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_geompropvalue_integer"
        {
            color3f outputs:out_base_color.connect = </Looks/geompropvalue_integer/NG_geompropvalue_integer/to_color.outputs:out>

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_geompropvalue_integer"
                string inputs:geomprop = "testInteger"
                int inputs:default = 0
                int outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_integer_color3"
                int inputs:in.connect = </Looks/geompropvalue_integer/NG_geompropvalue_integer/node_under_test.outputs:out>
                color3f outputs:out
            }
        }

    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] primvars:testInteger = [1] (
            interpolation = "uniform"
        )
        rel material:binding = </Looks/geompropvalue_integer>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/geompropvalue_integer.exr"
        }
    }
}
