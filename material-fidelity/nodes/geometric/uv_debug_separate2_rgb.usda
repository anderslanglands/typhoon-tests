#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "uv_debug_separate2_rgb" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/uv_debug_separate2_rgb/uv_debug_separate2_rgb.mtlx"
                string sourceMaterial = "M_uv_debug_separate2_rgb"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/uv_debug_separate2_rgb/SR_uv_debug_separate2_rgb.outputs:out>
        token outputs:surface.connect = </Looks/uv_debug_separate2_rgb/SR_uv_debug_separate2_rgb.outputs:out>

        def Shader "SR_uv_debug_separate2_rgb"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0, 0, 0)
            float inputs:emission = 1
            color3f inputs:emission_color.connect = </Looks/uv_debug_separate2_rgb/NG_uv_debug_separate2_rgb.outputs:out_base_color>
            float inputs:specular = 0
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_uv_debug_separate2_rgb"
        {
            color3f outputs:out_base_color.connect = </Looks/uv_debug_separate2_rgb/NG_uv_debug_separate2_rgb/separate2_rgb.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/uv_debug_separate2_rgb/NG_uv_debug_separate2_rgb/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "separate2_rgb"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/uv_debug_separate2_rgb/NG_uv_debug_separate2_rgb/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/uv_debug_separate2_rgb/NG_uv_debug_separate2_rgb/uv_split.outputs:outy>
                float inputs:in3 = 0.25
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/uv_debug_separate2_rgb>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/geometric/uv_debug_separate2_rgb.exr"
        }
    }
}
