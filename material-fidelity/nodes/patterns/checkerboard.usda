#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "checkerboard" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/checkerboard/checkerboard.mtlx"
                string sourceMaterial = "M_checkerboard"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/checkerboard/SR_checkerboard.outputs:out>
        token outputs:surface.connect = </Looks/checkerboard/SR_checkerboard.outputs:out>

        def Shader "SR_checkerboard"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/checkerboard/NG_checkerboard.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_checkerboard"
        {
            color3f outputs:out_base_color.connect = </Looks/checkerboard/NG_checkerboard/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "checker_uv"
            {
                uniform token info:id = "ND_multiply_vector2"
                float2 inputs:in1.connect = </Looks/checkerboard/NG_checkerboard/uv0.outputs:out>
                float2 inputs:in2 = (2, 2)
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_checkerboard_color3"
                color3f inputs:color1 = (0, 0, 0)
                color3f inputs:color2 = (1, 1, 1)
                float2 inputs:texcoord.connect = </Looks/checkerboard/NG_checkerboard/checker_uv.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/checkerboard>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/patterns/checkerboard.exr"
        }
    }
}
