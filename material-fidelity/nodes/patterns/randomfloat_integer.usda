#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_randomfloat_integer on the plane using explicit UV0 texcoords. The graph partitions U into eight clamped vertical bands with indices 0 through 7, feeds that band index into the randomfloat node, and sets min = 0.1, max = 0.9, and seed = 7. The float output is packed into RGB as (value, 0, 0). The expected render is eight deterministic constant red-channel bands with values in the 0.1 to 0.9 range and green/blue at zero; the exact red values are defined by the MaterialX randomfloat implementation and should remain stable for the same band index and seed."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "randomfloat_integer" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/randomfloat/randomfloat_integer.mtlx"
                string sourceMaterial = "M_randomfloat_integer"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/randomfloat_integer/surface.outputs:out>
        token outputs:surface.connect = </Looks/randomfloat_integer/surface.outputs:out>

        def Shader "texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "separate_uv"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/randomfloat_integer/texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "scale_u"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/randomfloat_integer/separate_uv.outputs:outx>
            float inputs:in2 = 8
            float outputs:out
        }
        def Shader "band_raw"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Looks/randomfloat_integer/scale_u.outputs:out>
            float outputs:out
        }
        def Shader "band_index"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Looks/randomfloat_integer/band_raw.outputs:out>
            float inputs:low = 0
            float inputs:high = 7
            float outputs:out
        }
        def Shader "band_index_integer"
        {
            uniform token info:id = "ND_floor_integer"
            float inputs:in.connect = </Looks/randomfloat_integer/band_index.outputs:out>
            int outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_randomfloat_integer"
            int inputs:in.connect = </Looks/randomfloat_integer/band_index_integer.outputs:out>
            float inputs:min = 0.1
            float inputs:max = 0.9
            int inputs:seed = 7
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/randomfloat_integer/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/randomfloat_integer/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/randomfloat_integer/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/randomfloat_integer>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/patterns/randomfloat_integer.exr"
        }
    }
}
