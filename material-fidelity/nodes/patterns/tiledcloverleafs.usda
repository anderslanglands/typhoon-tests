#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "tiledcloverleafs" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/tiledcloverleafs/tiledcloverleafs.mtlx"
                string sourceMaterial = "M_tiledcloverleafs"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/tiledcloverleafs/surface.outputs:out>
        token outputs:surface.connect = </Looks/tiledcloverleafs/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/tiledcloverleafs/NG_tiledcloverleafs.outputs:out_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/tiledcloverleafs/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_tiledcloverleafs"
        {
            color3f outputs:out_color.connect = </Looks/tiledcloverleafs/NG_tiledcloverleafs/color_mix.outputs:out>

            def Shader "texcoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_tiledcloverleafs_color3"
                float2 inputs:texcoord.connect = </Looks/tiledcloverleafs/NG_tiledcloverleafs/texcoord.outputs:out>
                float2 inputs:uvtiling = (2, 2)
                float inputs:size = 0.65
                bool inputs:staggered = 0
                color3f outputs:out
            }

            def Shader "mask_channel"
            {
                uniform token info:id = "ND_separate3_color3"
                color3f inputs:in.connect = </Looks/tiledcloverleafs/NG_tiledcloverleafs/node_under_test.outputs:out>
                float outputs:outb
                float outputs:outg
                float outputs:outr
            }

            def Shader "color_mix"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.05, 0.12, 0.35)
                color3f inputs:fg = (1, 0.45, 0.05)
                float inputs:mix.connect = </Looks/tiledcloverleafs/NG_tiledcloverleafs/mask_channel.outputs:outr>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/tiledcloverleafs>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/patterns/tiledcloverleafs.exr"
        }
    }
}
