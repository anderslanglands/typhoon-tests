#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "randomcolor" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/randomcolor/randomcolor.mtlx"
                string sourceMaterial = "M_randomcolor"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/randomcolor/surface.outputs:out>
        token outputs:surface.connect = </Looks/randomcolor/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/randomcolor/NG_randomcolor.outputs:out_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/randomcolor/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_randomcolor"
        {
            color3f outputs:out_color.connect = </Looks/randomcolor/NG_randomcolor/node_under_test.outputs:out>

            def Shader "texcoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "separate_uv"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/randomcolor/NG_randomcolor/texcoord.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "scale_u"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/randomcolor/NG_randomcolor/separate_uv.outputs:outx>
                float inputs:in2 = 8
                float outputs:out
            }

            def Shader "band_index"
            {
                uniform token info:id = "ND_floor_float"
                float inputs:in.connect = </Looks/randomcolor/NG_randomcolor/scale_u.outputs:out>
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_randomcolor_float"
                float inputs:in.connect = </Looks/randomcolor/NG_randomcolor/band_index.outputs:out>
                int inputs:seed = 7
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/randomcolor>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/patterns/randomcolor.exr"
        }
    }
}
