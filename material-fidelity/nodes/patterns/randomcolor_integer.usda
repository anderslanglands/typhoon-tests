#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_randomcolor_integer on the plane using explicit UV0 texcoords. The graph partitions U into eight clamped vertical bands with indices 0 through 7, feeds that integer band index into the randomcolor node, and uses seed 7 with authored hue range 0.05 to 0.70, saturation range 0.45 to 0.90, and brightness range 0.35 to 0.95. The color3 output is connected directly to uniform_edf.color. The expected render is eight deterministic pseudo-random constant color bands constrained by those HSV ranges; the exact colors are defined by the MaterialX randomcolor implementation and should remain stable for the same band index, seed, and ranges."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "randomcolor_integer" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/randomcolor/randomcolor_integer.mtlx"
                string sourceMaterial = "M_randomcolor_integer"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/randomcolor_integer/surface.outputs:out>
        token outputs:surface.connect = </Looks/randomcolor_integer/surface.outputs:out>

        def Shader "texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "separate_uv"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/randomcolor_integer/texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "scale_u"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/randomcolor_integer/separate_uv.outputs:outx>
            float inputs:in2 = 8
            float outputs:out
        }
        def Shader "band_raw"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Looks/randomcolor_integer/scale_u.outputs:out>
            float outputs:out
        }
        def Shader "band_index"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Looks/randomcolor_integer/band_raw.outputs:out>
            float inputs:low = 0
            float inputs:high = 7
            float outputs:out
        }
        def Shader "band_index_integer"
        {
            uniform token info:id = "ND_floor_integer"
            float inputs:in.connect = </Looks/randomcolor_integer/band_index.outputs:out>
            int outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_randomcolor_integer"
            int inputs:in.connect = </Looks/randomcolor_integer/band_index_integer.outputs:out>
            float inputs:huelow = 0.05
            float inputs:huehigh = 0.70
            float inputs:saturationlow = 0.45
            float inputs:saturationhigh = 0.90
            float inputs:brightnesslow = 0.35
            float inputs:brightnesshigh = 0.95
            int inputs:seed = 7
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/randomcolor_integer/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/randomcolor_integer/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/randomcolor_integer>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/patterns/randomcolor_integer.exr"
        }
    }
}
