#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "hexagon" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/hexagon/hexagon.mtlx"
                string sourceMaterial = "M_hexagon"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/hexagon/surface.outputs:out>
        token outputs:surface.connect = </Looks/hexagon/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/hexagon/NG_hexagon.outputs:out_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/hexagon/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_hexagon"
        {
            color3f outputs:out_color.connect = </Looks/hexagon/NG_hexagon/color_mix.outputs:out>

            def Shader "texcoord"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_hexagon_float"
                float2 inputs:center = (0.5, 0.5)
                float inputs:radius = 0.35
                float2 inputs:texcoord.connect = </Looks/hexagon/NG_hexagon/texcoord.outputs:out>
                float outputs:out
            }

            def Shader "color_mix"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg = (0.05, 0.12, 0.35)
                color3f inputs:fg = (1, 0.45, 0.05)
                float inputs:mix.connect = </Looks/hexagon/NG_hexagon/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/hexagon>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/patterns/hexagon.exr"
        }
    }
}
