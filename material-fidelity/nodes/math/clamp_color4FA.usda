#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_clamp_color4FA with literal in = (-0.1, 0.35, 1.2, 0.8), low = 0.2, and high = 0.7. The spec clamps each component between low and high, so the node result is (0.2, 0.35, 0.7, 0.7). The four-channel result is packed into RGB as (r, g, b + a), so the expected emitted RGB is (0.2, 0.35, 1.4)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "clamp_color4FA" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/clamp/clamp_color4FA.mtlx"
                string sourceMaterial = "M_clamp_color4FA"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/clamp_color4FA/surface.outputs:out>
        token outputs:surface.connect = </Looks/clamp_color4FA/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_clamp_color4FA"
            color4f inputs:in = (-0.1, 0.35, 1.2, 0.8)
            float inputs:low = 0.2
            float inputs:high = 0.7
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/clamp_color4FA/node_under_test.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/clamp_color4FA/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/clamp_color4FA/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/clamp_color4FA/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/clamp_color4FA/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/clamp_color4FA/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/clamp_color4FA/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/clamp_color4FA/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/clamp_color4FA>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/clamp_color4FA.exr"
        }
    }
}
