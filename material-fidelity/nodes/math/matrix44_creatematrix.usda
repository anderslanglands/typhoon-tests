#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "matrix44_creatematrix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/matrix44_creatematrix/matrix44_creatematrix.mtlx"
                string sourceMaterial = "M_matrix44_creatematrix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/matrix44_creatematrix/SR_matrix44_creatematrix.outputs:out>
        token outputs:surface.connect = </Looks/matrix44_creatematrix/SR_matrix44_creatematrix.outputs:out>

        def Shader "SR_matrix44_creatematrix"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_matrix44_creatematrix"
        {
            color3f outputs:out_base_color.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_wave"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "row3_a"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv_split.outputs:outx>
                float inputs:in2 = 0
                float inputs:in3 = 1
                float3 outputs:out
            }

            def Shader "matrix_from_vector3"
            {
                uniform token info:id = "ND_creatematrix_vector3_matrix44"
                float3 inputs:in1 = (1, 0, 0)
                float3 inputs:in2 = (0, 1, 0)
                float3 inputs:in3.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row3_a.outputs:out>
                float3 inputs:in4 = (0.15, 0.1, 0)
                matrix4d outputs:out
            }

            def Shader "row4_b"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv_split.outputs:outy>
                float inputs:in2 = 0
                float inputs:in3.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/uv_wave.outputs:out>
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "matrix_from_vector4"
            {
                uniform token info:id = "ND_creatematrix_vector4_matrix44"
                float4 inputs:in1 = (1, 0, 0, 0)
                float4 inputs:in2 = (0, 1, 0, 0)
                float4 inputs:in3 = (0, 0, 1, 0)
                float4 inputs:in4.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row4_b.outputs:out>
                matrix4d outputs:out
            }

            def Shader "row_from_vector3_matrix"
            {
                uniform token info:id = "ND_extract_matrix44"
                matrix4d inputs:in.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/matrix_from_vector3.outputs:out>
                int inputs:index = 2
                float4 outputs:out
            }

            def Shader "row_from_vector4_matrix"
            {
                uniform token info:id = "ND_extract_matrix44"
                matrix4d inputs:in.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/matrix_from_vector4.outputs:out>
                int inputs:index = 3
                float4 outputs:out
            }

            def Shader "row3_channels"
            {
                uniform token info:id = "ND_separate4_vector4"
                float4 inputs:in.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row_from_vector3_matrix.outputs:out>
                float outputs:outw
                float outputs:outx
                float outputs:outy
                float outputs:outz
            }

            def Shader "row4_channels"
            {
                uniform token info:id = "ND_separate4_vector4"
                float4 inputs:in.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row_from_vector4_matrix.outputs:out>
                float outputs:outw
                float outputs:outx
                float outputs:outy
                float outputs:outz
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row3_channels.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row4_channels.outputs:outz>
                float inputs:in3.connect = </Looks/matrix44_creatematrix/NG_matrix44_creatematrix/row4_channels.outputs:outw>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/matrix44_creatematrix>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/matrix44_creatematrix.exr"
        }
    }
}
