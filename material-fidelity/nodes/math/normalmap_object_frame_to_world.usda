#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "normalmap_object_frame_to_world" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/normalmap_object_frame_to_world/normalmap_object_frame_to_world.mtlx"
                string sourceMaterial = "M_normalmap_object_frame_to_world"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/normalmap_object_frame_to_world/surface.outputs:out>
        token outputs:surface.connect = </Looks/normalmap_object_frame_to_world/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/normalmap_object_frame_to_world/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_normalmap_object_frame_to_world"
        {
            color3f outputs:out_base_color.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "normal_image"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @../../_assets/Materials/showcase/standard_surface/brick_procedural/textures/brick_normal.jpg@ (
                    colorSpace = "none"
                )
                float2 inputs:texcoord.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/uv0.outputs:out>
                float3 outputs:out
            }

            def Shader "n_object"
            {
                uniform token info:id = "ND_normal_vector3"
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "t_object"
            {
                uniform token info:id = "ND_tangent_vector3"
                int inputs:index = 0
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "b_object"
            {
                uniform token info:id = "ND_bitangent_vector3"
                int inputs:index = 0
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "n_world"
            {
                uniform token info:id = "ND_transformnormal_vector3"
                string inputs:fromspace = "object"
                float3 inputs:in.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/n_object.outputs:out>
                string inputs:tospace = "world"
                float3 outputs:out
            }

            def Shader "t_world"
            {
                uniform token info:id = "ND_transformvector_vector3"
                string inputs:fromspace = "object"
                float3 inputs:in.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/t_object.outputs:out>
                string inputs:tospace = "world"
                float3 outputs:out
            }

            def Shader "b_world"
            {
                uniform token info:id = "ND_transformvector_vector3"
                string inputs:fromspace = "object"
                float3 inputs:in.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/b_object.outputs:out>
                string inputs:tospace = "world"
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:bitangent.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/b_world.outputs:out>
                float3 inputs:in.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/normal_image.outputs:out>
                float3 inputs:normal.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/n_world.outputs:out>
                float inputs:scale = 1
                float3 inputs:tangent.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/t_world.outputs:out>
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/node_under_test.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/normalmap_object_frame_to_world/NG_normalmap_object_frame_to_world/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/normalmap_object_frame_to_world>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/normalmap_object_frame_to_world.exr"
        }
    }
}
