#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_subtract_vector2FA with literal inputs in1 = (0.7, 0.6) and in2 = 0.2, by subtracting in1 and in2. The node result is (0.5, 0.4). The vector2 result is converted to color3 as (x, y, 0), so the expected emitted RGB is (0.5, 0.4, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "subtract_vector2FA" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/subtract/subtract_vector2FA.mtlx"
                string sourceMaterial = "M_subtract_vector2FA"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/subtract_vector2FA/surface.outputs:out>
        token outputs:surface.connect = </Looks/subtract_vector2FA/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_subtract_vector2FA"
            float2 inputs:in1 = (0.7, 0.6)
            float inputs:in2 = 0.2
            float2 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector2_color3"
            float2 inputs:in.connect = </Looks/subtract_vector2FA/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/subtract_vector2FA/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/subtract_vector2FA/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/subtract_vector2FA>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/subtract_vector2FA.exr"
        }
    }
}
