#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_sign_color4 with literal in = (-0.25, 0, 0.5, -0.75), covering negative, zero, and positive components where the type permits it. The node result is (-1, 0, 1, -1). For display only, sign outputs are remapped with (value + 1) * 0.5 before RGB packing, so the expected emitted RGB is (0, 0.5, 1)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sign_color4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/sign/sign_color4.mtlx"
                string sourceMaterial = "M_sign_color4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sign_color4/surface.outputs:out>
        token outputs:surface.connect = </Looks/sign_color4/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_sign_color4"
            color4f inputs:in = (-0.25, 0, 0.5, -0.75)
            color4f outputs:out
        }
        def Shader "display_shift"
        {
            uniform token info:id = "ND_add_color4FA"
            color4f inputs:in1.connect = </Looks/sign_color4/node_under_test.outputs:out>
            float inputs:in2 = 1
            color4f outputs:out
        }
        def Shader "display_scaled"
        {
            uniform token info:id = "ND_multiply_color4FA"
            color4f inputs:in1.connect = </Looks/sign_color4/display_shift.outputs:out>
            float inputs:in2 = 0.5
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/sign_color4/display_scaled.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/sign_color4/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/sign_color4/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/sign_color4/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/sign_color4/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/sign_color4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/sign_color4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/sign_color4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/sign_color4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/sign_color4.exr"
        }
    }
}
