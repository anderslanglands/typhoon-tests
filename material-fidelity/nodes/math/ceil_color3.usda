#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ceil_color3 with literal in = (0.25, 0, 0.75). The node rounds each component up to the nearest integer, so the result is (1, 0, 1). The color3 result maps directly to RGB, so the expected emitted RGB is (1, 0, 1)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ceil_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ceil/ceil_color3.mtlx"
                string sourceMaterial = "M_ceil_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ceil_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/ceil_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ceil_color3"
            color3f inputs:in = (0.25, 0, 0.75)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ceil_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ceil_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ceil_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/ceil_color3.exr"
        }
    }
}
