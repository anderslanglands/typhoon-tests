#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_subtract_vector4FA with literal inputs in1 = (0.7, 0.6, 0.5, 0.4) and in2 = 0.2, by subtracting in1 and in2. The node result is (0.5, 0.4, 0.3, 0.2). The four-channel result is packed into RGB as (x, y, z + w), so the expected emitted RGB is (0.5, 0.4, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "subtract_vector4FA" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/subtract/subtract_vector4FA.mtlx"
                string sourceMaterial = "M_subtract_vector4FA"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/subtract_vector4FA/surface.outputs:out>
        token outputs:surface.connect = </Looks/subtract_vector4FA/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_subtract_vector4FA"
            float4 inputs:in1 = (0.7, 0.6, 0.5, 0.4)
            float inputs:in2 = 0.2
            float4 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Looks/subtract_vector4FA/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/subtract_vector4FA/display_channels.outputs:outz>
            float inputs:in2.connect = </Looks/subtract_vector4FA/display_channels.outputs:outw>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/subtract_vector4FA/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/subtract_vector4FA/display_channels.outputs:outy>
            float inputs:in3.connect = </Looks/subtract_vector4FA/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/subtract_vector4FA/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/subtract_vector4FA/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/subtract_vector4FA>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/subtract_vector4FA.exr"
        }
    }
}
