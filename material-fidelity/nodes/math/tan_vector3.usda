#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_tan_vector3 with literal radian inputs (0, 0.244978663, 0.463647609); the chosen angles have small positive tangent values. The node result is (0, 0.25, 0.5). The three-channel result maps directly to RGB, so the expected emitted RGB is (0, 0.25, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "tan_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/tan/tan_vector3.mtlx"
                string sourceMaterial = "M_tan_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/tan_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/tan_vector3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_tan_vector3"
            float3 inputs:in = (0, 0.244978663, 0.463647609)
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/tan_vector3/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/tan_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/tan_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/tan_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/tan_vector3.exr"
        }
    }
}
