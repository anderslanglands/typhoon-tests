#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sqrt_degenerate_negative_input" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/sqrt_degenerate_negative_input/sqrt_degenerate_negative_input.mtlx"
                string sourceMaterial = "M_sqrt_degenerate_negative_input"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sqrt_degenerate_negative_input/surface.outputs:out>
        token outputs:surface.connect = </Looks/sqrt_degenerate_negative_input/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/sqrt_degenerate_negative_input/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_sqrt_degenerate_negative_input"
        {
            color3f outputs:out_base_color.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "negative_input"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/uv_split.outputs:outx>
                float inputs:in2 = 1.1
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_sqrt_float"
                float inputs:in.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/negative_input.outputs:out>
                float outputs:out
            }

            def Shader "magnitude"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/node_under_test.outputs:out>
                float outputs:out
            }

            def Shader "wrapped"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/magnitude.outputs:out>
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/wrapped.outputs:out>
                float inputs:in2.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/uv_split.outputs:outx>
                float inputs:in3.connect = </Looks/sqrt_degenerate_negative_input/NG_sqrt_degenerate_negative_input/uv_split.outputs:outy>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/sqrt_degenerate_negative_input>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/sqrt_degenerate_negative_input.exr"
        }
    }
}
