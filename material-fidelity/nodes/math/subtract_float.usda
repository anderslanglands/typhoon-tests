#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_subtract_float with literal inputs in1 = 0.7 and in2 = 0.2, by subtracting in1 and in2. The node result is 0.5. The scalar result is converted to float and packed into red with green and blue zero, so the expected emitted RGB is (0.5, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "subtract_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/subtract/subtract_float.mtlx"
                string sourceMaterial = "M_subtract_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/subtract_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/subtract_float/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1 = 0.7
            float inputs:in2 = 0.2
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/subtract_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/subtract_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/subtract_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/subtract_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/subtract_float.exr"
        }
    }
}
