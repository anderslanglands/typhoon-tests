#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "rotate2d_identity" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/rotate2d_identity/material.mtlx"
                string sourceMaterial = "M_rotate2d_identity"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/rotate2d_identity/SR_rotate2d_identity.outputs:out>
        token outputs:surface.connect = </Looks/rotate2d_identity/SR_rotate2d_identity.outputs:out>

        def Shader "SR_rotate2d_identity"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/rotate2d_identity/NG_rotate2d_identity.outputs:out>
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_rotate2d_identity"
        {
            color3f outputs:out.connect = </Looks/rotate2d_identity/NG_rotate2d_identity/base_image.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_transform"
            {
                uniform token info:id = "ND_rotate2d_vector2"
                float inputs:amount = 0
                float2 inputs:in.connect = </Looks/rotate2d_identity/NG_rotate2d_identity/uv0.outputs:out>
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/rotate2d_identity/NG_rotate2d_identity/uv_transform.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/rotate2d_identity>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/rotate2d_identity.exr"
        }
    }
}
