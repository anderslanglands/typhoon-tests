#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "normalize" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/normalize/normalize.mtlx"
                string sourceMaterial = "M_normalize"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/normalize/surface.outputs:out>
        token outputs:surface.connect = </Looks/normalize/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/normalize/NG_normalize.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/normalize/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_normalize"
        {
            color3f outputs:out_base_color.connect = </Looks/normalize/NG_normalize/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/normalize/NG_normalize/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mul"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/normalize/NG_normalize/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "uv_times4"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "uv_i_float"
            {
                uniform token info:id = "ND_floor_float"
                float inputs:in.connect = </Looks/normalize/NG_normalize/uv_times4.outputs:out>
                float outputs:out
            }

            def Shader "uv_i"
            {
                uniform token info:id = "ND_constant_integer"
                int inputs:value = 0
                int outputs:out
            }

            def Shader "uv_bool"
            {
                uniform token info:id = "ND_ifgreater_boolean"
                float inputs:value1.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float inputs:value2 = 0.5
                bool outputs:out
            }

            def Shader "uv_scale"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1 = 1
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "uv_offset"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_mul.outputs:out>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "uv_vec3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float3 outputs:out
            }

            def Shader "uv_normal"
            {
                uniform token info:id = "ND_normalize_vector3"
                float3 inputs:in.connect = </Looks/normalize/NG_normalize/uv_vec3.outputs:out>
                float3 outputs:out
            }

            def Shader "uv_vec4"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "uv_color4"
            {
                uniform token info:id = "ND_combine4_color4"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float inputs:in4 = 1
                color4f outputs:out
            }

            def Shader "uv_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                color3f outputs:out
            }

            def Shader "uv_color_hot"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.95
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outx>
                float inputs:in3 = 0.2
                color3f outputs:out
            }

            def Shader "uv_color_cool"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.1
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_split.outputs:outy>
                float inputs:in3 = 0.8
                color3f outputs:out
            }

            def Shader "temp_driver"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 2500
                float inputs:in2 = 4000
                float outputs:out
            }

            def Shader "ior_driver"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 1.1
                float inputs:in2.connect = </Looks/normalize/NG_normalize/uv_mul.outputs:out>
                float outputs:out
            }

            def Shader "uv_rotate"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/normalize/NG_normalize/uv_mix.outputs:out>
                float inputs:in2 = 0.785398
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_normalize_vector3"
                float3 inputs:in.connect = </Looks/normalize/NG_normalize/uv_vec3.outputs:out>
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/normalize/NG_normalize/node_under_test.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/normalize/NG_normalize/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/normalize/NG_normalize/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/normalize>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/normalize.exr"
        }
    }
}
