#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ln_degenerate_nonpositive_input_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ln_degenerate_nonpositive_input_vector4/ln_degenerate_nonpositive_input_vector4.mtlx"
                string sourceMaterial = "M_ln_degenerate_nonpositive_input_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ln_degenerate_nonpositive_input_vector4/SR_ln_degenerate_nonpositive_input_vector4.outputs:out>
        token outputs:surface.connect = </Looks/ln_degenerate_nonpositive_input_vector4/SR_ln_degenerate_nonpositive_input_vector4.outputs:out>

        def Shader "SR_ln_degenerate_nonpositive_input_vector4"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_ln_degenerate_nonpositive_input_vector4"
        {
            color3f outputs:out_base_color.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "shifted_u"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/uv_split.outputs:outx>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "ln_in"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/shifted_u.outputs:out>
                float inputs:in2 = -0.5
                float inputs:in3 = 0
                float inputs:in4 = 0.75
                float4 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_ln_vector4"
                float4 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/ln_in.outputs:out>
                float4 outputs:out
            }

            def Shader "magnitude"
            {
                uniform token info:id = "ND_absval_vector4"
                float4 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/node_under_test.outputs:out>
                float4 outputs:out
            }

            def Shader "wrapped"
            {
                uniform token info:id = "ND_fract_vector4"
                float4 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/magnitude.outputs:out>
                float4 outputs:out
            }

            def Shader "debug_r"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/wrapped.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "debug_g"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/wrapped.outputs:out>
                int inputs:index = 2
                float outputs:out
            }

            def Shader "debug_b"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/wrapped.outputs:out>
                int inputs:index = 3
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/debug_r.outputs:out>
                float inputs:in2.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/debug_g.outputs:out>
                float inputs:in3.connect = </Looks/ln_degenerate_nonpositive_input_vector4/NG_ln_degenerate_nonpositive_input_vector4/debug_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ln_degenerate_nonpositive_input_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/ln_degenerate_nonpositive_input_vector4.exr"
        }
    }
}
