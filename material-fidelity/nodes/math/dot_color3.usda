#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dot_color3 with literal in = (0.2, 0.4, 0.6). Dot nodes are pass-through organization nodes, so the output should exactly equal the input. The three-channel result maps directly to RGB, so the expected emitted RGB is (0.2, 0.4, 0.6)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dot_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/dot/dot_color3.mtlx"
                string sourceMaterial = "M_dot_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/dot_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/dot_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dot_color3"
            color3f inputs:in = (0.2, 0.4, 0.6)
            string inputs:note = "pass-through fixture"
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/dot_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dot_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dot_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dot_color3.exr"
        }
    }
}
