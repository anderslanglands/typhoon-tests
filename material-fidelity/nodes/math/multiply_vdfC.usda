#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_multiply_vdfC by multiplying an anisotropic VDF, absorption (0.75, 0.35, 0.12), scattering (0.08, 0.18, 0.28), anisotropy 0.45, by color (0.35, 0.8, 0.6). The scaled volume is layered under zero-roughness dielectric transmission and reflection, so transmitted shaderball pixels should show the same volume behavior with component-wise color scaling."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "multiply_vdfC" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/multiply/multiply_vdfC.mtlx"
                string sourceMaterial = "M_multiply_vdfC"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/multiply_vdfC/surface.outputs:out>
        token outputs:surface.connect = </Looks/multiply_vdfC/surface.outputs:out>

        def Shader "specular_bsdf"
        {
            uniform token info:id = "ND_dielectric_bsdf"
            float2 inputs:roughness = (0, 0)
            string inputs:scatter_mode = "R"
            token outputs:out
        }

        def Shader "transmission_bsdf"
        {
            uniform token info:id = "ND_dielectric_bsdf"
            float2 inputs:roughness = (0, 0)
            string inputs:scatter_mode = "T"
            token outputs:out
        }

        def Shader "absorption_vdf"
        {
            uniform token info:id = "ND_absorption_vdf"
            float3 inputs:absorption = (0.75, 0.35, 0.12)
            token outputs:out
        }

        def Shader "anisotropic_vdf"
        {
            uniform token info:id = "ND_anisotropic_vdf"
            float3 inputs:absorption = (0.75, 0.35, 0.12)
            float3 inputs:scattering = (0.08, 0.18, 0.28)
            float inputs:anisotropy = 0.45
            token outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_multiply_vdfC"
            token inputs:in1.connect = </Looks/multiply_vdfC/anisotropic_vdf.outputs:out>
            color3f inputs:in2 = (0.35, 0.8, 0.6)
            token outputs:out
        }

        def Shader "transmission_layer"
        {
            uniform token info:id = "ND_layer_vdf"
            token inputs:top.connect = </Looks/multiply_vdfC/transmission_bsdf.outputs:out>
            token inputs:base.connect = </Looks/multiply_vdfC/node_under_test.outputs:out>
            token outputs:out
        }

        def Shader "surface_bsdf"
        {
            uniform token info:id = "ND_layer_bsdf"
            token inputs:top.connect = </Looks/multiply_vdfC/specular_bsdf.outputs:out>
            token inputs:base.connect = </Looks/multiply_vdfC/transmission_layer.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/multiply_vdfC/surface_bsdf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/multiply_vdfC>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/multiply_vdfC.exr"
        }
    }
}
