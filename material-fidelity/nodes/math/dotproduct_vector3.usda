#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dotproduct_vector3 with in1 = (0.2, 0.4, 0.5) and in2 = (0.5, 0.25, 0.2). The dot product is 0.2*0.5 + 0.4*0.25 + 0.5*0.2 = 0.3. The scalar result is packed into red with green and blue zero, so the expected emitted RGB is (0.3, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dotproduct_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/dotproduct/dotproduct_vector3.mtlx"
                string sourceMaterial = "M_dotproduct_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/dotproduct_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/dotproduct_vector3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dotproduct_vector3"
            float3 inputs:in1 = (0.2, 0.4, 0.5)
            float3 inputs:in2 = (0.5, 0.25, 0.2)
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/dotproduct_vector3/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/dotproduct_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dotproduct_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dotproduct_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dotproduct_vector3.exr"
        }
    }
}
