#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_multiply_vector2 with literal inputs in1 = (0.2, 0.4) and in2 = (0.5, 0.25), by multiplying in1 and in2. The node result is (0.1, 0.1). The vector2 result is converted to color3 as (x, y, 0), so the expected emitted RGB is (0.1, 0.1, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "multiply_vector2" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/multiply/multiply_vector2.mtlx"
                string sourceMaterial = "M_multiply_vector2"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/multiply_vector2/surface.outputs:out>
        token outputs:surface.connect = </Looks/multiply_vector2/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_multiply_vector2"
            float2 inputs:in1 = (0.2, 0.4)
            float2 inputs:in2 = (0.5, 0.25)
            float2 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector2_color3"
            float2 inputs:in.connect = </Looks/multiply_vector2/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/multiply_vector2/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/multiply_vector2/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/multiply_vector2>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/multiply_vector2.exr"
        }
    }
}
