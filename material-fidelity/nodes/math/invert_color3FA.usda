#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_invert_color3FA with literal in = (0.2, 0.4, 0.6) and scalar amount = 1; the spec computes amount - in component-wise. The node result is (0.8, 0.6, 0.4). The three-channel result maps directly to RGB, so the expected emitted RGB is (0.8, 0.6, 0.4)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "invert_color3FA" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/invert/invert_color3FA.mtlx"
                string sourceMaterial = "M_invert_color3FA"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/invert_color3FA/surface.outputs:out>
        token outputs:surface.connect = </Looks/invert_color3FA/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_invert_color3FA"
            color3f inputs:in = (0.2, 0.4, 0.6)
            float inputs:amount = 1
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/invert_color3FA/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/invert_color3FA/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/invert_color3FA>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/invert_color3FA.exr"
        }
    }
}
