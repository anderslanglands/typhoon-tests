#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dot_string with literal in = \"clamp\" by connecting the pass-through string output to ND_image_color3.uaddressmode. The image samples grid.exr with U offset by 0.5; because the forwarded address mode is clamp, U values above 1 clamp to the texture edge instead of wrapping."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dot_string"
    {
        token outputs:mtlx:surface.connect = </Looks/dot_string/surface.outputs:out>
        token outputs:surface.connect = </Looks/dot_string/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dot_string"
            string inputs:in = "clamp"
            string inputs:note = "pass-through fixture"
            string outputs:out
        }
        def Shader "texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "uv_offset"
        {
            uniform token info:id = "ND_add_vector2"
            float2 inputs:in1.connect = </Looks/dot_string/texcoord.outputs:out>
            float2 inputs:in2 = (0.5, 0)
            float2 outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 0, 1)
            asset inputs:file = @../../_assets/Materials/grid.exr@
            float2 inputs:texcoord.connect = </Looks/dot_string/uv_offset.outputs:out>
            string inputs:uaddressmode.connect = </Looks/dot_string/node_under_test.outputs:out>
            string inputs:vaddressmode = "constant"
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/dot_string/image.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dot_string/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dot_string>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dot_string.exr"
        }
    }
}
