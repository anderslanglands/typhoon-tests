#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_multiply_color3 with literal color3 inputs in1 = (0.8, 0.4, 0.2) and in2 = (0.25, 0.5, 0.75), by multiplying in1 and in2 component-wise. The node result is (0.2, 0.2, 0.15). The color3 result is connected directly to uniform_edf.color, so the expected emitted RGB on the plane is (0.2, 0.2, 0.15)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "multiply_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/multiply/multiply_color3.mtlx"
                string sourceMaterial = "M_multiply_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/multiply_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/multiply_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_multiply_color3"
            color3f inputs:in1 = (0.8, 0.4, 0.2)
            color3f inputs:in2 = (0.25, 0.5, 0.75)
            color3f outputs:out
        }

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/multiply_color3/node_under_test.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/multiply_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/multiply_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/multiply_color3.exr"
        }
    }
}
