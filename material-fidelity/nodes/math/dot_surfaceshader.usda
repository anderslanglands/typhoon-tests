#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dot_surfaceshader by feeding it a surface shader built from a uniform EDF color (0.2, 0.4, 0.6), then binding the dot output as the material surface. Since dot forwards its input unchanged, the plane should emit the same RGB color."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dot_surfaceshader"
    {
        token outputs:mtlx:surface.connect = </Looks/dot_surfaceshader/node_under_test.outputs:out>
        token outputs:surface.connect = </Looks/dot_surfaceshader/node_under_test.outputs:out>
        def Shader "input_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.2, 0.4, 0.6)
            token outputs:out
        }
        def Shader "input_surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dot_surfaceshader/input_edf.outputs:out>
            token outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dot_surfaceshader"
            token inputs:in.connect = </Looks/dot_surfaceshader/input_surface.outputs:out>
            string inputs:note = "pass-through fixture"
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dot_surfaceshader>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dot_surfaceshader.exr"
        }
    }
}
