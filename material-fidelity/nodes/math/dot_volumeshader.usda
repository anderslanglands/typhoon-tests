#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dot_volumeshader by forwarding the output of ND_volume. The upstream volume contains an absorption VDF with absorption (0.2, 0.4, 0.6), and the dot output is connected to the material volume output. A separate uniform EDF surface keeps the plane render visible; if the dot node is a true pass-through then the material receives the same volumeshader closure produced by the input."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dot_volumeshader"
    {
        token outputs:mtlx:surface.connect = </Looks/dot_volumeshader/surface.outputs:out>
        token outputs:surface.connect = </Looks/dot_volumeshader/surface.outputs:out>
        token outputs:mtlx:volume.connect = </Looks/dot_volumeshader/node_under_test.outputs:out>
        token outputs:volume.connect = </Looks/dot_volumeshader/node_under_test.outputs:out>
        def Shader "absorption_vdf"
        {
            uniform token info:id = "ND_absorption_vdf"
            float3 inputs:absorption = (0.2, 0.4, 0.6)
            token outputs:out
        }
        def Shader "input_volume"
        {
            uniform token info:id = "ND_volume"
            token inputs:vdf.connect = </Looks/dot_volumeshader/absorption_vdf.outputs:out>
            token outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dot_volumeshader"
            token inputs:in.connect = </Looks/dot_volumeshader/input_volume.outputs:out>
            string inputs:note = "pass-through fixture"
            token outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.3, 0.45, 0.6)
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dot_volumeshader/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dot_volumeshader>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dot_volumeshader.exr"
        }
    }
}
