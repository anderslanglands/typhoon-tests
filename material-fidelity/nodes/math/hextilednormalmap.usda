#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "hextilednormalmap" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/hextilednormalmap/hextilednormalmap.mtlx"
                string sourceMaterial = "M_hextilednormalmap"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/hextilednormalmap/surface.outputs:out>
        token outputs:surface.connect = </Looks/hextilednormalmap/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/hextilednormalmap/NG_hextilednormalmap.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/hextilednormalmap/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_hextilednormalmap"
        {
            color3f outputs:out_base_color.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mul"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "uv_times4"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "uv_i_float"
            {
                uniform token info:id = "ND_floor_float"
                float inputs:in.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_times4.outputs:out>
                float outputs:out
            }

            def Shader "uv_i"
            {
                uniform token info:id = "ND_constant_integer"
                int inputs:value = 0
                int outputs:out
            }

            def Shader "uv_bool"
            {
                uniform token info:id = "ND_ifgreater_boolean"
                float inputs:value1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float inputs:value2 = 0.5
                bool outputs:out
            }

            def Shader "uv_scale"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1 = 1
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "uv_offset"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mul.outputs:out>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "uv_vec3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float3 outputs:out
            }

            def Shader "uv_normal"
            {
                uniform token info:id = "ND_normalize_vector3"
                float3 inputs:in.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_vec3.outputs:out>
                float3 outputs:out
            }

            def Shader "uv_vec4"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "uv_color4"
            {
                uniform token info:id = "ND_combine4_color4"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float inputs:in4 = 1
                color4f outputs:out
            }

            def Shader "uv_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                color3f outputs:out
            }

            def Shader "uv_color_hot"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.95
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outx>
                float inputs:in3 = 0.2
                color3f outputs:out
            }

            def Shader "uv_color_cool"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.1
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_split.outputs:outy>
                float inputs:in3 = 0.8
                color3f outputs:out
            }

            def Shader "temp_driver"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 2500
                float inputs:in2 = 4000
                float outputs:out
            }

            def Shader "ior_driver"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 1.1
                float inputs:in2.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mul.outputs:out>
                float outputs:out
            }

            def Shader "uv_rotate"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float inputs:in2 = 0.785398
                float outputs:out
            }

            def Shader "t_world"
            {
                uniform token info:id = "ND_tangent_vector3"
                int inputs:index = 0
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "b_world"
            {
                uniform token info:id = "ND_bitangent_vector3"
                int inputs:index = 0
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_hextilednormalmap_vector3"
                float3 inputs:bitangent.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/b_world.outputs:out>
                float3 inputs:default.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_vec3.outputs:out>
                float inputs:falloff.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                asset inputs:file = @../../_assets/Materials/showcase/standard_surface/brick_procedural/textures/brick_normal.jpg@ (
                    colorSpace = "none"
                )
                bool inputs:flip_g.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_bool.outputs:out>
                float3 inputs:normal.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_normal.outputs:out>
                float inputs:offset.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float2 inputs:offsetrange.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_offset.outputs:out>
                float inputs:rotation.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_rotate.outputs:out>
                float2 inputs:rotationrange.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv0.outputs:out>
                float inputs:scale.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float2 inputs:scalerange.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_scale.outputs:out>
                float inputs:strength.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv_mix.outputs:out>
                float3 inputs:tangent.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/t_world.outputs:out>
                float2 inputs:texcoord.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv0.outputs:out>
                float2 inputs:tiling.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/uv0.outputs:out>
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/node_under_test.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/hextilednormalmap/NG_hextilednormalmap/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/hextilednormalmap>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/hextilednormalmap.exr"
        }
    }
}
