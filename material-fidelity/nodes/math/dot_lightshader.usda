#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dot_lightshader by forwarding the output of ND_light. The upstream light uses a uniform EDF color (0.2, 0.4, 0.6), intensity 1, and exposure 0, and the dot output is connected to the material light output. A separate uniform EDF surface keeps the plane render visible; if the dot node is a true pass-through then the material receives the same lightshader closure produced by the input."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dot_lightshader"
    {
        token outputs:mtlx:surface.connect = </Looks/dot_lightshader/surface.outputs:out>
        token outputs:surface.connect = </Looks/dot_lightshader/surface.outputs:out>
        token outputs:mtlx:light.connect = </Looks/dot_lightshader/node_under_test.outputs:out>
        token outputs:light.connect = </Looks/dot_lightshader/node_under_test.outputs:out>
        def Shader "input_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.2, 0.4, 0.6)
            token outputs:out
        }
        def Shader "input_light"
        {
            uniform token info:id = "ND_light"
            token inputs:edf.connect = </Looks/dot_lightshader/input_edf.outputs:out>
            float inputs:intensity = 1
            float inputs:exposure = 0
            token outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dot_lightshader"
            token inputs:in.connect = </Looks/dot_lightshader/input_light.outputs:out>
            string inputs:note = "pass-through fixture"
            token outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.35, 0.45, 0.55)
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dot_lightshader/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dot_lightshader>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dot_lightshader.exr"
        }
    }
}
