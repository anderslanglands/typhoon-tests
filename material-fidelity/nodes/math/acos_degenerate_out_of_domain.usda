#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "acos_degenerate_out_of_domain" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/acos_degenerate_out_of_domain/acos_degenerate_out_of_domain.mtlx"
                string sourceMaterial = "M_acos_degenerate_out_of_domain"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/acos_degenerate_out_of_domain/surface.outputs:out>
        token outputs:surface.connect = </Looks/acos_degenerate_out_of_domain/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/acos_degenerate_out_of_domain/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_acos_degenerate_out_of_domain"
        {
            color3f outputs:out_base_color.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "scaled_u"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/uv_split.outputs:outx>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "out_of_domain_input"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/scaled_u.outputs:out>
                float inputs:in2 = 1.5
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_acos_float"
                float inputs:in.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/out_of_domain_input.outputs:out>
                float outputs:out
            }

            def Shader "magnitude"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/node_under_test.outputs:out>
                float outputs:out
            }

            def Shader "wrapped"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/magnitude.outputs:out>
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/wrapped.outputs:out>
                float inputs:in2.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/uv_split.outputs:outx>
                float inputs:in3.connect = </Looks/acos_degenerate_out_of_domain/NG_acos_degenerate_out_of_domain/uv_split.outputs:outy>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/acos_degenerate_out_of_domain>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/acos_degenerate_out_of_domain.exr"
        }
    }
}
