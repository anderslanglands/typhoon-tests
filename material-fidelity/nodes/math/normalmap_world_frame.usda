#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "normalmap_world_frame" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/normalmap_world_frame/normalmap_world_frame.mtlx"
                string sourceMaterial = "M_normalmap_world_frame"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/normalmap_world_frame/SR_normalmap_world_frame.outputs:out>
        token outputs:surface.connect = </Looks/normalmap_world_frame/SR_normalmap_world_frame.outputs:out>

        def Shader "SR_normalmap_world_frame"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_normalmap_world_frame"
        {
            color3f outputs:out_base_color.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "normal_image"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @../../_assets/Materials/showcase/standard_surface/brick_procedural/textures/brick_normal.jpg@ (
                    colorSpace = "none"
                )
                float2 inputs:texcoord.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/uv0.outputs:out>
                float3 outputs:out
            }

            def Shader "n_world"
            {
                uniform token info:id = "ND_normal_vector3"
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "t_world"
            {
                uniform token info:id = "ND_tangent_vector3"
                int inputs:index = 0
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "b_world"
            {
                uniform token info:id = "ND_bitangent_vector3"
                int inputs:index = 0
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:bitangent.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/b_world.outputs:out>
                float3 inputs:in.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/normal_image.outputs:out>
                float3 inputs:normal.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/n_world.outputs:out>
                float inputs:scale = 1
                float3 inputs:tangent.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/t_world.outputs:out>
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/node_under_test.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/normalmap_world_frame/NG_normalmap_world_frame/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/normalmap_world_frame>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/normalmap_world_frame.exr"
        }
    }
}
