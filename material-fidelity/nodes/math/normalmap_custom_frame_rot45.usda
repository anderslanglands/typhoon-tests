#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "normalmap_custom_frame_rot45" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/normalmap_custom_frame_rot45/normalmap_custom_frame_rot45.mtlx"
                string sourceMaterial = "M_normalmap_custom_frame_rot45"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/normalmap_custom_frame_rot45/SR_normalmap_custom_frame_rot45.outputs:out>
        token outputs:surface.connect = </Looks/normalmap_custom_frame_rot45/SR_normalmap_custom_frame_rot45.outputs:out>

        def Shader "SR_normalmap_custom_frame_rot45"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_normalmap_custom_frame_rot45"
        {
            color3f outputs:out_base_color.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "normal_image"
            {
                uniform token info:id = "ND_image_vector3"
                asset inputs:file = @../../_assets/Materials/showcase/standard_surface/brick_procedural/textures/brick_normal.jpg@ (
                    colorSpace = "none"
                )
                float2 inputs:texcoord.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/uv0.outputs:out>
                float3 outputs:out
            }

            def Shader "n_world"
            {
                uniform token info:id = "ND_normal_vector3"
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "t_world"
            {
                uniform token info:id = "ND_tangent_vector3"
                int inputs:index = 0
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "b_world"
            {
                uniform token info:id = "ND_bitangent_vector3"
                int inputs:index = 0
                string inputs:space = "world"
                float3 outputs:out
            }

            def Shader "t_rot45"
            {
                uniform token info:id = "ND_rotate3d_vector3"
                float inputs:amount = 45
                float3 inputs:axis.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/n_world.outputs:out>
                float3 inputs:in.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/t_world.outputs:out>
                float3 outputs:out
            }

            def Shader "b_rot45"
            {
                uniform token info:id = "ND_rotate3d_vector3"
                float inputs:amount = 45
                float3 inputs:axis.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/n_world.outputs:out>
                float3 inputs:in.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/b_world.outputs:out>
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_normalmap_vector2"
                float3 inputs:bitangent.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/b_rot45.outputs:out>
                float3 inputs:in.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/normal_image.outputs:out>
                float3 inputs:normal.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/n_world.outputs:out>
                float2 inputs:scale = (1, -1)
                float3 inputs:tangent.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/t_rot45.outputs:out>
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/node_under_test.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/normalmap_custom_frame_rot45/NG_normalmap_custom_frame_rot45/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/normalmap_custom_frame_rot45>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/normalmap_custom_frame_rot45.exr"
        }
    }
}
