#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "rotate2d_rotate_30" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/rotate2d_rotate_30/material.mtlx"
                string sourceMaterial = "M_rotate2d_rotate_30"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/rotate2d_rotate_30/surface.outputs:out>
        token outputs:surface.connect = </Looks/rotate2d_rotate_30/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/rotate2d_rotate_30/NG_rotate2d_rotate_30.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/rotate2d_rotate_30/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_rotate2d_rotate_30"
        {
            color3f outputs:out.connect = </Looks/rotate2d_rotate_30/NG_rotate2d_rotate_30/base_image.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_transform"
            {
                uniform token info:id = "ND_rotate2d_vector2"
                float inputs:amount = 30
                float2 inputs:in.connect = </Looks/rotate2d_rotate_30/NG_rotate2d_rotate_30/uv0.outputs:out>
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/rotate2d_rotate_30/NG_rotate2d_rotate_30/uv_transform.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/rotate2d_rotate_30>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/rotate2d_rotate_30.exr"
        }
    }
}
