#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_cos_float with literal radian input 1.04719755. The node result is cos(in), which is 0.5. The scalar result is packed into red with green and blue zero, so the expected emitted RGB is (0.5, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "cos_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/cos/cos_float.mtlx"
                string sourceMaterial = "M_cos_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/cos_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/cos_float/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_cos_float"
            float inputs:in = 1.04719755
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/cos_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/cos_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/cos_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/cos_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/cos_float.exr"
        }
    }
}
