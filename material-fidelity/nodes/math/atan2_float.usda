#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_atan2_float with literal iny = 0.2 and inx = 1. The output is atan2(iny, inx) in radians, so the node result is 0.19739556. The scalar result is packed into red with green and blue zero, so the expected emitted RGB is (0.19739556, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "atan2_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/atan2/atan2_float.mtlx"
                string sourceMaterial = "M_atan2_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/atan2_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/atan2_float/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_atan2_float"
            float inputs:iny = 0.2
            float inputs:inx = 1
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/atan2_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/atan2_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/atan2_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/atan2_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/atan2_float.exr"
        }
    }
}
