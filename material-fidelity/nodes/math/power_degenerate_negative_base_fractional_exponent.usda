#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "power_degenerate_negative_base_fractional_exponent" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/power_degenerate_negative_base_fractional_exponent/power_degenerate_negative_base_fractional_exponent.mtlx"
                string sourceMaterial = "M_power_degenerate_negative_base_fractional_exponent"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/power_degenerate_negative_base_fractional_exponent/surface.outputs:out>
        token outputs:surface.connect = </Looks/power_degenerate_negative_base_fractional_exponent/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/power_degenerate_negative_base_fractional_exponent/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_power_degenerate_negative_base_fractional_exponent"
        {
            color3f outputs:out_base_color.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "negative_base"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1 = -0.75
                float inputs:in2.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/uv_split.outputs:outx>
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_power_float"
                float inputs:in1.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/negative_base.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "magnitude"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/node_under_test.outputs:out>
                float outputs:out
            }

            def Shader "wrapped"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/magnitude.outputs:out>
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/wrapped.outputs:out>
                float inputs:in2.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/uv_split.outputs:outx>
                float inputs:in3.connect = </Looks/power_degenerate_negative_base_fractional_exponent/NG_power_degenerate_negative_base_fractional_exponent/uv_split.outputs:outy>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/power_degenerate_negative_base_fractional_exponent>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/power_degenerate_negative_base_fractional_exponent.exr"
        }
    }
}
