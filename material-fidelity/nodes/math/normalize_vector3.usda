#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_normalize_vector3 with literal in = (1, 2, 2). The vector length is 3, so the normalized result is (0.333333333, 0.666666667, 0.666666667). The vector3 result is converted to color3 for display, so the expected emitted RGB is (0.333333333, 0.666666667, 0.666666667)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "normalize_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/normalize/normalize_vector3.mtlx"
                string sourceMaterial = "M_normalize_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/normalize_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/normalize_vector3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_normalize_vector3"
            float3 inputs:in = (1, 2, 2)
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/normalize_vector3/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/normalize_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/normalize_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/normalize_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/normalize_vector3.exr"
        }
    }
}
