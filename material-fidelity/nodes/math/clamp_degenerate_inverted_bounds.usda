#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "clamp_degenerate_inverted_bounds" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/clamp_degenerate_inverted_bounds/clamp_degenerate_inverted_bounds.mtlx"
                string sourceMaterial = "M_clamp_degenerate_inverted_bounds"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/clamp_degenerate_inverted_bounds/SR_clamp_degenerate_inverted_bounds.outputs:out>
        token outputs:surface.connect = </Looks/clamp_degenerate_inverted_bounds/SR_clamp_degenerate_inverted_bounds.outputs:out>

        def Shader "SR_clamp_degenerate_inverted_bounds"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_clamp_degenerate_inverted_bounds"
        {
            color3f outputs:out_base_color.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "centered_u"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/uv_split.outputs:outx>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "clamp_reference"
            {
                uniform token info:id = "ND_clamp_float"
                float inputs:high = 0.25
                float inputs:in.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/centered_u.outputs:out>
                float inputs:low = -0.25
                float outputs:out
            }

            def Shader "clamp_inverted"
            {
                uniform token info:id = "ND_clamp_float"
                float inputs:high = -0.25
                float inputs:in.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/centered_u.outputs:out>
                float inputs:low = 0.25
                float outputs:out
            }

            def Shader "reference_display"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/clamp_reference.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "inverted_display"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/clamp_inverted.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/reference_display.outputs:out>
                float inputs:in2.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/inverted_display.outputs:out>
                float inputs:in3.connect = </Looks/clamp_degenerate_inverted_bounds/NG_clamp_degenerate_inverted_bounds/uv_split.outputs:outy>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/clamp_degenerate_inverted_bounds>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/clamp_degenerate_inverted_bounds.exr"
        }
    }
}
