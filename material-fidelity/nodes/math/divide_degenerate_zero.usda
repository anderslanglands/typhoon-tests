#usda 1.0
(
    customLayerData = {
        string doc = "Tests a degenerate ND_divide_float case where the denominator is uv.x - 0.5, so the center vertical line divides by zero while the numerator is uv.y - 0.5. The displayed color is (fract(abs(result)), uv.x, uv.y), making non-finite or unstable divide behavior visible in red while green and blue confirm the plane UVs."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "divide_degenerate_zero" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/divide_degenerate_zero/divide_degenerate_zero.mtlx"
                string sourceMaterial = "M_divide_degenerate_zero"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/divide_degenerate_zero/surface.outputs:out>
        token outputs:surface.connect = </Looks/divide_degenerate_zero/surface.outputs:out>

        def Shader "texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "uv_split"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/divide_degenerate_zero/texcoord.outputs:out>
            float outputs:outx
            float outputs:outy
        }

        def Shader "numerator"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Looks/divide_degenerate_zero/uv_split.outputs:outy>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "denominator"
        {
            uniform token info:id = "ND_subtract_float"
            float inputs:in1.connect = </Looks/divide_degenerate_zero/uv_split.outputs:outx>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_divide_float"
            float inputs:in1.connect = </Looks/divide_degenerate_zero/numerator.outputs:out>
            float inputs:in2.connect = </Looks/divide_degenerate_zero/denominator.outputs:out>
            float outputs:out
        }

        def Shader "magnitude"
        {
            uniform token info:id = "ND_absval_float"
            float inputs:in.connect = </Looks/divide_degenerate_zero/node_under_test.outputs:out>
            float outputs:out
        }

        def Shader "wrapped"
        {
            uniform token info:id = "ND_fract_float"
            float inputs:in.connect = </Looks/divide_degenerate_zero/magnitude.outputs:out>
            float outputs:out
        }

        def Shader "debug_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/divide_degenerate_zero/wrapped.outputs:out>
            float inputs:in2.connect = </Looks/divide_degenerate_zero/uv_split.outputs:outx>
            float inputs:in3.connect = </Looks/divide_degenerate_zero/uv_split.outputs:outy>
            color3f outputs:out
        }

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/divide_degenerate_zero/debug_color.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/divide_degenerate_zero/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/divide_degenerate_zero>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/divide_degenerate_zero.exr"
        }
    }
}
