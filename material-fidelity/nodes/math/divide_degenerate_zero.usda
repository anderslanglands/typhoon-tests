#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "divide_degenerate_zero" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/divide_degenerate_zero/divide_degenerate_zero.mtlx"
                string sourceMaterial = "M_divide_degenerate_zero"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/divide_degenerate_zero/SR_divide_degenerate_zero.outputs:out>
        token outputs:surface.connect = </Looks/divide_degenerate_zero/SR_divide_degenerate_zero.outputs:out>

        def Shader "SR_divide_degenerate_zero"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_divide_degenerate_zero"
        {
            color3f outputs:out_base_color.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "numerator"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/uv_split.outputs:outy>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "denominator"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/uv_split.outputs:outx>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_divide_float"
                float inputs:in1.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/numerator.outputs:out>
                float inputs:in2.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/denominator.outputs:out>
                float outputs:out
            }

            def Shader "magnitude"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/node_under_test.outputs:out>
                float outputs:out
            }

            def Shader "wrapped"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/magnitude.outputs:out>
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/wrapped.outputs:out>
                float inputs:in2.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/uv_split.outputs:outx>
                float inputs:in3.connect = </Looks/divide_degenerate_zero/NG_divide_degenerate_zero/uv_split.outputs:outy>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/divide_degenerate_zero>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/divide_degenerate_zero.exr"
        }
    }
}
