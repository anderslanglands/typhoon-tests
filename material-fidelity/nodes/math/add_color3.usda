#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_add_color3 with literal color3 inputs in1 = (0.2, 0.3, 0.1) and in2 = (0.3, 0.1, 0.4), by adding in1 and in2 component-wise. The node result is (0.5, 0.4, 0.5). The color3 result is connected directly to uniform_edf.color, so the expected emitted RGB on the plane is (0.5, 0.4, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "add_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/add/add_color3.mtlx"
                string sourceMaterial = "M_add_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/add_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/add_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_add_color3"
            color3f inputs:in1 = (0.2, 0.3, 0.1)
            color3f inputs:in2 = (0.3, 0.1, 0.4)
            color3f outputs:out
        }

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/add_color3/node_under_test.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/add_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/add_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/add_color3.exr"
        }
    }
}
