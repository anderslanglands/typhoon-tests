#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_tan_vector2 with literal radian inputs (0, 0.244978663); the chosen angles have small positive tangent values. The node result is (0, 0.25). The vector2 result is packed as (x, y, 0), so the expected emitted RGB is (0, 0.25, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "tan_vector2" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/tan/tan_vector2.mtlx"
                string sourceMaterial = "M_tan_vector2"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/tan_vector2/surface.outputs:out>
        token outputs:surface.connect = </Looks/tan_vector2/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_tan_vector2"
            float2 inputs:in = (0, 0.244978663)
            float2 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/tan_vector2/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/tan_vector2/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/tan_vector2/display_channels.outputs:outy>
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/tan_vector2/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/tan_vector2/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/tan_vector2>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/tan_vector2.exr"
        }
    }
}
