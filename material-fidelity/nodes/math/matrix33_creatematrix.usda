#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "matrix33_creatematrix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/matrix33_creatematrix/matrix33_creatematrix.mtlx"
                string sourceMaterial = "M_matrix33_creatematrix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/matrix33_creatematrix/surface.outputs:out>
        token outputs:surface.connect = </Looks/matrix33_creatematrix/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/matrix33_creatematrix/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_matrix33_creatematrix"
        {
            color3f outputs:out_base_color.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_wave"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "row1"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 1
                float inputs:in2.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv_wave.outputs:out>
                float inputs:in3 = 0
                float3 outputs:out
            }

            def Shader "row2"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 0
                float inputs:in2 = 1
                float inputs:in3.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv_split.outputs:outx>
                float3 outputs:out
            }

            def Shader "row3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/uv_split.outputs:outy>
                float inputs:in2 = 0
                float inputs:in3 = 1
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_creatematrix_vector3_matrix33"
                float3 inputs:in1.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/row1.outputs:out>
                float3 inputs:in2.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/row2.outputs:out>
                float3 inputs:in3.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/row3.outputs:out>
                matrix3d outputs:out
            }

            def Shader "matrix_row"
            {
                uniform token info:id = "ND_extract_matrix33"
                matrix3d inputs:in.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/node_under_test.outputs:out>
                int inputs:index = 1
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/matrix33_creatematrix/NG_matrix33_creatematrix/matrix_row.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/matrix33_creatematrix>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/matrix33_creatematrix.exr"
        }
    }
}
