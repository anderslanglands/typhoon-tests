#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_dot_filename with literal asset in = ../../_assets/Materials/grid.exr by connecting the pass-through filename output directly to ND_image_color3.file. The plane should show grid.exr sampled by its UVs, proving the filename output is forwarded as an asset value."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dot_filename"
    {
        token outputs:mtlx:surface.connect = </Looks/dot_filename/surface.outputs:out>
        token outputs:surface.connect = </Looks/dot_filename/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_dot_filename"
            asset inputs:in = @../../_assets/Materials/grid.exr@
            string inputs:note = "pass-through fixture"
            asset outputs:out
        }
        def Shader "texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 0, 1)
            asset inputs:file.connect = </Looks/dot_filename/node_under_test.outputs:out>
            float2 inputs:texcoord.connect = </Looks/dot_filename/texcoord.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/dot_filename/image.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dot_filename/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dot_filename>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/dot_filename.exr"
        }
    }
}
