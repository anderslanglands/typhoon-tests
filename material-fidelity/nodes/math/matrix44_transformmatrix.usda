#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "matrix44_transformmatrix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/matrix44_transformmatrix/matrix44_transformmatrix.mtlx"
                string sourceMaterial = "M_matrix44_transformmatrix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/matrix44_transformmatrix/surface.outputs:out>
        token outputs:surface.connect = </Looks/matrix44_transformmatrix/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/matrix44_transformmatrix/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_matrix44_transformmatrix"
        {
            color3f outputs:out_base_color.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_wave"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "source_vec3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_wave.outputs:out>
                float3 outputs:out
            }

            def Shader "source_vec4"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_wave.outputs:out>
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "matrix_row1"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1 = 1.1
                float inputs:in2.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_wave.outputs:out>
                float inputs:in3 = 0
                float inputs:in4 = 0
                float4 outputs:out
            }

            def Shader "matrix_row2"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1 = 0
                float inputs:in2 = 0.9
                float inputs:in3.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outx>
                float inputs:in4 = 0
                float4 outputs:out
            }

            def Shader "matrix_row3"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/uv_split.outputs:outy>
                float inputs:in2 = 0
                float inputs:in3 = 1.2
                float inputs:in4 = 0
                float4 outputs:out
            }

            def Shader "matrix_row4"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1 = 0.15
                float inputs:in2 = 0.2
                float inputs:in3 = 0.05
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "source_matrix"
            {
                uniform token info:id = "ND_creatematrix_vector4_matrix44"
                float4 inputs:in1.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/matrix_row1.outputs:out>
                float4 inputs:in2.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/matrix_row2.outputs:out>
                float4 inputs:in3.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/matrix_row3.outputs:out>
                float4 inputs:in4.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/matrix_row4.outputs:out>
                matrix4d outputs:out
            }

            def Shader "transformed_vec3"
            {
                uniform token info:id = "ND_transformmatrix_vector3M4"
                float3 inputs:in.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/source_vec3.outputs:out>
                matrix4d inputs:mat.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/source_matrix.outputs:out>
                float3 outputs:out
            }

            def Shader "transformed_vec4"
            {
                uniform token info:id = "ND_transformmatrix_vector4"
                float4 inputs:in.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/source_vec4.outputs:out>
                matrix4d inputs:mat.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/source_matrix.outputs:out>
                float4 outputs:out
            }

            def Shader "vec3_channels"
            {
                uniform token info:id = "ND_separate3_vector3"
                float3 inputs:in.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/transformed_vec3.outputs:out>
                float outputs:outx
                float outputs:outy
                float outputs:outz
            }

            def Shader "vec4_channels"
            {
                uniform token info:id = "ND_separate4_vector4"
                float4 inputs:in.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/transformed_vec4.outputs:out>
                float outputs:outw
                float outputs:outx
                float outputs:outy
                float outputs:outz
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/vec3_channels.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/vec4_channels.outputs:outy>
                float inputs:in3.connect = </Looks/matrix44_transformmatrix/NG_matrix44_transformmatrix/vec4_channels.outputs:outz>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/matrix44_transformmatrix>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/matrix44_transformmatrix.exr"
        }
    }
}
