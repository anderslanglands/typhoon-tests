#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "matrix33_transformmatrix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/matrix33_transformmatrix/matrix33_transformmatrix.mtlx"
                string sourceMaterial = "M_matrix33_transformmatrix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/matrix33_transformmatrix/SR_matrix33_transformmatrix.outputs:out>
        token outputs:surface.connect = </Looks/matrix33_transformmatrix/SR_matrix33_transformmatrix.outputs:out>

        def Shader "SR_matrix33_transformmatrix"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_matrix33_transformmatrix"
        {
            color3f outputs:out_base_color.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_wave"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "source_vec3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_wave.outputs:out>
                float3 outputs:out
            }

            def Shader "row1"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 1.1
                float inputs:in2.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_wave.outputs:out>
                float inputs:in3 = 0
                float3 outputs:out
            }

            def Shader "row2"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 0
                float inputs:in2 = 0.8
                float inputs:in3.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_split.outputs:outx>
                float3 outputs:out
            }

            def Shader "row3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/uv_split.outputs:outy>
                float inputs:in2 = 0
                float inputs:in3 = 1
                float3 outputs:out
            }

            def Shader "source_matrix"
            {
                uniform token info:id = "ND_creatematrix_vector3_matrix33"
                float3 inputs:in1.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/row1.outputs:out>
                float3 inputs:in2.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/row2.outputs:out>
                float3 inputs:in3.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/row3.outputs:out>
                matrix3d outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_transformmatrix_vector3"
                float3 inputs:in.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/source_vec3.outputs:out>
                matrix3d inputs:mat.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/source_matrix.outputs:out>
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/matrix33_transformmatrix/NG_matrix33_transformmatrix/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/matrix33_transformmatrix>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/matrix33_transformmatrix.exr"
        }
    }
}
