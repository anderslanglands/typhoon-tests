#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "matrix33_transformmatrix_2d_scale" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/matrix33_transformmatrix_2d_scale/matrix33_transformmatrix_2d_scale.mtlx"
                string sourceMaterial = "M_matrix33_transformmatrix_2d_scale"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/matrix33_transformmatrix_2d_scale/SR_matrix33_transformmatrix_2d_scale.outputs:out>
        token outputs:surface.connect = </Looks/matrix33_transformmatrix_2d_scale/SR_matrix33_transformmatrix_2d_scale.outputs:out>

        def Shader "SR_matrix33_transformmatrix_2d_scale"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/matrix33_transformmatrix_2d_scale/NG_matrix33_transformmatrix_2d_scale.outputs:out_base_color>
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_matrix33_transformmatrix_2d_scale"
        {
            color3f outputs:out_base_color.connect = </Looks/matrix33_transformmatrix_2d_scale/NG_matrix33_transformmatrix_2d_scale/base_image.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_transform"
            {
                uniform token info:id = "ND_transformmatrix_vector2M3"
                float2 inputs:in.connect = </Looks/matrix33_transformmatrix_2d_scale/NG_matrix33_transformmatrix_2d_scale/uv0.outputs:out>
                matrix3d inputs:mat = ( (1.6, 0, 0), (0, 0.7, 0), (0, 0, 1) )
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/matrix33_transformmatrix_2d_scale/NG_matrix33_transformmatrix_2d_scale/uv_transform.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/matrix33_transformmatrix_2d_scale>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/math/matrix33_transformmatrix_2d_scale.exr"
        }
    }
}
