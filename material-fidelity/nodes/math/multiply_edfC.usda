#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_multiply_edfC by multiplying a uniform EDF color (1, 0.25, 0.08) by color (0.35, 0.8, 0.6). The product is emitted through ND_surface.edf, so the plane should render RGB (0.35, 0.2, 0.048) apart from renderer sampling noise."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "multiply_edfC" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/multiply/multiply_edfC.mtlx"
                string sourceMaterial = "M_multiply_edfC"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/multiply_edfC/surface.outputs:out>
        token outputs:surface.connect = </Looks/multiply_edfC/surface.outputs:out>

        def Shader "edf_warm"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (1, 0.25, 0.08)
            token outputs:out
        }

        def Shader "edf_cool"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.08, 0.35, 1)
            token outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_multiply_edfC"
            token inputs:in1.connect = </Looks/multiply_edfC/edf_warm.outputs:out>
            color3f inputs:in2 = (0.35, 0.8, 0.6)
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/multiply_edfC/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/multiply_edfC>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/multiply_edfC.exr"
        }
    }
}
