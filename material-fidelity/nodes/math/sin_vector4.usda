#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_sin_vector4 with literal radian inputs (0, 0.523598776, 1.57079633, 0.785398163); the spec computes sine component-wise. The node result is (0, 0.5, 1, 0.707106781). The four-channel result is packed into RGB as (x, y, z + w), so the expected emitted RGB is (0, 0.5, 1.70710678)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sin_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/sin/sin_vector4.mtlx"
                string sourceMaterial = "M_sin_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sin_vector4/surface.outputs:out>
        token outputs:surface.connect = </Looks/sin_vector4/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_sin_vector4"
            float4 inputs:in = (0, 0.523598776, 1.57079633, 0.785398163)
            float4 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Looks/sin_vector4/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/sin_vector4/display_channels.outputs:outz>
            float inputs:in2.connect = </Looks/sin_vector4/display_channels.outputs:outw>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/sin_vector4/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/sin_vector4/display_channels.outputs:outy>
            float inputs:in3.connect = </Looks/sin_vector4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/sin_vector4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/sin_vector4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/sin_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/sin_vector4.exr"
        }
    }
}
