#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "matrix44_invertmatrix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/matrix44_invertmatrix/matrix44_invertmatrix.mtlx"
                string sourceMaterial = "M_matrix44_invertmatrix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/matrix44_invertmatrix/surface.outputs:out>
        token outputs:surface.connect = </Looks/matrix44_invertmatrix/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/matrix44_invertmatrix/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_matrix44_invertmatrix"
        {
            color3f outputs:out_base_color.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_wave"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "row1"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1 = 1.1
                float inputs:in2.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv_wave.outputs:out>
                float inputs:in3 = 0
                float inputs:in4 = 0
                float4 outputs:out
            }

            def Shader "row2"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1 = 0
                float inputs:in2 = 0.9
                float inputs:in3.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv_split.outputs:outx>
                float inputs:in4 = 0
                float4 outputs:out
            }

            def Shader "row3"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/uv_split.outputs:outy>
                float inputs:in2 = 0
                float inputs:in3 = 1.2
                float inputs:in4 = 0
                float4 outputs:out
            }

            def Shader "row4"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1 = 0.15
                float inputs:in2 = 0.2
                float inputs:in3 = 0.05
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "source_matrix"
            {
                uniform token info:id = "ND_creatematrix_vector4_matrix44"
                float4 inputs:in1.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/row1.outputs:out>
                float4 inputs:in2.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/row2.outputs:out>
                float4 inputs:in3.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/row3.outputs:out>
                float4 inputs:in4.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/row4.outputs:out>
                matrix4d outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_invertmatrix_matrix44"
                matrix4d inputs:in.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/source_matrix.outputs:out>
                matrix4d outputs:out
            }

            def Shader "inverse_row"
            {
                uniform token info:id = "ND_extract_matrix44"
                matrix4d inputs:in.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/node_under_test.outputs:out>
                int inputs:index = 0
                float4 outputs:out
            }

            def Shader "inverse_channels"
            {
                uniform token info:id = "ND_separate4_vector4"
                float4 inputs:in.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/inverse_row.outputs:out>
                float outputs:outw
                float outputs:outx
                float outputs:outy
                float outputs:outz
            }

            def Shader "red_channel"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/inverse_channels.outputs:outx>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "red_01"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/red_channel.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/red_01.outputs:out>
                float inputs:in2.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/inverse_channels.outputs:outy>
                float inputs:in3.connect = </Looks/matrix44_invertmatrix/NG_matrix44_invertmatrix/inverse_channels.outputs:outz>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/matrix44_invertmatrix>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/matrix44_invertmatrix.exr"
        }
    }
}
