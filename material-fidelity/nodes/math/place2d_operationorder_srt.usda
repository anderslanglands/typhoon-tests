#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "place2d_operationorder_srt" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/place2d_operationorder_srt/material.mtlx"
                string sourceMaterial = "M_place2d_operationorder_srt"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/place2d_operationorder_srt/surface.outputs:out>
        token outputs:surface.connect = </Looks/place2d_operationorder_srt/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/place2d_operationorder_srt/NG_place2d_operationorder_srt.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/place2d_operationorder_srt/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_place2d_operationorder_srt"
        {
            color3f outputs:out.connect = </Looks/place2d_operationorder_srt/NG_place2d_operationorder_srt/base_image.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_transform"
            {
                uniform token info:id = "ND_place2d_vector2"
                float2 inputs:offset = (0.2, 0.1)
                int inputs:operationorder = 0
                float2 inputs:pivot = (0.5, 0.5)
                float inputs:rotate = 30
                float2 inputs:scale = (2, 1)
                float2 inputs:texcoord.connect = </Looks/place2d_operationorder_srt/NG_place2d_operationorder_srt/uv0.outputs:out>
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/place2d_operationorder_srt/NG_place2d_operationorder_srt/uv_transform.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/place2d_operationorder_srt>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/place2d_operationorder_srt.exr"
        }
    }
}
