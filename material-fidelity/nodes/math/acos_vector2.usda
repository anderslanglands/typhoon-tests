#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_acos_vector2 with in-domain literal in = (1, 0.8); the output is in radians and computed component-wise. The node result is (0, 0.643501109). The vector2 result is packed as (x, y, 0), so the expected emitted RGB is (0, 0.643501109, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "acos_vector2" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/acos/acos_vector2.mtlx"
                string sourceMaterial = "M_acos_vector2"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/acos_vector2/surface.outputs:out>
        token outputs:surface.connect = </Looks/acos_vector2/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_acos_vector2"
            float2 inputs:in = (1, 0.8)
            float2 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/acos_vector2/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/acos_vector2/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/acos_vector2/display_channels.outputs:outy>
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/acos_vector2/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/acos_vector2/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/acos_vector2>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/acos_vector2.exr"
        }
    }
}
