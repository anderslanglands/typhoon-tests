#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "asin_degenerate_out_of_domain_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/asin_degenerate_out_of_domain_vector4/asin_degenerate_out_of_domain_vector4.mtlx"
                string sourceMaterial = "M_asin_degenerate_out_of_domain_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/asin_degenerate_out_of_domain_vector4/surface.outputs:out>
        token outputs:surface.connect = </Looks/asin_degenerate_out_of_domain_vector4/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/asin_degenerate_out_of_domain_vector4/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_asin_degenerate_out_of_domain_vector4"
        {
            color3f outputs:out_base_color.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "scaled_u"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/uv_split.outputs:outx>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "domain_probe"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/scaled_u.outputs:out>
                float inputs:in2 = 1.5
                float outputs:out
            }

            def Shader "asin_in"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/domain_probe.outputs:out>
                float inputs:in2 = -1.2
                float inputs:in3 = 0.5
                float inputs:in4 = 1.2
                float4 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_asin_vector4"
                float4 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/asin_in.outputs:out>
                float4 outputs:out
            }

            def Shader "magnitude"
            {
                uniform token info:id = "ND_absval_vector4"
                float4 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/node_under_test.outputs:out>
                float4 outputs:out
            }

            def Shader "wrapped"
            {
                uniform token info:id = "ND_fract_vector4"
                float4 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/magnitude.outputs:out>
                float4 outputs:out
            }

            def Shader "debug_r"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/wrapped.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "debug_g"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/wrapped.outputs:out>
                int inputs:index = 1
                float outputs:out
            }

            def Shader "debug_b"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/wrapped.outputs:out>
                int inputs:index = 3
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/debug_r.outputs:out>
                float inputs:in2.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/debug_g.outputs:out>
                float inputs:in3.connect = </Looks/asin_degenerate_out_of_domain_vector4/NG_asin_degenerate_out_of_domain_vector4/debug_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/asin_degenerate_out_of_domain_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/math/asin_degenerate_out_of_domain_vector4.exr"
        }
    }
}
