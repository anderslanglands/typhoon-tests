#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "gltf_normalmap_isolate_rotate_offset_procedural" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/gltf_normalmap_isolate_rotate_offset_procedural/gltf_normalmap_isolate_rotate_offset_procedural.mtlx"
                string sourceMaterial = "M_gltf_normalmap_isolate_rotate_offset_procedural"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/SR_gltf_normalmap_isolate_rotate_offset_procedural.outputs:out>
        token outputs:surface.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/SR_gltf_normalmap_isolate_rotate_offset_procedural.outputs:out>

        def Shader "SR_gltf_normalmap_isolate_rotate_offset_procedural"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_gltf_normalmap_isolate_rotate_offset_procedural"
        {
            color3f outputs:out_base_color.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "uv_rotate"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_mix.outputs:out>
                float inputs:in2 = 45
                float outputs:out
            }

            def Shader "uv_mul"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_offset"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_mul.outputs:out>
                float inputs:in2.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_gltf_normalmap_vector3_1_0"
                float3 inputs:default = (0.5, 0.5, 1)
                asset inputs:file = @../../_assets/Materials/showcase/standard_surface/brick_procedural/textures/brick_normal.jpg@ (
                    colorSpace = "none"
                )
                string inputs:filtertype = "linear"
                float2 inputs:offset.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_offset.outputs:out>
                float2 inputs:pivot = (0.5, 0.5)
                float inputs:rotate.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv_rotate.outputs:out>
                float2 inputs:scale = (1, 1)
                float2 inputs:texcoord.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/uv0.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                float3 outputs:out
            }

            def Shader "normal_half"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/node_under_test.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "normal_01"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/normal_half.outputs:out>
                float3 inputs:in2 = (0.5, 0.5, 0.5)
                float3 outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/gltf_normalmap_isolate_rotate_offset_procedural/NG_gltf_normalmap_isolate_rotate_offset_procedural/normal_01.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/gltf_normalmap_isolate_rotate_offset_procedural>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/gltf_normalmap_isolate_rotate_offset_procedural.exr"
        }
    }
}
