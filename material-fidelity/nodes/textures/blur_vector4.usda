#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "blur_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/blur/blur_vector4.mtlx"
                string sourceMaterial = "M_blur_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/blur_vector4/surface.outputs:out>
        token outputs:surface.connect = </Looks/blur_vector4/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/blur_vector4/NG_blur_vector4.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/blur_vector4/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_blur_vector4"
        {
            color3f outputs:out_base_color.connect = </Looks/blur_vector4/NG_blur_vector4/to_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_vector4"
                float4 inputs:default = (1, 0, 1, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/blur_vector4/NG_blur_vector4/uv0.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                float4 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_blur_vector4"
                string inputs:filtertype = "gaussian"
                float4 inputs:in.connect = </Looks/blur_vector4/NG_blur_vector4/base_image.outputs:out>
                float inputs:size = 0.12
                float4 outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_vector4_color3"
                float4 inputs:in.connect = </Looks/blur_vector4/NG_blur_vector4/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/blur_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/blur_vector4.exr"
        }
    }
}
