#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_triplanarprojection_vector4 on the shaderball. Object-space position is scaled by 0.75 and used as the projection coordinate, object-space normal drives the triplanar blend, upaxis is Y, blend is 0.25, and closest filtering keeps the projected grid crisp. The X/Y/Z file inputs are axis-tinted RGBA copies of the clear grid texture, used as data with no color-space metadata and with authored alpha. The vector4 output is packed into RGB as (x, y, z + w), so the image should show the blended axis grid with the fourth sampled channel contributing to blue."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "triplanarprojection_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/triplanarprojection/triplanarprojection_vector4.mtlx"
                string sourceMaterial = "M_triplanarprojection_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/triplanarprojection_vector4/SR_triplanarprojection_vector4.outputs:out>
        token outputs:surface.connect = </Looks/triplanarprojection_vector4/SR_triplanarprojection_vector4.outputs:out>

        def Shader "SR_triplanarprojection_vector4"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4.outputs:out>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_triplanarprojection_vector4"
        {
            color3f outputs:out.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/display_color.outputs:out>

            def Shader "position"
            {
                uniform token info:id = "ND_position_vector3"
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "position_scaled"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/position.outputs:out>
                float3 inputs:in2 = (0.75, 0.75, 0.75)
                float3 outputs:out
            }

            def Shader "normal"
            {
                uniform token info:id = "ND_normal_vector3"
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_triplanarprojection_vector4"
                float inputs:blend = 0.25
                float4 inputs:default = (1, 0, 1, 1)
                asset inputs:filex = @../../_assets/Materials/nodes/triplanarprojection/textures/axis_x.png@
                asset inputs:filey = @../../_assets/Materials/nodes/triplanarprojection/textures/axis_y.png@
                asset inputs:filez = @../../_assets/Materials/nodes/triplanarprojection/textures/axis_z.png@
                string inputs:filtertype = "closest"
                float3 inputs:normal.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/normal.outputs:out>
                float3 inputs:position.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/position_scaled.outputs:out>
                int inputs:upaxis = 1
                float4 outputs:out
            }

            def Shader "display_channels"
            {
                uniform token info:id = "ND_separate4_vector4"
                float4 inputs:in.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/node_under_test.outputs:out>
                float outputs:outx
                float outputs:outy
                float outputs:outz
                float outputs:outw
            }

            def Shader "display_blue"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/display_channels.outputs:outz>
                float inputs:in2.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/display_channels.outputs:outw>
                float outputs:out
            }

            def Shader "display_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/display_channels.outputs:outx>
                float inputs:in2.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/display_channels.outputs:outy>
                float inputs:in3.connect = </Looks/triplanarprojection_vector4/NG_triplanarprojection_vector4/display_blue.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/triplanarprojection_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/triplanarprojection_vector4.exr"
        }
    }
}
