#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "tiledimage_probe_tiling" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/tiledimage_probe_tiling/material.mtlx"
                string sourceMaterial = "M_tiledimage_probe_tiling"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/tiledimage_probe_tiling/SR_tiledimage_probe_tiling.outputs:out>
        token outputs:surface.connect = </Looks/tiledimage_probe_tiling/SR_tiledimage_probe_tiling.outputs:out>

        def Shader "SR_tiledimage_probe_tiling"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/tiledimage_probe_tiling/NG_tiledimage_probe_tiling.outputs:out>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_tiledimage_probe_tiling"
        {
            color3f outputs:out.connect = </Looks/tiledimage_probe_tiling/NG_tiledimage_probe_tiling/out_node.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "out_node"
            {
                uniform token info:id = "ND_tiledimage_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_rec709_scene"
                )
                float2 inputs:texcoord.connect = </Looks/tiledimage_probe_tiling/NG_tiledimage_probe_tiling/uv0.outputs:out>
                float2 inputs:uvoffset = (0, 0)
                float2 inputs:uvtiling = (2, 1.5)
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/tiledimage_probe_tiling>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/tiledimage_probe_tiling.exr"
        }
    }
}
