#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_tiledimage_float by sampling an RGBA copy of the tiledimage grid PNG on the plane using UV0 as data. uvtiling is (2, 2), uvoffset is left at the default, and filtertype is closest, so the original grid texture should repeat twice horizontally and twice vertically with crisp texel boundaries. No color-space metadata is authored because the scalar output is treated as a data-channel read. The sampled scalar is packed into RGB as (value, 0, 0), so the red channel should show the repeated texture and green/blue should remain black."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "tiledimage_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/tiledimage/tiledimage_float.mtlx"
                string sourceMaterial = "M_tiledimage_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/tiledimage_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/tiledimage_float/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_tiledimage_float"
            float inputs:default = 0
            asset inputs:file = @../../_assets/Materials/nodes/tiledimage/textures/grid_rgba.png@
            string inputs:filtertype = "closest"
            float2 inputs:texcoord.connect = </Looks/tiledimage_float/uv0.outputs:out>
            float2 inputs:uvtiling = (2, 2)
            float outputs:out
        }

        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/tiledimage_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/tiledimage_float/display_color.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/tiledimage_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/tiledimage_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/tiledimage_float.exr"
        }
    }
}
