#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "hextiledimage_scalerange" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/hextiledimage_scalerange/material.mtlx"
                string sourceMaterial = "M_hextiledimage_scalerange"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/hextiledimage_scalerange/SR_hextiledimage_scalerange.outputs:out>
        token outputs:surface.connect = </Looks/hextiledimage_scalerange/SR_hextiledimage_scalerange.outputs:out>

        def Shader "SR_hextiledimage_scalerange"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/hextiledimage_scalerange/NG_hextiledimage_scalerange.outputs:out>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_hextiledimage_scalerange"
        {
            color3f outputs:out.connect = </Looks/hextiledimage_scalerange/NG_hextiledimage_scalerange/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_hextiledimage_color3"
                color3f inputs:default = (1, 0, 1)
                float inputs:falloff = 0.5
                float inputs:falloffcontrast = 0.5
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                color3f inputs:lumacoeffs = (0.2722287, 0.6740818, 0.0536895)
                float inputs:offset = 1
                float2 inputs:offsetrange = (0, 1)
                float inputs:rotation = 1
                float2 inputs:rotationrange = (0, 360)
                float inputs:scale = 1
                float2 inputs:scalerange = (0.25, 1.75)
                float2 inputs:texcoord.connect = </Looks/hextiledimage_scalerange/NG_hextiledimage_scalerange/uv0.outputs:out>
                float2 inputs:tiling = (1, 1)
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/hextiledimage_scalerange>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/hextiledimage_scalerange.exr"
        }
    }
}
