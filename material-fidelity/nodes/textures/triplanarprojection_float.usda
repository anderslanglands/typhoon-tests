#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_triplanarprojection_float on the shaderball. Object-space position is scaled by 0.75 and used as the projection coordinate, object-space normal drives the triplanar blend, upaxis is Y, blend is 0.25, and closest filtering keeps the projected grid crisp. The X/Y/Z file inputs are axis-tinted RGBA copies of the clear grid texture, used as data with no color-space metadata. The scalar output is packed into RGB as (value, 0, 0), so red should show the blended triplanar projection while green and blue remain black."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "triplanarprojection_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/triplanarprojection/triplanarprojection_float.mtlx"
                string sourceMaterial = "M_triplanarprojection_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/triplanarprojection_float/SR_triplanarprojection_float.outputs:out>
        token outputs:surface.connect = </Looks/triplanarprojection_float/SR_triplanarprojection_float.outputs:out>

        def Shader "SR_triplanarprojection_float"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/triplanarprojection_float/NG_triplanarprojection_float.outputs:out>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_triplanarprojection_float"
        {
            color3f outputs:out.connect = </Looks/triplanarprojection_float/NG_triplanarprojection_float/display_color.outputs:out>

            def Shader "position"
            {
                uniform token info:id = "ND_position_vector3"
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "position_scaled"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/triplanarprojection_float/NG_triplanarprojection_float/position.outputs:out>
                float3 inputs:in2 = (0.75, 0.75, 0.75)
                float3 outputs:out
            }

            def Shader "normal"
            {
                uniform token info:id = "ND_normal_vector3"
                string inputs:space = "object"
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_triplanarprojection_float"
                float inputs:blend = 0.25
                float inputs:default = 0
                asset inputs:filex = @../../_assets/Materials/nodes/triplanarprojection/textures/axis_x.png@
                asset inputs:filey = @../../_assets/Materials/nodes/triplanarprojection/textures/axis_y.png@
                asset inputs:filez = @../../_assets/Materials/nodes/triplanarprojection/textures/axis_z.png@
                string inputs:filtertype = "closest"
                float3 inputs:normal.connect = </Looks/triplanarprojection_float/NG_triplanarprojection_float/normal.outputs:out>
                float3 inputs:position.connect = </Looks/triplanarprojection_float/NG_triplanarprojection_float/position_scaled.outputs:out>
                int inputs:upaxis = 1
                float outputs:out
            }

            def Shader "display_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/triplanarprojection_float/NG_triplanarprojection_float/node_under_test.outputs:out>
                float inputs:in2 = 0
                float inputs:in3 = 0
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/triplanarprojection_float>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/triplanarprojection_float.exr"
        }
    }
}
