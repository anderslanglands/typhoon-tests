#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "image_addressmode_clamp" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/image_addressmode_clamp/image_addressmode_clamp.mtlx"
                string sourceMaterial = "M_image_addressmode_clamp"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/image_addressmode_clamp/SR_image_addressmode_clamp.outputs:out>
        token outputs:surface.connect = </Looks/image_addressmode_clamp/SR_image_addressmode_clamp.outputs:out>

        def Shader "SR_image_addressmode_clamp"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/image_addressmode_clamp/NG_image_addressmode_clamp.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_image_addressmode_clamp"
        {
            color3f outputs:out_base_color.connect = </Looks/image_addressmode_clamp/NG_image_addressmode_clamp/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_scaled"
            {
                uniform token info:id = "ND_multiply_vector2"
                float2 inputs:in1.connect = </Looks/image_addressmode_clamp/NG_image_addressmode_clamp/uv0.outputs:out>
                float2 inputs:in2 = (3, 3)
                float2 outputs:out
            }

            def Shader "uv_expanded"
            {
                uniform token info:id = "ND_add_vector2"
                float2 inputs:in1.connect = </Looks/image_addressmode_clamp/NG_image_addressmode_clamp/uv_scaled.outputs:out>
                float2 inputs:in2 = (-1, -1)
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_addressmode_constant/textures/address_modes.png@ (
                    colorSpace = "srgb_texture"
                )
                string inputs:filtertype = "closest"
                float2 inputs:texcoord.connect = </Looks/image_addressmode_clamp/NG_image_addressmode_clamp/uv_expanded.outputs:out>
                string inputs:uaddressmode = "clamp"
                string inputs:vaddressmode = "clamp"
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/image_addressmode_clamp>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/image_addressmode_clamp.exr"
        }
    }
}
