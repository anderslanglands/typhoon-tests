#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "latlongimage" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/latlongimage/latlongimage.mtlx"
                string sourceMaterial = "M_latlongimage"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/latlongimage/surface.outputs:out>
        token outputs:surface.connect = </Looks/latlongimage/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/latlongimage/NG_latlongimage.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/latlongimage/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_latlongimage"
        {
            color3f outputs:out_base_color.connect = </Looks/latlongimage/NG_latlongimage/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/latlongimage/NG_latlongimage/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "longitude_centered"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/uv_split.outputs:outx>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "longitude_angle"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/longitude_centered.outputs:out>
                float inputs:in2 = -6.28318530718
                float outputs:out
            }

            def Shader "latitude_centered"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/uv_split.outputs:outy>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "latitude_angle"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/latitude_centered.outputs:out>
                float inputs:in2 = 3.14159265359
                float outputs:out
            }

            def Shader "longitude_sin"
            {
                uniform token info:id = "ND_sin_float"
                float inputs:in.connect = </Looks/latlongimage/NG_latlongimage/longitude_angle.outputs:out>
                float outputs:out
            }

            def Shader "longitude_cos"
            {
                uniform token info:id = "ND_cos_float"
                float inputs:in.connect = </Looks/latlongimage/NG_latlongimage/longitude_angle.outputs:out>
                float outputs:out
            }

            def Shader "latitude_sin"
            {
                uniform token info:id = "ND_sin_float"
                float inputs:in.connect = </Looks/latlongimage/NG_latlongimage/latitude_angle.outputs:out>
                float outputs:out
            }

            def Shader "latitude_cos"
            {
                uniform token info:id = "ND_cos_float"
                float inputs:in.connect = </Looks/latlongimage/NG_latlongimage/latitude_angle.outputs:out>
                float outputs:out
            }

            def Shader "viewdir_x"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/longitude_sin.outputs:out>
                float inputs:in2.connect = </Looks/latlongimage/NG_latlongimage/latitude_cos.outputs:out>
                float outputs:out
            }

            def Shader "viewdir_z"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/longitude_cos.outputs:out>
                float inputs:in2.connect = </Looks/latlongimage/NG_latlongimage/latitude_cos.outputs:out>
                float outputs:out
            }

            def Shader "viewdir"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/latlongimage/NG_latlongimage/viewdir_x.outputs:out>
                float inputs:in2.connect = </Looks/latlongimage/NG_latlongimage/latitude_sin.outputs:out>
                float inputs:in3.connect = </Looks/latlongimage/NG_latlongimage/viewdir_z.outputs:out>
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_latlongimage"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Lights/san_giuseppe_bridge_2k.hdr@
                float inputs:rotation = 45
                float3 inputs:viewdir.connect = </Looks/latlongimage/NG_latlongimage/viewdir.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/latlongimage>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/latlongimage.exr"
        }
    }
}
