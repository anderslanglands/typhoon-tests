#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "image_texcoord_direct_probe" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/image_texcoord_direct_probe/image_texcoord_direct_probe.mtlx"
                string sourceMaterial = "M_image_texcoord_direct_probe"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/image_texcoord_direct_probe/SR_image_texcoord_direct_probe.outputs:out>
        token outputs:surface.connect = </Looks/image_texcoord_direct_probe/SR_image_texcoord_direct_probe.outputs:out>

        def Shader "SR_image_texcoord_direct_probe"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/image_texcoord_direct_probe/NG_image_texcoord_direct_probe.outputs:out_base_color>
            float inputs:specular_roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_image_texcoord_direct_probe"
        {
            color3f outputs:out_base_color.connect = </Looks/image_texcoord_direct_probe/NG_image_texcoord_direct_probe/base_image.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "base_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/nodes/image_format_png/textures/texture.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/image_texcoord_direct_probe/NG_image_texcoord_direct_probe/uv0.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/image_texcoord_direct_probe>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/image_texcoord_direct_probe.exr"
        }
    }
}
