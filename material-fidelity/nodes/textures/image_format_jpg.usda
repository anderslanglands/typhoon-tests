#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "image_format_jpg" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/image_format_jpg/image_format_jpg.mtlx"
                string sourceMaterial = "M_image_format_jpg"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/image_format_jpg/SR_image_format_jpg.outputs:out>
        token outputs:surface.connect = </Looks/image_format_jpg/SR_image_format_jpg.outputs:out>

        def Shader "SR_image_format_jpg"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/image_format_jpg/NG_image_format_jpg.outputs:base_color_out>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.35
            token outputs:out
        }

        def NodeGraph "NG_image_format_jpg"
        {
            color3f outputs:base_color_out.connect = </Looks/image_format_jpg/NG_image_format_jpg/format_tex.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "format_tex"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @../../_assets/Materials/nodes/image_format_jpg/textures/texture.jpg@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/image_format_jpg/NG_image_format_jpg/uv0.outputs:out>
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/image_format_jpg>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/textures/image_format_jpg.exr"
        }
    }
}
