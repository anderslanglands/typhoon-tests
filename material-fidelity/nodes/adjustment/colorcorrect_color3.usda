#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_colorcorrect_color3 with in = (0.2, 0.3, 0.4). Hue and saturation are identity values, while gamma = 2, lift = 0.1, gain = 0.5, contrast = 0.5, contrastpivot = 0.2, and exposure = 1 are non-identity. The RGB path computes gamma as pow(in, 1 / gamma) = sqrt(in) = (0.447214, 0.547723, 0.632456), lift as value * 0.9 + 0.1 = (0.502492, 0.59295, 0.66921), gain as * 0.5 = (0.251246, 0.296475, 0.334605), contrast as 0.2 + (value - 0.2) * 0.5 = (0.225623, 0.248238, 0.267302), then exposure as * 2 = (0.451246, 0.496475, 0.534605). The color3 result is connected directly to the emitting EDF, so the expected emitted RGB is (0.451246, 0.496475, 0.534605)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "colorcorrect_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/colorcorrect/colorcorrect_color3.mtlx"
                string sourceMaterial = "M_colorcorrect_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/colorcorrect_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/colorcorrect_color3/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_colorcorrect_color3"
            color3f inputs:in = (0.2, 0.3, 0.4)
            float inputs:hue = 0
            float inputs:saturation = 1
            float inputs:gamma = 2
            float inputs:lift = 0.1
            float inputs:gain = 0.5
            float inputs:contrast = 0.5
            float inputs:contrastpivot = 0.2
            float inputs:exposure = 1
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/colorcorrect_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/colorcorrect_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/colorcorrect_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/colorcorrect_color3.exr"
        }
    }
}
