#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_hsvadjust_color4 from the MaterialX Standard Nodes adjustment section with literal in = (1, 0, 0, 0.2) and amount = (0.5, 0.5, 0.5). The spec converts RGB to HSV, adds amount.x to hue, multiplies saturation by amount.y, multiplies value by amount.z, then converts back to RGB; red HSV (0, 1, 1) becomes HSV (0.5, 0.5, 0.5), so the node result is (0.25, 0.5, 0.5, 0.2). The color4 result keeps alpha unchanged and is packed into RGB as (r, g, b + a), so the expected emitted RGB on the plane is (0.25, 0.5, 0.7)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "hsvadjust_color4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/hsvadjust/hsvadjust_color4.mtlx"
                string sourceMaterial = "M_hsvadjust_color4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/hsvadjust_color4/surface.outputs:out>
        token outputs:surface.connect = </Looks/hsvadjust_color4/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_hsvadjust_color4"
            color4f inputs:in = (1, 0, 0, 0.2)
            float3 inputs:amount = (0.5, 0.5, 0.5)
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/hsvadjust_color4/node_under_test.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/hsvadjust_color4/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/hsvadjust_color4/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/hsvadjust_color4/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/hsvadjust_color4/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/hsvadjust_color4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/hsvadjust_color4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/hsvadjust_color4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/hsvadjust_color4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/hsvadjust_color4.exr"
        }
    }
}
