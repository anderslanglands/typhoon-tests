#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_colorcorrect_color4 with in = (0.2, 0.3, 0.4, 0.25). Hue and saturation are identity values, while gamma = 2, lift = 0.1, gain = 0.5, contrast = 0.5, contrastpivot = 0.2, and exposure = 1 are non-identity. The RGB path computes gamma as pow(in, 1 / gamma) = sqrt(in) = (0.447214, 0.547723, 0.632456), lift as value * 0.9 + 0.1 = (0.502492, 0.59295, 0.66921), gain as * 0.5 = (0.251246, 0.296475, 0.334605), contrast as 0.2 + (value - 0.2) * 0.5 = (0.225623, 0.248238, 0.267302), then exposure as * 2 = (0.451246, 0.496475, 0.534605). The color4 variant preserves alpha, so the node result is (0.451246, 0.496475, 0.534605, 0.25). The four-channel result is packed into RGB as (r, g, b + a), so the expected emitted RGB is (0.451246, 0.496475, 0.784605)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "colorcorrect_color4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/colorcorrect/colorcorrect_color4.mtlx"
                string sourceMaterial = "M_colorcorrect_color4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/colorcorrect_color4/surface.outputs:out>
        token outputs:surface.connect = </Looks/colorcorrect_color4/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_colorcorrect_color4"
            color4f inputs:in = (0.2, 0.3, 0.4, 0.25)
            float inputs:hue = 0
            float inputs:saturation = 1
            float inputs:gamma = 2
            float inputs:lift = 0.1
            float inputs:gain = 0.5
            float inputs:contrast = 0.5
            float inputs:contrastpivot = 0.2
            float inputs:exposure = 1
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/colorcorrect_color4/node_under_test.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/colorcorrect_color4/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/colorcorrect_color4/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/colorcorrect_color4/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/colorcorrect_color4/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/colorcorrect_color4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/colorcorrect_color4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/colorcorrect_color4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/colorcorrect_color4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/colorcorrect_color4.exr"
        }
    }
}
