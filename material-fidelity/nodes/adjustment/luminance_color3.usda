#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_luminance_color3 with in = (0.2000000, 0.4000000, 0.6000000) and ACEScg luma coefficients (0.2722287, 0.6740818, 0.0536895). The luminance is dot(in, lumacoeffs) = 0.3562922, so the color3 output is (0.3562922, 0.3562922, 0.3562922). The result is connected directly to uniform_edf.color, so the expected emitted RGB is (0.3562922, 0.3562922, 0.3562922)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "luminance_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/luminance/luminance_color3.mtlx"
                string sourceMaterial = "M_luminance_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/luminance_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/luminance_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_luminance_color3"
            color3f inputs:in = (0.2000000, 0.4000000, 0.6000000)
            color3f inputs:lumacoeffs = (0.2722287, 0.6740818, 0.0536895)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/luminance_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/luminance_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/luminance_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/luminance_color3.exr"
        }
    }
}
