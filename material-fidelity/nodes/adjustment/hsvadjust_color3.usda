#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_hsvadjust_color3 from the MaterialX Standard Nodes adjustment section with literal in = (1, 0, 0) and amount = (0.5, 0.5, 0.5). The spec converts RGB to HSV, adds amount.x to hue, multiplies saturation by amount.y, multiplies value by amount.z, then converts back to RGB; red HSV (0, 1, 1) becomes HSV (0.5, 0.5, 0.5), so the node result is (0.25, 0.5, 0.5). The color3 result is connected directly to uniform_edf.color, so the expected emitted RGB on the plane is (0.25, 0.5, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "hsvadjust_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/hsvadjust/hsvadjust_color3.mtlx"
                string sourceMaterial = "M_hsvadjust_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/hsvadjust_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/hsvadjust_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_hsvadjust_color3"
            color3f inputs:in = (1, 0, 0)
            float3 inputs:amount = (0.5, 0.5, 0.5)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/hsvadjust_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/hsvadjust_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/hsvadjust_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/hsvadjust_color3.exr"
        }
    }
}
