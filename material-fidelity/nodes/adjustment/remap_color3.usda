#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_remap_color3 with literal in = (0.25, 0.75, 1.25) and typed bounds inlow = (0, 0.25, 0.5), inhigh = (1, 1.25, 1.5), outlow = (0.1, 0.2, 0.3), outhigh = (0.9, 0.8, 0.7). The normalized t is (0.25, 0.5, 0.75), so remap computes outlow + t * (outhigh - outlow) = (0.3, 0.5, 0.6). The color3 result is connected directly to uniform_edf.color, so the expected emitted RGB on the plane is (0.3, 0.5, 0.6)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "remap_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/remap/remap_color3.mtlx"
                string sourceMaterial = "M_remap_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/remap_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/remap_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_remap_color3"
            color3f inputs:in = (0.25, 0.75, 1.25)
            color3f inputs:inlow = (0, 0.25, 0.5)
            color3f inputs:inhigh = (1, 1.25, 1.5)
            color3f inputs:outlow = (0.1, 0.2, 0.3)
            color3f inputs:outhigh = (0.9, 0.8, 0.7)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/remap_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/remap_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/remap_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/remap_color3.exr"
        }
    }
}
