#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_smoothstep_vector4 with UV-driven input (u, v, 0.25, 0.75) and inverted per-component transition bounds. RGB displays output x, y, and w, matching the original diagnostic channel selection, so the image records vector smoothstep behavior with reversed bounds over the plane."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "smoothstep_vector4_degenerate_inverted_bounds" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/smoothstep_vector4_degenerate_inverted_bounds/smoothstep_vector4_degenerate_inverted_bounds.mtlx"
                string sourceMaterial = "M_smoothstep_vector4_degenerate_inverted_bounds"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/surface.outputs:out>
        token outputs:surface.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_smoothstep_vector4_degenerate_inverted_bounds"
        {
            color3f outputs:out_base_color.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "step_in"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/uv_split.outputs:outy>
                float inputs:in3 = 0.25
                float inputs:in4 = 0.75
                float4 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_smoothstep_vector4"
                float4 inputs:high = (0.25, 0.2, 0.1, 0.05)
                float4 inputs:in.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/step_in.outputs:out>
                float4 inputs:low = (0.75, 0.8, 0.9, 0.95)
                float4 outputs:out
            }

            def Shader "debug_r"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/node_under_test.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "debug_g"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/node_under_test.outputs:out>
                int inputs:index = 1
                float outputs:out
            }

            def Shader "debug_b"
            {
                uniform token info:id = "ND_extract_vector4"
                float4 inputs:in.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/node_under_test.outputs:out>
                int inputs:index = 3
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/debug_r.outputs:out>
                float inputs:in2.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/debug_g.outputs:out>
                float inputs:in3.connect = </Looks/smoothstep_vector4_degenerate_inverted_bounds/NG_smoothstep_vector4_degenerate_inverted_bounds/debug_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/smoothstep_vector4_degenerate_inverted_bounds>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/smoothstep_vector4_degenerate_inverted_bounds.exr"
        }
    }
}
