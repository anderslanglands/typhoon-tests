#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "remap" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/remap/remap.mtlx"
                string sourceMaterial = "M_remap"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/remap/surface.outputs:out>
        token outputs:surface.connect = </Looks/remap/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/remap/NG_remap.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/remap/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_remap"
        {
            color3f outputs:out_base_color.connect = </Looks/remap/NG_remap/node_under_test.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "pos_x"
            {
                uniform token info:id = "ND_dotproduct_vector3"
                float3 inputs:in1.connect = </Looks/remap/NG_remap/pos0.outputs:out>
                float3 inputs:in2 = (1, 0, 0)
                float outputs:out
            }

            def Shader "pos_y"
            {
                uniform token info:id = "ND_dotproduct_vector3"
                float3 inputs:in1.connect = </Looks/remap/NG_remap/pos0.outputs:out>
                float3 inputs:in2 = (0, 1, 0)
                float outputs:out
            }

            def Shader "pos_z"
            {
                uniform token info:id = "ND_dotproduct_vector3"
                float3 inputs:in1.connect = </Looks/remap/NG_remap/pos0.outputs:out>
                float3 inputs:in2 = (0, 0, 1)
                float outputs:out
            }

            def Shader "pos_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/remap/NG_remap/pos_x.outputs:out>
                float inputs:in2.connect = </Looks/remap/NG_remap/pos_y.outputs:out>
                float inputs:in3.connect = </Looks/remap/NG_remap/pos_z.outputs:out>
                color3f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_remap_color3"
                color3f inputs:in.connect = </Looks/remap/NG_remap/pos_color.outputs:out>
                color3f inputs:inhigh = (2, 2, 2)
                color3f inputs:inlow = (-2, -2, -2)
                color3f inputs:outhigh = (0.98, 0.86, 0.15)
                color3f inputs:outlow = (0.08, 0.12, 0.55)
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/remap>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/remap.exr"
        }
    }
}
