#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_contrast_color3 with in = (0.2, 0.5, 0.6), amount = (0.5, 1.4, 1.2), and pivot = (0.4, 0.3, 0.5). Contrast computes pivot + (in - pivot) * amount component-wise, producing (0.3, 0.58, 0.62). The expected emitted RGB is (0.3, 0.58, 0.62)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "contrast_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/contrast/contrast_color3.mtlx"
                string sourceMaterial = "M_contrast_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/contrast_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/contrast_color3/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_contrast_color3"
            color3f inputs:in = (0.2, 0.5, 0.6)
            color3f inputs:amount = (0.5, 1.4, 1.2)
            color3f inputs:pivot = (0.4, 0.3, 0.5)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/contrast_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/contrast_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/contrast_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/contrast_color3.exr"
        }
    }
}
