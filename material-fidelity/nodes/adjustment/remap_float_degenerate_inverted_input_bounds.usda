#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_remap_float with UV u as input and inverted input bounds, inlow = 0.75 greater than inhigh = 0.25. Red displays the node output, green displays UV v, and blue is constant 0.2, so the image shows the scalar remap ramp when the input range is reversed."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "remap_float_degenerate_inverted_input_bounds" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/remap_float_degenerate_inverted_input_bounds/remap_float_degenerate_inverted_input_bounds.mtlx"
                string sourceMaterial = "M_remap_float_degenerate_inverted_input_bounds"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/remap_float_degenerate_inverted_input_bounds/surface.outputs:out>
        token outputs:surface.connect = </Looks/remap_float_degenerate_inverted_input_bounds/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/remap_float_degenerate_inverted_input_bounds/NG_remap_float_degenerate_inverted_input_bounds.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/remap_float_degenerate_inverted_input_bounds/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_remap_float_degenerate_inverted_input_bounds"
        {
            color3f outputs:out_base_color.connect = </Looks/remap_float_degenerate_inverted_input_bounds/NG_remap_float_degenerate_inverted_input_bounds/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/remap_float_degenerate_inverted_input_bounds/NG_remap_float_degenerate_inverted_input_bounds/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_remap_float"
                float inputs:in.connect = </Looks/remap_float_degenerate_inverted_input_bounds/NG_remap_float_degenerate_inverted_input_bounds/uv_split.outputs:outx>
                float inputs:inhigh = 0.25
                float inputs:inlow = 0.75
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/remap_float_degenerate_inverted_input_bounds/NG_remap_float_degenerate_inverted_input_bounds/node_under_test.outputs:out>
                float inputs:in2.connect = </Looks/remap_float_degenerate_inverted_input_bounds/NG_remap_float_degenerate_inverted_input_bounds/uv_split.outputs:outy>
                float inputs:in3 = 0.2
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/remap_float_degenerate_inverted_input_bounds>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/remap_float_degenerate_inverted_input_bounds.exr"
        }
    }
}
