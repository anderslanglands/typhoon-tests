#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_range_vector2FA with literal in = (0.25, 0.5) and scalar bounds inlow = 0, inhigh = 1, outlow = 0.1, outhigh = 0.9, gamma = 1, with doclamp true. The normalized/clamped t is (0.25, 0.5), and gamma is 1, so range computes outlow + t * (outhigh - outlow) = (0.3, 0.5). The vector2 result is converted to RGB as (x, y, 0), so the expected emitted RGB on the plane is (0.3, 0.5, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "range_vector2FA" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/range/range_vector2FA.mtlx"
                string sourceMaterial = "M_range_vector2FA"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/range_vector2FA/surface.outputs:out>
        token outputs:surface.connect = </Looks/range_vector2FA/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_range_vector2FA"
            float2 inputs:in = (0.25, 0.5)
            float inputs:inlow = 0
            float inputs:inhigh = 1
            float inputs:gamma = 1
            float inputs:outlow = 0.1
            float inputs:outhigh = 0.9
            bool inputs:doclamp = true
            float2 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector2_color3"
            float2 inputs:in.connect = </Looks/range_vector2FA/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/range_vector2FA/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/range_vector2FA/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/range_vector2FA>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/range_vector2FA.exr"
        }
    }
}
