#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_remap_float with literal in = 0.25 and typed bounds inlow = 0, inhigh = 1, outlow = 0.1, outhigh = 0.9. The normalized t is 0.25, so remap computes outlow + t * (outhigh - outlow) = 0.3. The scalar result is packed into RGB as (value, 0, 0), so the expected emitted RGB on the plane is (0.3, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "remap_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/remap/remap_float.mtlx"
                string sourceMaterial = "M_remap_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/remap_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/remap_float/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_remap_float"
            float inputs:in = 0.25
            float inputs:inlow = 0
            float inputs:inhigh = 1
            float inputs:outlow = 0.1
            float inputs:outhigh = 0.9
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/remap_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/remap_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/remap_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/remap_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/remap_float.exr"
        }
    }
}
