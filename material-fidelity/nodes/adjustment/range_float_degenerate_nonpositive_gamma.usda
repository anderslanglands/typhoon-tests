#usda 1.0
(
    customLayerData = {
        string doc = "Tests the ND_range_float edge case with UV u as input, doclamp false, and nonpositive gamma = -1. Red displays the node output, green displays UV v, and blue is constant 0.2, so the image records renderer behavior for a negative range gamma over the plane."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "range_float_degenerate_nonpositive_gamma" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/range_float_degenerate_nonpositive_gamma/range_float_degenerate_nonpositive_gamma.mtlx"
                string sourceMaterial = "M_range_float_degenerate_nonpositive_gamma"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/range_float_degenerate_nonpositive_gamma/surface.outputs:out>
        token outputs:surface.connect = </Looks/range_float_degenerate_nonpositive_gamma/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/range_float_degenerate_nonpositive_gamma/NG_range_float_degenerate_nonpositive_gamma.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/range_float_degenerate_nonpositive_gamma/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_range_float_degenerate_nonpositive_gamma"
        {
            color3f outputs:out_base_color.connect = </Looks/range_float_degenerate_nonpositive_gamma/NG_range_float_degenerate_nonpositive_gamma/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/range_float_degenerate_nonpositive_gamma/NG_range_float_degenerate_nonpositive_gamma/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 0
                float inputs:gamma = -1
                float inputs:in.connect = </Looks/range_float_degenerate_nonpositive_gamma/NG_range_float_degenerate_nonpositive_gamma/uv_split.outputs:outx>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/range_float_degenerate_nonpositive_gamma/NG_range_float_degenerate_nonpositive_gamma/node_under_test.outputs:out>
                float inputs:in2.connect = </Looks/range_float_degenerate_nonpositive_gamma/NG_range_float_degenerate_nonpositive_gamma/uv_split.outputs:outy>
                float inputs:in3 = 0.2
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/range_float_degenerate_nonpositive_gamma>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/range_float_degenerate_nonpositive_gamma.exr"
        }
    }
}
