#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_smoothstep_float with literal in = 0.5 and typed low = 0 and high = 1. The normalized/clamped t is 0.5, so smoothstep computes t*t*(3 - 2*t) = 0.5. The scalar result is packed into RGB as (value, 0, 0), so the expected emitted RGB on the plane is (0.5, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "smoothstep_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/smoothstep/smoothstep_float.mtlx"
                string sourceMaterial = "M_smoothstep_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/smoothstep_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/smoothstep_float/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_smoothstep_float"
            float inputs:in = 0.5
            float inputs:low = 0
            float inputs:high = 1
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/smoothstep_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/smoothstep_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/smoothstep_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/smoothstep_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/smoothstep_float.exr"
        }
    }
}
