#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_contrast_float with in = 0.6, amount = 1.5, and pivot = 0.4. Contrast computes pivot + (in - pivot) * amount component-wise, producing 0.7. The float result is packed into RGB as (value, 0, 0). The expected emitted RGB is (0.7, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "contrast_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/contrast/contrast_float.mtlx"
                string sourceMaterial = "M_contrast_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/contrast_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/contrast_float/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_contrast_float"
            float inputs:in = 0.6
            float inputs:amount = 1.5
            float inputs:pivot = 0.4
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/contrast_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/contrast_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/contrast_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/contrast_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/contrast_float.exr"
        }
    }
}
