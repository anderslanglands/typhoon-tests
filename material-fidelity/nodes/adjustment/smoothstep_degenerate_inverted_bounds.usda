#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "smoothstep_degenerate_inverted_bounds" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/smoothstep_degenerate_inverted_bounds/smoothstep_degenerate_inverted_bounds.mtlx"
                string sourceMaterial = "M_smoothstep_degenerate_inverted_bounds"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/smoothstep_degenerate_inverted_bounds/surface.outputs:out>
        token outputs:surface.connect = </Looks/smoothstep_degenerate_inverted_bounds/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/smoothstep_degenerate_inverted_bounds/NG_smoothstep_degenerate_inverted_bounds.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/smoothstep_degenerate_inverted_bounds/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_smoothstep_degenerate_inverted_bounds"
        {
            color3f outputs:out_base_color.connect = </Looks/smoothstep_degenerate_inverted_bounds/NG_smoothstep_degenerate_inverted_bounds/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/smoothstep_degenerate_inverted_bounds/NG_smoothstep_degenerate_inverted_bounds/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_smoothstep_float"
                float inputs:high = 0.25
                float inputs:in.connect = </Looks/smoothstep_degenerate_inverted_bounds/NG_smoothstep_degenerate_inverted_bounds/uv_split.outputs:outx>
                float inputs:low = 0.75
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/smoothstep_degenerate_inverted_bounds/NG_smoothstep_degenerate_inverted_bounds/node_under_test.outputs:out>
                float inputs:in2.connect = </Looks/smoothstep_degenerate_inverted_bounds/NG_smoothstep_degenerate_inverted_bounds/uv_split.outputs:outy>
                float inputs:in3 = 0.2
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/smoothstep_degenerate_inverted_bounds>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/smoothstep_degenerate_inverted_bounds.exr"
        }
    }
}
