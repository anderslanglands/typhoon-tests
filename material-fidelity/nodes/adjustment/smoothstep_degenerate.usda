#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "smoothstep_degenerate" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/smoothstep_degenerate/smoothstep_degenerate.mtlx"
                string sourceMaterial = "M_smoothstep_degenerate"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/smoothstep_degenerate/SR_smoothstep_degenerate.outputs:out>
        token outputs:surface.connect = </Looks/smoothstep_degenerate/SR_smoothstep_degenerate.outputs:out>

        def Shader "SR_smoothstep_degenerate"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/smoothstep_degenerate/NG_smoothstep_degenerate.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_smoothstep_degenerate"
        {
            color3f outputs:out_base_color.connect = </Looks/smoothstep_degenerate/NG_smoothstep_degenerate/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/smoothstep_degenerate/NG_smoothstep_degenerate/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_smoothstep_float"
                float inputs:high = 0.5
                float inputs:in.connect = </Looks/smoothstep_degenerate/NG_smoothstep_degenerate/uv_split.outputs:outx>
                float inputs:low = 0.5
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/smoothstep_degenerate/NG_smoothstep_degenerate/node_under_test.outputs:out>
                float inputs:in2.connect = </Looks/smoothstep_degenerate/NG_smoothstep_degenerate/uv_split.outputs:outy>
                float inputs:in3 = 0.2
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/smoothstep_degenerate>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/adjustment/smoothstep_degenerate.exr"
        }
    }
}
