#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ramptb_color3 on the plane using explicit UV0 texcoords. The node linearly interpolates from bottom color (0.10, 0.20, 0.72) at V = 0 to top color (0.82, 0.58, 0.18) at V = 1. The render should show a visible bottom-to-top color ramp across the plane. The color3 output is connected directly to uniform_edf.color."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ramptb" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ramptb/ramptb.mtlx"
                string sourceMaterial = "M_ramptb"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ramptb/surface.outputs:out>
        token outputs:surface.connect = </Looks/ramptb/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ramptb_color3"
            color3f inputs:valuet = (0.82, 0.58, 0.18)
            color3f inputs:valueb = (0.10, 0.20, 0.72)
            float2 inputs:texcoord.connect = </Looks/ramptb/uv0.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ramptb/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ramptb/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ramptb>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/ramptb.exr"
        }
    }
}
