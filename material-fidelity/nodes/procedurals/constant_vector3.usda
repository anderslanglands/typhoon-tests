#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_constant_vector3 with literal value (0.25, 0.65, 0.9). The node result is (0.25, 0.65, 0.9). The result is connected to uniform_edf.color, so the expected emitted RGB is (0.25, 0.65, 0.9)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "constant_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/constant/constant_vector3.mtlx"
                string sourceMaterial = "M_constant_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/constant_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/constant_vector3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_constant_vector3"
            float3 inputs:value = (0.25, 0.65, 0.9)
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/constant_vector3/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/constant_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/constant_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/constant_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/constant_vector3.exr"
        }
    }
}
