#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_constant_filename by outputting the asset value ../../_assets/Materials/grid.exr and connecting it directly to ND_image_color3.file. The plane should show grid.exr sampled by its UVs, proving the filename output is being consumed as an image asset rather than a string literal."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "constant_filename" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/constant/constant_filename.mtlx"
                string sourceMaterial = "M_constant_filename"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/constant_filename/surface.outputs:out>
        token outputs:surface.connect = </Looks/constant_filename/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_constant_filename"
            asset inputs:value = @../../_assets/Materials/grid.exr@
            asset outputs:out
        }
        def Shader "texcoord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 0, 1)
            asset inputs:file.connect = </Looks/constant_filename/node_under_test.outputs:out>
            float2 inputs:texcoord.connect = </Looks/constant_filename/texcoord.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/constant_filename/image.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/constant_filename/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/constant_filename>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/constant_filename.exr"
        }
    }
}
