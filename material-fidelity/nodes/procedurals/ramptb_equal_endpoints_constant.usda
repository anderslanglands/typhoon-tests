#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ramptb_equal_endpoints_constant" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ramptb_equal_endpoints_constant/ramptb_equal_endpoints_constant.mtlx"
                string sourceMaterial = "M_ramptb_equal_endpoints_constant"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ramptb_equal_endpoints_constant/SR_ramptb_equal_endpoints_constant.outputs:out>
        token outputs:surface.connect = </Looks/ramptb_equal_endpoints_constant/SR_ramptb_equal_endpoints_constant.outputs:out>

        def Shader "SR_ramptb_equal_endpoints_constant"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_ramptb_equal_endpoints_constant"
        {
            color3f outputs:out_base_color.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "v_scaled"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/uv_split.outputs:outy>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "v_out_of_range"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/v_scaled.outputs:out>
                float inputs:in2 = 1.5
                float outputs:out
            }

            def Shader "uv_out_of_range"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/v_out_of_range.outputs:out>
                float2 outputs:out
            }

            def Shader "ramptb_in_range"
            {
                uniform token info:id = "ND_ramptb_float"
                float2 inputs:texcoord.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/uv0.outputs:out>
                float inputs:valueb = 0.37
                float inputs:valuet = 0.37
                float outputs:out
            }

            def Shader "ramptb_out_of_range"
            {
                uniform token info:id = "ND_ramptb_float"
                float2 inputs:texcoord.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/uv_out_of_range.outputs:out>
                float inputs:valueb = 0.37
                float inputs:valuet = 0.37
                float outputs:out
            }

            def Shader "constant_delta_raw"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/ramptb_in_range.outputs:out>
                float inputs:in2.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/ramptb_out_of_range.outputs:out>
                float outputs:out
            }

            def Shader "constant_delta"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/constant_delta_raw.outputs:out>
                float outputs:out
            }

            def Shader "constant_delta_amplified"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/constant_delta.outputs:out>
                float inputs:in2 = 16
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/ramptb_in_range.outputs:out>
                float inputs:in2.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/ramptb_out_of_range.outputs:out>
                float inputs:in3.connect = </Looks/ramptb_equal_endpoints_constant/NG_ramptb_equal_endpoints_constant/constant_delta_amplified.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ramptb_equal_endpoints_constant>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/ramptb_equal_endpoints_constant.exr"
        }
    }
}
