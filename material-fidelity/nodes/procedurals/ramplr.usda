#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ramplr_color3 on the plane using explicit UV0 texcoords. The node linearly interpolates from left color (0.10, 0.20, 0.72) at U = 0 to right color (0.82, 0.58, 0.18) at U = 1. The render should show a visible left-to-right color ramp across the plane. The color3 output is connected directly to uniform_edf.color."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ramplr" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ramplr/ramplr.mtlx"
                string sourceMaterial = "M_ramplr"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ramplr/surface.outputs:out>
        token outputs:surface.connect = </Looks/ramplr/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ramplr_color3"
            color3f inputs:valuel = (0.10, 0.20, 0.72)
            color3f inputs:valuer = (0.82, 0.58, 0.18)
            float2 inputs:texcoord.connect = </Looks/ramplr/uv0.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ramplr/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ramplr/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ramplr>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/ramplr.exr"
        }
    }
}
