#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/input/input.mtlx"
                string sourceMaterial = "M_input"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input/SR_input.outputs:out>
        token outputs:surface.connect = </Looks/input/SR_input.outputs:out>

        def Shader "SR_input"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/input/NG_input.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_input"
        {
            color3f outputs:out_base_color.connect = </Looks/input/NG_input/final_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/input/NG_input/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/input/NG_input/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/input/NG_input/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/input/NG_input/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "uv_color_hot"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.95
                float inputs:in2.connect = </Looks/input/NG_input/uv_split.outputs:outx>
                float inputs:in3 = 0.2
                color3f outputs:out
            }

            def Shader "uv_color_cool"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.1
                float inputs:in2.connect = </Looks/input/NG_input/uv_split.outputs:outy>
                float inputs:in3 = 0.8
                color3f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_constant_color3"
                color3f inputs:value = (0.95, 0.45, 0.2)
                color3f outputs:out
            }

            def Shader "final_color"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </Looks/input/NG_input/uv_color_cool.outputs:out>
                color3f inputs:fg.connect = </Looks/input/NG_input/node_under_test.outputs:out>
                float inputs:mix.connect = </Looks/input/NG_input/uv_mix.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/input.exr"
        }
    }
}
