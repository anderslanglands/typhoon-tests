#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_constant_vector2 with literal value (0.25, 0.75). The node result is (0.25, 0.75). The vector2 result is converted to color3 as (x, y, 0), so the expected emitted RGB is (0.25, 0.75, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "constant_vector2" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/constant/constant_vector2.mtlx"
                string sourceMaterial = "M_constant_vector2"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/constant_vector2/surface.outputs:out>
        token outputs:surface.connect = </Looks/constant_vector2/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_constant_vector2"
            float2 inputs:value = (0.25, 0.75)
            float2 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector2_color3"
            float2 inputs:in.connect = </Looks/constant_vector2/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/constant_vector2/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/constant_vector2/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/constant_vector2>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/constant_vector2.exr"
        }
    }
}
