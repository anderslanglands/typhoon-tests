#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ramp4_vector3 on the plane using explicit UV0 texcoords. The node bilinearly interpolates four authored corner values: top-left (0.20, 0.72, 0.25), top-right (0.82, 0.60, 0.18), bottom-left (0.08, 0.18, 0.76), and bottom-right (0.55, 0.28, 0.32). The render should show a visible two-axis ramp across the plane instead of a flat color. The vector3 output is converted directly to color3 for display."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ramp4_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ramp4/ramp4_vector3.mtlx"
                string sourceMaterial = "M_ramp4_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ramp4_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/ramp4_vector3/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ramp4_vector3"
            float3 inputs:valuetl = (0.20, 0.72, 0.25)
            float3 inputs:valuetr = (0.82, 0.60, 0.18)
            float3 inputs:valuebl = (0.08, 0.18, 0.76)
            float3 inputs:valuebr = (0.55, 0.28, 0.32)
            float2 inputs:texcoord.connect = </Looks/ramp4_vector3/uv0.outputs:out>
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/ramp4_vector3/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ramp4_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ramp4_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ramp4_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/ramp4_vector3.exr"
        }
    }
}
