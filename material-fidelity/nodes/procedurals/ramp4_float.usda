#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ramp4_float on the plane using explicit UV0 texcoords. The node bilinearly interpolates four authored corner values: top-left 0.20, top-right 0.85, bottom-left 0.05, and bottom-right 0.55. The render should show a visible two-axis ramp across the plane instead of a flat color. The float output is displayed as RGB (value, 0, 0), so the red channel shows the ramp."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ramp4_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ramp4/ramp4_float.mtlx"
                string sourceMaterial = "M_ramp4_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ramp4_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/ramp4_float/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ramp4_float"
            float inputs:valuetl = 0.20
            float inputs:valuetr = 0.85
            float inputs:valuebl = 0.05
            float inputs:valuebr = 0.55
            float2 inputs:texcoord.connect = </Looks/ramp4_float/uv0.outputs:out>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/ramp4_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ramp4_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ramp4_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ramp4_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/ramp4_float.exr"
        }
    }
}
