#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_constant_string by outputting the literal string \"clamp\" and connecting it to ND_image_color3.uaddressmode in the same image-sampling graph used by geompropvalueuniform_string. The image samples grid.exr with texcoord offset by (0.5, 0), so U values above 1 should clamp to the texture edge rather than wrap; visible pixels should therefore differ from an unshifted or periodically wrapped grid sample."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "constant_string" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/constant/constant_string.mtlx"
                string sourceMaterial = "M_constant_string"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/constant_string/surface.outputs:out>
        token outputs:surface.connect = </Looks/constant_string/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_constant_string"
            string inputs:value = "clamp"
            string outputs:out
        }

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "uv_offset"
        {
            uniform token info:id = "ND_add_vector2"
            float2 inputs:in1.connect = </Looks/constant_string/uv0.outputs:out>
            float2 inputs:in2 = (0.5, 0)
            float2 outputs:out
        }

        def Shader "image"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 0, 1)
            asset inputs:file = @../../_assets/Materials/grid.exr@
            float2 inputs:texcoord.connect = </Looks/constant_string/uv_offset.outputs:out>
            string inputs:uaddressmode.connect = </Looks/constant_string/node_under_test.outputs:out>
            string inputs:vaddressmode = "constant"
            color3f outputs:out
        }

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/constant_string/image.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/constant_string/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/constant_string>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/constant_string.exr"
        }
    }
}
