#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_splitlr_color3 on the plane using explicit UV0 texcoords and center = 0.5. The node selects left color (0.12, 0.18, 0.72) for U below the split and right color (0.80, 0.55, 0.18) for U above the split, with the implementation antialiasing the boundary. The render should show a visible vertical color split on the plane. The color3 output is connected directly to uniform_edf.color."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "splitlr" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/splitlr/splitlr.mtlx"
                string sourceMaterial = "M_splitlr"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/splitlr/surface.outputs:out>
        token outputs:surface.connect = </Looks/splitlr/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_splitlr_color3"
            color3f inputs:valuel = (0.12, 0.18, 0.72)
            color3f inputs:valuer = (0.80, 0.55, 0.18)
            float inputs:center = 0.5
            float2 inputs:texcoord.connect = </Looks/splitlr/uv0.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/splitlr/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/splitlr/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/splitlr>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/splitlr.exr"
        }
    }
}
