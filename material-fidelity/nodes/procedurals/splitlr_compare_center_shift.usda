#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "splitlr_compare_center_shift" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/splitlr_compare_center_shift/splitlr_compare_center_shift.mtlx"
                string sourceMaterial = "M_splitlr_compare_center_shift"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/splitlr_compare_center_shift/surface.outputs:out>
        token outputs:surface.connect = </Looks/splitlr_compare_center_shift/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/splitlr_compare_center_shift/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_splitlr_compare_center_shift"
        {
            color3f outputs:out_base_color.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "splitlr_center_low"
            {
                uniform token info:id = "ND_splitlr_float"
                float inputs:center = 0.25
                float2 inputs:texcoord.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/uv0.outputs:out>
                float inputs:valuel = 0
                float inputs:valuer = 1
                float outputs:out
            }

            def Shader "splitlr_center_high"
            {
                uniform token info:id = "ND_splitlr_float"
                float inputs:center = 0.75
                float2 inputs:texcoord.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/uv0.outputs:out>
                float inputs:valuel = 0
                float inputs:valuer = 1
                float outputs:out
            }

            def Shader "center_delta_raw"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/splitlr_center_low.outputs:out>
                float inputs:in2.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/splitlr_center_high.outputs:out>
                float outputs:out
            }

            def Shader "center_delta"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/center_delta_raw.outputs:out>
                float outputs:out
            }

            def Shader "center_delta_amplified"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/center_delta.outputs:out>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/splitlr_center_low.outputs:out>
                float inputs:in2.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/splitlr_center_high.outputs:out>
                float inputs:in3.connect = </Looks/splitlr_compare_center_shift/NG_splitlr_compare_center_shift/center_delta_amplified.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/splitlr_compare_center_shift>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/splitlr_compare_center_shift.exr"
        }
    }
}
