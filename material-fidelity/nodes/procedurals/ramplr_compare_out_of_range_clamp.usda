#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ramplr_compare_out_of_range_clamp" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ramplr_compare_out_of_range_clamp/ramplr_compare_out_of_range_clamp.mtlx"
                string sourceMaterial = "M_ramplr_compare_out_of_range_clamp"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ramplr_compare_out_of_range_clamp/SR_ramplr_compare_out_of_range_clamp.outputs:out>
        token outputs:surface.connect = </Looks/ramplr_compare_out_of_range_clamp/SR_ramplr_compare_out_of_range_clamp.outputs:out>

        def Shader "SR_ramplr_compare_out_of_range_clamp"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_ramplr_compare_out_of_range_clamp"
        {
            color3f outputs:out_base_color.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "u_scaled"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/uv_split.outputs:outx>
                float inputs:in2 = 3
                float outputs:out
            }

            def Shader "u_out_of_range"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/u_scaled.outputs:out>
                float inputs:in2 = 1.5
                float outputs:out
            }

            def Shader "uv_out_of_range"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/u_out_of_range.outputs:out>
                float inputs:in2.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/uv_split.outputs:outy>
                float2 outputs:out
            }

            def Shader "ramplr_result"
            {
                uniform token info:id = "ND_ramplr_float"
                float2 inputs:texcoord.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/uv_out_of_range.outputs:out>
                float inputs:valuel = 0.2
                float inputs:valuer = 0.8
                float outputs:out
            }

            def Shader "u_clamped"
            {
                uniform token info:id = "ND_clamp_float"
                float inputs:high = 1
                float inputs:in.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/u_out_of_range.outputs:out>
                float inputs:low = 0
                float outputs:out
            }

            def Shader "range_span"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1 = 0.8
                float inputs:in2 = 0.2
                float outputs:out
            }

            def Shader "expected_scaled"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/u_clamped.outputs:out>
                float inputs:in2.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/range_span.outputs:out>
                float outputs:out
            }

            def Shader "expected_result"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/expected_scaled.outputs:out>
                float inputs:in2 = 0.2
                float outputs:out
            }

            def Shader "delta_raw"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/ramplr_result.outputs:out>
                float inputs:in2.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/expected_result.outputs:out>
                float outputs:out
            }

            def Shader "delta"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/delta_raw.outputs:out>
                float outputs:out
            }

            def Shader "delta_amplified"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/delta.outputs:out>
                float inputs:in2 = 16
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/ramplr_result.outputs:out>
                float inputs:in2.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/expected_result.outputs:out>
                float inputs:in3.connect = </Looks/ramplr_compare_out_of_range_clamp/NG_ramplr_compare_out_of_range_clamp/delta_amplified.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ramplr_compare_out_of_range_clamp>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/procedurals/ramplr_compare_out_of_range_clamp.exr"
        }
    }
}
