#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_combine2_color4CF: it combines color3 plus float alpha into color4. The literal inputs produce (0.2, 0.3, 0.4, 0.5). The four-channel result is packed into RGB as (r, g, b + a). The expected emitted RGB is (0.2, 0.3, 0.9)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "combine2_color4CF" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/combine2/combine2_color4CF.mtlx"
                string sourceMaterial = "M_combine2_color4CF"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/combine2_color4CF/surface.outputs:out>
        token outputs:surface.connect = </Looks/combine2_color4CF/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_combine2_color4CF"
            color3f inputs:in1 = (0.2, 0.3, 0.4)
            float inputs:in2 = 0.5
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/combine2_color4CF/node_under_test.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/combine2_color4CF/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/combine2_color4CF/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/combine2_color4CF/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/combine2_color4CF/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/combine2_color4CF/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/combine2_color4CF/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/combine2_color4CF/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/combine2_color4CF>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/combine2_color4CF.exr"
        }
    }
}
