#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_convert_integer_float with literal integer input 1. The explicit convert node should produce float value 1. The float result is packed into RGB as (value, 0, 0). The expected emitted RGB is (1, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_integer_to_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert/convert_explicit_integer_to_float.mtlx"
                string sourceMaterial = "M_convert_explicit_integer_to_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_integer_to_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_integer_to_float/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_convert_integer_float"
            int inputs:in = 1
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/convert_explicit_integer_to_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/convert_explicit_integer_to_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/convert_explicit_integer_to_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_integer_to_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_integer_to_float.exr"
        }
    }
}
