#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_integer_to_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert_explicit_integer_to_vector3/convert_explicit_integer_to_vector3.mtlx"
                string sourceMaterial = "M_convert_explicit_integer_to_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_integer_to_vector3/SR_convert_explicit_integer_to_vector3.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_integer_to_vector3/SR_convert_explicit_integer_to_vector3.outputs:out>

        def Shader "SR_convert_explicit_integer_to_vector3"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_convert_explicit_integer_to_vector3"
        {
            color3f outputs:out_base_color.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/display_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "source_node"
            {
                uniform token info:id = "ND_ifgreater_integer"
                int inputs:in1 = 2
                int inputs:in2 = 0
                float inputs:value1.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/uv_mix.outputs:out>
                float inputs:value2 = 0.5
                int outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_convert_integer_vector3"
                int inputs:in.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/source_node.outputs:out>
                float3 outputs:out
            }

            def Shader "display_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/convert_explicit_integer_to_vector3/NG_convert_explicit_integer_to_vector3/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_integer_to_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_integer_to_vector3.exr"
        }
    }
}
