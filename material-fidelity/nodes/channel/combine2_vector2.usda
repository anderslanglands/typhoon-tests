#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_combine2_vector2: it combines two floats into vector2. The literal inputs produce (0.2, 0.4). The vector2 result is packed into RGB as (x, y, 0). The expected emitted RGB is (0.2, 0.4, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "combine2_vector2" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/combine2/combine2_vector2.mtlx"
                string sourceMaterial = "M_combine2_vector2"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/combine2_vector2/surface.outputs:out>
        token outputs:surface.connect = </Looks/combine2_vector2/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_combine2_vector2"
            float inputs:in1 = 0.2
            float inputs:in2 = 0.4
            float2 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/combine2_vector2/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/combine2_vector2/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/combine2_vector2/display_channels.outputs:outy>
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/combine2_vector2/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/combine2_vector2/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/combine2_vector2>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/combine2_vector2.exr"
        }
    }
}
