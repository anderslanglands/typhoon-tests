#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_convert_integer_surfaceshader with in = 1. The convert node outputs an unlit surfaceshader; integer 1 converts to float 1 and then to white emission. The node output is bound directly as the material surface, so the expected emitted RGB is (1, 1, 1)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_integer_to_surfaceshader" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert/convert_explicit_integer_to_surfaceshader.mtlx"
                string sourceMaterial = "M_convert_explicit_integer_to_surfaceshader"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_integer_to_surfaceshader/node_under_test.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_integer_to_surfaceshader/node_under_test.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_convert_integer_surfaceshader"
            int inputs:in = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_integer_to_surfaceshader>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_integer_to_surfaceshader.exr"
        }
    }
}
