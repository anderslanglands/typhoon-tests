#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_convert_color4_surfaceshader with in = (0.2, 0.4, 0.6, 1). The convert node outputs an unlit surfaceshader; color4 RGB drives emission_color; alpha is set to 1 so opacity does not attenuate this fixture. The node output is bound directly as the material surface, so the expected emitted RGB is (0.2, 0.4, 0.6)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_color4_to_surfaceshader" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert/convert_explicit_color4_to_surfaceshader.mtlx"
                string sourceMaterial = "M_convert_explicit_color4_to_surfaceshader"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_color4_to_surfaceshader/node_under_test.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_color4_to_surfaceshader/node_under_test.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_convert_color4_surfaceshader"
            color4f inputs:in = (0.2, 0.4, 0.6, 1)
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_color4_to_surfaceshader>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_color4_to_surfaceshader.exr"
        }
    }
}
