#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_combine3_vector3: it combines three floats into vector3. The literal inputs produce (0.2, 0.3, 0.4). The vector3 result is converted to color3 for display. The expected emitted RGB is (0.2, 0.3, 0.4)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "combine3_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/combine3/combine3_vector3.mtlx"
                string sourceMaterial = "M_combine3_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/combine3_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/combine3_vector3/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_combine3_vector3"
            float inputs:in1 = 0.2
            float inputs:in2 = 0.3
            float inputs:in3 = 0.4
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/combine3_vector3/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/combine3_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/combine3_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/combine3_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/combine3_vector3.exr"
        }
    }
}
