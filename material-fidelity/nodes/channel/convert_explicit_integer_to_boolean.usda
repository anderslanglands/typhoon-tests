#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_convert_integer_boolean with literal integer input 1. The explicit convert node should produce boolean value true. The boolean result is converted to display color, with true as white and false as black. The expected emitted RGB is (1, 1, 1)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_integer_to_boolean" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert/convert_explicit_integer_to_boolean.mtlx"
                string sourceMaterial = "M_convert_explicit_integer_to_boolean"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_integer_to_boolean/surface.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_integer_to_boolean/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_convert_integer_boolean"
            int inputs:in = 1
            bool outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_boolean_color3"
            bool inputs:in.connect = </Looks/convert_explicit_integer_to_boolean/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/convert_explicit_integer_to_boolean/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/convert_explicit_integer_to_boolean/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_integer_to_boolean>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_integer_to_boolean.exr"
        }
    }
}
