#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_combine2_vector4VV: it combines two vector2 inputs into vector4. The literal inputs produce (0.2, 0.3, 0.4, 0.5). The four-channel result is packed into RGB as (x, y, z + w). The expected emitted RGB is (0.2, 0.3, 0.9)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "combine2_vector4VV" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/combine2/combine2_vector4VV.mtlx"
                string sourceMaterial = "M_combine2_vector4VV"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/combine2_vector4VV/surface.outputs:out>
        token outputs:surface.connect = </Looks/combine2_vector4VV/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_combine2_vector4VV"
            float2 inputs:in1 = (0.2, 0.3)
            float2 inputs:in2 = (0.4, 0.5)
            float4 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Looks/combine2_vector4VV/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/combine2_vector4VV/display_channels.outputs:outz>
            float inputs:in2.connect = </Looks/combine2_vector4VV/display_channels.outputs:outw>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/combine2_vector4VV/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/combine2_vector4VV/display_channels.outputs:outy>
            float inputs:in3.connect = </Looks/combine2_vector4VV/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/combine2_vector4VV/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/combine2_vector4VV/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/combine2_vector4VV>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/combine2_vector4VV.exr"
        }
    }
}
