#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_vector3_to_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert_explicit_vector3_to_color3/convert_explicit_vector3_to_color3.mtlx"
                string sourceMaterial = "M_convert_explicit_vector3_to_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_vector3_to_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_vector3_to_color3/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/convert_explicit_vector3_to_color3/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_convert_explicit_vector3_to_color3"
        {
            color3f outputs:out_base_color.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "source_node"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/uv_mix.outputs:out>
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/convert_explicit_vector3_to_color3/NG_convert_explicit_vector3_to_color3/source_node.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_vector3_to_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_vector3_to_color3.exr"
        }
    }
}
