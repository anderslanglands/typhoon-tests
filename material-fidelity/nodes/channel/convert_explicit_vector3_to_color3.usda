#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_convert_vector3_color3 with literal vector3 input (0.2, 0.4, 0.6). The explicit convert node should produce color3 value (0.2, 0.4, 0.6). The expected emitted RGB is (0.2, 0.4, 0.6)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "convert_explicit_vector3_to_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/convert/convert_explicit_vector3_to_color3.mtlx"
                string sourceMaterial = "M_convert_explicit_vector3_to_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/convert_explicit_vector3_to_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/convert_explicit_vector3_to_color3/surface.outputs:out>
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in = (0.2, 0.4, 0.6)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/convert_explicit_vector3_to_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/convert_explicit_vector3_to_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/convert_explicit_vector3_to_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/channel/convert_explicit_vector3_to_color3.exr"
        }
    }
}
