#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "difference_color4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/difference/difference_color4.mtlx"
                string sourceMaterial = "M_difference_color4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/difference_color4/surface.outputs:out>
        token outputs:surface.connect = </Looks/difference_color4/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/difference_color4/NG_difference_color4.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/difference_color4/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_difference_color4"
        {
            color3f outputs:out_base_color.connect = </Looks/difference_color4/NG_difference_color4/to_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "fg_image"
            {
                uniform token info:id = "ND_image_color4"
                color4f inputs:default = (1, 0, 1, 1)
                asset inputs:file = @../../_assets/Materials/radial.exr@
                float2 inputs:texcoord.connect = </Looks/difference_color4/NG_difference_color4/uv0.outputs:out>
                color4f outputs:out
            }

            def Shader "bg_image"
            {
                uniform token info:id = "ND_image_color4"
                color4f inputs:default = (1, 0, 1, 1)
                asset inputs:file = @../../_assets/Materials/grid.exr@
                float2 inputs:texcoord.connect = </Looks/difference_color4/NG_difference_color4/uv0.outputs:out>
                color4f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_difference_color4"
                color4f inputs:bg.connect = </Looks/difference_color4/NG_difference_color4/bg_image.outputs:out>
                color4f inputs:fg.connect = </Looks/difference_color4/NG_difference_color4/fg_image.outputs:out>
                float inputs:mix = 1
                color4f outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_color4_color3"
                color4f inputs:in.connect = </Looks/difference_color4/NG_difference_color4/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/difference_color4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/difference_color4.exr"
        }
    }
}
