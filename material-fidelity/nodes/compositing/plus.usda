#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "plus" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/plus/plus.mtlx"
                string sourceMaterial = "M_plus"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/plus/surface.outputs:out>
        token outputs:surface.connect = </Looks/plus/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/plus/NG_plus.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/plus/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_plus"
        {
            color3f outputs:out_base_color.connect = </Looks/plus/NG_plus/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "fg_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/radial.exr@
                float2 inputs:texcoord.connect = </Looks/plus/NG_plus/uv0.outputs:out>
                color3f outputs:out
            }

            def Shader "bg_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/grid.exr@
                float2 inputs:texcoord.connect = </Looks/plus/NG_plus/uv0.outputs:out>
                color3f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_plus_color3"
                color3f inputs:bg.connect = </Looks/plus/NG_plus/bg_image.outputs:out>
                color3f inputs:fg.connect = </Looks/plus/NG_plus/fg_image.outputs:out>
                float inputs:mix = 1
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/plus>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/plus.exr"
        }
    }
}
