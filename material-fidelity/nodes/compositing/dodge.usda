#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "dodge" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/dodge/dodge.mtlx"
                string sourceMaterial = "M_dodge"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/dodge/surface.outputs:out>
        token outputs:surface.connect = </Looks/dodge/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/dodge/NG_dodge.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/dodge/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_dodge"
        {
            color3f outputs:out_base_color.connect = </Looks/dodge/NG_dodge/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "fg_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/radial.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/dodge/NG_dodge/uv0.outputs:out>
                color3f outputs:out
            }

            def Shader "bg_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/grid.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/dodge/NG_dodge/uv0.outputs:out>
                color3f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_dodge_color3"
                color3f inputs:bg.connect = </Looks/dodge/NG_dodge/bg_image.outputs:out>
                color3f inputs:fg.connect = </Looks/dodge/NG_dodge/fg_image.outputs:out>
                float inputs:mix = 1
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/dodge>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/dodge.exr"
        }
    }
}
