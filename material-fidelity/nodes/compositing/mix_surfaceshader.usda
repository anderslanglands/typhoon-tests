#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "mix_surfaceshader" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/mix/mix_surfaceshader.mtlx"
                string sourceMaterial = "M_mix_surfaceshader"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/mix_surfaceshader/node_under_test.outputs:out>
        token outputs:surface.connect = </Looks/mix_surfaceshader/node_under_test.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }

        def Shader "fg_image"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 0, 1)
            asset inputs:file = @../../_assets/Materials/radial.exr@
            float2 inputs:texcoord.connect = </Looks/mix_surfaceshader/uv0.outputs:out>
            color3f outputs:out
        }

        def Shader "fg_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/mix_surfaceshader/fg_image.outputs:out>
            token outputs:out
        }

        def Shader "fg_surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/mix_surfaceshader/fg_edf.outputs:out>
            token outputs:out
        }

        def Shader "bg_image"
        {
            uniform token info:id = "ND_image_color3"
            color3f inputs:default = (1, 0, 1)
            asset inputs:file = @../../_assets/Materials/grid.exr@
            float2 inputs:texcoord.connect = </Looks/mix_surfaceshader/uv0.outputs:out>
            color3f outputs:out
        }

        def Shader "bg_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/mix_surfaceshader/bg_image.outputs:out>
            token outputs:out
        }

        def Shader "bg_surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/mix_surfaceshader/bg_edf.outputs:out>
            token outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_mix_surfaceshader"
            token inputs:bg.connect = </Looks/mix_surfaceshader/bg_surface.outputs:out>
            token inputs:fg.connect = </Looks/mix_surfaceshader/fg_surface.outputs:out>
            float inputs:mix = 0.5
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/mix_surfaceshader>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/mix_surfaceshader.exr"
        }
    }
}
