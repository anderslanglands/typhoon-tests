#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "mix" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/mix/mix.mtlx"
                string sourceMaterial = "M_mix"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/mix/surface.outputs:out>
        token outputs:surface.connect = </Looks/mix/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/mix/NG_mix.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/mix/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_mix"
        {
            color3f outputs:out_base_color.connect = </Looks/mix/NG_mix/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "fg_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/radial.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/mix/NG_mix/uv0.outputs:out>
                color3f outputs:out
            }

            def Shader "bg_image"
            {
                uniform token info:id = "ND_image_color3"
                color3f inputs:default = (1, 0, 1)
                asset inputs:file = @../../_assets/Materials/grid.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/mix/NG_mix/uv0.outputs:out>
                color3f outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </Looks/mix/NG_mix/bg_image.outputs:out>
                color3f inputs:fg.connect = </Looks/mix/NG_mix/fg_image.outputs:out>
                float inputs:mix = 0.5
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/mix>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/mix.exr"
        }
    }
}
