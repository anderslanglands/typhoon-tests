#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "mix_degenerate_unclamped_mix_factor" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/mix_degenerate_unclamped_mix_factor/mix_degenerate_unclamped_mix_factor.mtlx"
                string sourceMaterial = "M_mix_degenerate_unclamped_mix_factor"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/mix_degenerate_unclamped_mix_factor/SR_mix_degenerate_unclamped_mix_factor.outputs:out>
        token outputs:surface.connect = </Looks/mix_degenerate_unclamped_mix_factor/SR_mix_degenerate_unclamped_mix_factor.outputs:out>

        def Shader "SR_mix_degenerate_unclamped_mix_factor"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_mix_degenerate_unclamped_mix_factor"
        {
            color3f outputs:out_base_color.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/debug_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "mix_factor"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/uv_split.outputs:outx>
                float inputs:in2 = 2
                float outputs:out
            }

            def Shader "mix_factor_unclamped"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/mix_factor.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_mix_float"
                float inputs:bg = 0
                float inputs:fg = 1
                float inputs:mix.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/mix_factor_unclamped.outputs:out>
                float outputs:out
            }

            def Shader "debug_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/node_under_test.outputs:out>
                float inputs:in2.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/mix_factor_unclamped.outputs:out>
                float inputs:in3.connect = </Looks/mix_degenerate_unclamped_mix_factor/NG_mix_degenerate_unclamped_mix_factor/uv_split.outputs:outy>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/mix_degenerate_unclamped_mix_factor>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/mix_degenerate_unclamped_mix_factor.exr"
        }
    }
}
