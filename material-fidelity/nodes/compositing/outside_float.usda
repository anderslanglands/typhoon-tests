#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "outside_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/outside/outside_float.mtlx"
                string sourceMaterial = "M_outside_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/outside_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/outside_float/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/outside_float/NG_outside_float.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/outside_float/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_outside_float"
        {
            color3f outputs:out_base_color.connect = </Looks/outside_float/NG_outside_float/to_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "input_image"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 1
                asset inputs:file = @../../_assets/Materials/radial.exr@
                float2 inputs:texcoord.connect = </Looks/outside_float/NG_outside_float/uv0.outputs:out>
                float outputs:out
            }

            def Shader "mask_image"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 1
                asset inputs:file = @../../_assets/Materials/grid.exr@
                float2 inputs:texcoord.connect = </Looks/outside_float/NG_outside_float/uv0.outputs:out>
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_outside_float"
                float inputs:in.connect = </Looks/outside_float/NG_outside_float/input_image.outputs:out>
                float inputs:mask.connect = </Looks/outside_float/NG_outside_float/mask_image.outputs:out>
                float outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_float_color3"
                float inputs:in.connect = </Looks/outside_float/NG_outside_float/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/outside_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/outside_float.exr"
        }
    }
}
