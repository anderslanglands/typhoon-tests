#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "mix_degenerate_unclamped_mix_factor_png" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/mix_degenerate_unclamped_mix_factor_png/mix_degenerate_unclamped_mix_factor_png.mtlx"
                string sourceMaterial = "M_mix_degenerate_unclamped_mix_factor_png"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/surface.outputs:out>
        token outputs:surface.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_mix_degenerate_unclamped_mix_factor_png"
        {
            color3f outputs:out_base_color.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/to_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "mix_factor"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/uv_split.outputs:outx>
                float inputs:in2 = 2
                float outputs:out
            }

            def Shader "mix_factor_unclamped"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/mix_factor.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "fg_image"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 1
                asset inputs:file = @../../_assets/Materials/radial.png@ (
                    colorSpace = "srgb_rec709_scene"
                )
                float2 inputs:texcoord.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/uv0.outputs:out>
                float outputs:out
            }

            def Shader "bg_image"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 1
                asset inputs:file = @../../_assets/Materials/grid.png@ (
                    colorSpace = "srgb_rec709_scene"
                )
                float2 inputs:texcoord.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/uv0.outputs:out>
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_mix_float"
                float inputs:bg.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/bg_image.outputs:out>
                float inputs:fg.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/fg_image.outputs:out>
                float inputs:mix.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/mix_factor_unclamped.outputs:out>
                float outputs:out
            }

            def Shader "to_color"
            {
                uniform token info:id = "ND_convert_float_color3"
                float inputs:in.connect = </Looks/mix_degenerate_unclamped_mix_factor_png/NG_mix_degenerate_unclamped_mix_factor_png/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/mix_degenerate_unclamped_mix_factor_png>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/mix_degenerate_unclamped_mix_factor_png.exr"
        }
    }
}
