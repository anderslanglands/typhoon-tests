#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_mix_edf by mixing two uniform EDF closures with colors (0.8, 0.2, 0.1) and (0.2, 0.4, 0.9) at mix = 0.25. The mixed EDF should emit bg * 0.75 + fg * 0.25 = (0.35, 0.35, 0.7), so the expected emitted RGB is (0.35, 0.35, 0.7)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "mix_edf"
    {
        token outputs:mtlx:surface.connect = </Looks/mix_edf/surface.outputs:out>
        token outputs:surface.connect = </Looks/mix_edf/surface.outputs:out>
        def Shader "fg_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.8, 0.2, 0.1)
            token outputs:out
        }
        def Shader "bg_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color = (0.2, 0.4, 0.9)
            token outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_mix_edf"
            token inputs:bg.connect = </Looks/mix_edf/bg_edf.outputs:out>
            token inputs:fg.connect = </Looks/mix_edf/fg_edf.outputs:out>
            float inputs:mix = 0.25
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/mix_edf/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/mix_edf>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/compositing/mix_edf.exr"
        }
    }
}
