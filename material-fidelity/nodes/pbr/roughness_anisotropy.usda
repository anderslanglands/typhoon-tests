#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_roughness_anisotropy by using its vector2 output to drive ND_conductor_bsdf. The node receives roughness 0.45 and anisotropy 0.95, which squares the roughness and stretches it along the tangent direction to produce approximately (0.9056, 0.0453). That roughness is connected directly to a default gold-like conductor BSDF on the shaderball, so the reflected dome lighting should show the default anisotropy orientation with a broad tangent-direction lobe and tight bitangent-direction lobe."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "roughness_anisotropy" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/roughness_anisotropy/roughness_anisotropy.mtlx"
                string sourceMaterial = "M_roughness_anisotropy"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/roughness_anisotropy/surface.outputs:out>
        token outputs:surface.connect = </Looks/roughness_anisotropy/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_roughness_anisotropy"
            float inputs:anisotropy = 0.95
            float inputs:roughness = 0.45
            float2 outputs:out
        }


        def Shader "conductor_bsdf"
        {
            uniform token info:id = "ND_conductor_bsdf"
            float2 inputs:roughness.connect = </Looks/roughness_anisotropy/node_under_test.outputs:out>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/roughness_anisotropy/conductor_bsdf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/roughness_anisotropy>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 32

        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/roughness_anisotropy.exr"
        }
    }
}
