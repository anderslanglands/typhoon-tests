#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "burley_diffuse_bsdf_smooth" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/burley_diffuse_bsdf_smooth/burley_diffuse_bsdf_smooth.mtlx"
                string sourceMaterial = "M_burley_diffuse_bsdf_smooth"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/burley_diffuse_bsdf_smooth/surface.outputs:out>
        token outputs:surface.connect = </Looks/burley_diffuse_bsdf_smooth/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_burley_diffuse_bsdf"
            color3f inputs:color = (0.55, 0.55, 0.55)
            float inputs:roughness = 0
            float inputs:weight = 1
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/burley_diffuse_bsdf_smooth/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/burley_diffuse_bsdf_smooth>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/burley_diffuse_bsdf_smooth.exr"
        }
    }
}
