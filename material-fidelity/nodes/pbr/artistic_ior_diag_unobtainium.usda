#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "artistic_ior_diag_unobtainium" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/artistic_ior_diag_unobtainium/artistic_ior_diag_unobtainium.mtlx"
                string sourceMaterial = "M_artistic_ior_diag_unobtainium"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/artistic_ior_diag_unobtainium/SR_artistic_ior_diag_unobtainium.outputs:out>
        token outputs:surface.connect = </Looks/artistic_ior_diag_unobtainium/SR_artistic_ior_diag_unobtainium.outputs:out>

        def Shader "SR_artistic_ior_diag_unobtainium"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium.outputs:out_base_color>
            float inputs:emission = 0.3
            color3f inputs:emission_color.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium.outputs:out_emission_color>
            float inputs:specular = 0.1
            float inputs:specular_roughness = 0.35
            token outputs:out
        }

        def NodeGraph "NG_artistic_ior_diag_unobtainium"
        {
            color3f outputs:out_base_color.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/display_color.outputs:out>
            color3f outputs:out_emission_color.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/ior_display.outputs:out>

            def Shader "reflectivity"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.4
                float inputs:in2 = 0.4
                float inputs:in3 = 0.4
                color3f outputs:out
            }

            def Shader "edge_tint"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 1
                float inputs:in2 = 0.5
                float inputs:in3 = 0
                color3f outputs:out
            }

            def Shader "artistic_ior_values"
            {
                uniform token info:id = "ND_artistic_ior"
                color3f inputs:edge_color.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/edge_tint.outputs:out>
                color3f inputs:reflectivity.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/reflectivity.outputs:out>
                color3f outputs:extinction
                color3f outputs:ior
            }

            def Shader "ior_display"
            {
                uniform token info:id = "ND_range_color3"
                color3f inputs:gamma = (1, 1, 1)
                color3f inputs:in.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/artistic_ior_values.outputs:ior>
                color3f inputs:inhigh = (25, 25, 25)
                color3f inputs:inlow = (0, 0, 0)
                color3f inputs:outhigh = (1, 1, 1)
                color3f inputs:outlow = (0, 0, 0)
                color3f outputs:out
            }

            def Shader "extinction_display"
            {
                uniform token info:id = "ND_range_color3"
                color3f inputs:gamma = (1, 1, 1)
                color3f inputs:in.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/artistic_ior_values.outputs:extinction>
                color3f inputs:inhigh = (25, 25, 25)
                color3f inputs:inlow = (0, 0, 0)
                color3f inputs:outhigh = (1, 1, 1)
                color3f inputs:outlow = (0, 0, 0)
                color3f outputs:out
            }

            def Shader "display_color"
            {
                uniform token info:id = "ND_mix_color3"
                color3f inputs:bg.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/extinction_display.outputs:out>
                color3f inputs:fg.connect = </Looks/artistic_ior_diag_unobtainium/NG_artistic_ior_diag_unobtainium/ior_display.outputs:out>
                float inputs:mix = 0.5
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/artistic_ior_diag_unobtainium>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/artistic_ior_diag_unobtainium.exr"
        }
    }
}
