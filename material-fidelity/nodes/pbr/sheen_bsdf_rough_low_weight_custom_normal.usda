#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sheen_bsdf_rough_low_weight_custom_normal" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/sheen_bsdf_rough_low_weight_custom_normal/sheen_bsdf_rough_low_weight_custom_normal.mtlx"
                string sourceMaterial = "M_sheen_bsdf_rough_low_weight_custom_normal"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sheen_bsdf_rough_low_weight_custom_normal/surface.outputs:out>
        token outputs:surface.connect = </Looks/sheen_bsdf_rough_low_weight_custom_normal/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_sheen_bsdf"
            color3f inputs:color = (0.08, 0.65, 0.85)
            string inputs:mode = "conty_kulla"
            float3 inputs:normal = (0.35, 0, 0.93675)
            float inputs:roughness = 0.9
            float inputs:weight = 0.35
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/sheen_bsdf_rough_low_weight_custom_normal/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/sheen_bsdf_rough_low_weight_custom_normal>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/sheen_bsdf_rough_low_weight_custom_normal.exr"
        }
    }
}
