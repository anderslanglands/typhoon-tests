#usda 1.0
(
    customLayerData = {
        string doc = "Tests a volume-only material path with ND_anisotropic_vdf. The material intentionally authors only outputs:mtlx:volume and outputs:volume, with no surface output connected. ND_anisotropic_vdf receives absorption (0.35, 0.18, 0.08), scattering (0.08, 0.18, 0.32), and anisotropy 0.55, then ND_volume wraps that VDF into a volumeshader. Bound to the closed shaderball, supported renderers should render the participating medium alone: dome-lit rays through the object should show tinted attenuation and forward-biased scattering without any surface BSDF or EDF contribution."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "anisotropic_vdf_volume_only" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/anisotropic_vdf/anisotropic_vdf_volume_only.mtlx"
                string sourceMaterial = "M_anisotropic_vdf_volume_only"
            }
        }
    )
    {
        token outputs:mtlx:volume.connect = </Looks/anisotropic_vdf_volume_only/volume.outputs:out>
        token outputs:volume.connect = </Looks/anisotropic_vdf_volume_only/volume.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_anisotropic_vdf"
            float3 inputs:absorption = (0.35, 0.18, 0.08)
            float3 inputs:scattering = (0.08, 0.18, 0.32)
            float inputs:anisotropy = 0.55
            token outputs:out
        }

        def Shader "volume"
        {
            uniform token info:id = "ND_volume"
            token inputs:vdf.connect = </Looks/anisotropic_vdf_volume_only/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/anisotropic_vdf_volume_only>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 64

        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/anisotropic_vdf_volume_only.exr"
        }
    }
}
