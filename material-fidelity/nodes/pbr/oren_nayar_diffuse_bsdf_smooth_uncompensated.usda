#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "oren_nayar_diffuse_bsdf_smooth_uncompensated" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/oren_nayar_diffuse_bsdf_smooth_uncompensated/oren_nayar_diffuse_bsdf_smooth_uncompensated.mtlx"
                string sourceMaterial = "M_oren_nayar_diffuse_bsdf_smooth_uncompensated"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/oren_nayar_diffuse_bsdf_smooth_uncompensated/surface.outputs:out>
        token outputs:surface.connect = </Looks/oren_nayar_diffuse_bsdf_smooth_uncompensated/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_oren_nayar_diffuse_bsdf"
            color3f inputs:color = (0.55, 0.55, 0.55)
            bool inputs:energy_compensation = 0
            float inputs:roughness = 0
            float inputs:weight = 1
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/oren_nayar_diffuse_bsdf_smooth_uncompensated/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/oren_nayar_diffuse_bsdf_smooth_uncompensated>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/oren_nayar_diffuse_bsdf_smooth_uncompensated.exr"
        }
    }
}
