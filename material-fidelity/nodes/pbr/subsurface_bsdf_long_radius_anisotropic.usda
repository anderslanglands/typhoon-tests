#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "subsurface_bsdf_long_radius_anisotropic" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/subsurface_bsdf_long_radius_anisotropic/subsurface_bsdf_long_radius_anisotropic.mtlx"
                string sourceMaterial = "M_subsurface_bsdf_long_radius_anisotropic"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/subsurface_bsdf_long_radius_anisotropic/surface.outputs:out>
        token outputs:surface.connect = </Looks/subsurface_bsdf_long_radius_anisotropic/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_subsurface_bsdf"
            float inputs:anisotropy = 0.8
            color3f inputs:color = (0.9, 0.32, 0.18)
            float3 inputs:normal = (0.35, 0, 0.93675)
            color3f inputs:radius = (1.5, 0.5, 0.15)
            float inputs:weight = 0.5
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:bsdf.connect = </Looks/subsurface_bsdf_long_radius_anisotropic/node_under_test.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/subsurface_bsdf_long_radius_anisotropic>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/pbr/subsurface_bsdf_long_radius_anisotropic.exr"
        }
    }
}
