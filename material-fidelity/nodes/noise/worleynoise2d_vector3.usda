#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "worleynoise2d_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/worleynoise2d_vector3/worleynoise2d_vector3.mtlx"
                string sourceMaterial = "M_worleynoise2d_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/worleynoise2d_vector3/SR_worleynoise2d_vector3.outputs:out>
        token outputs:surface.connect = </Looks/worleynoise2d_vector3/SR_worleynoise2d_vector3.outputs:out>

        def Shader "SR_worleynoise2d_vector3"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/worleynoise2d_vector3/NG_worleynoise2d_vector3.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_worleynoise2d_vector3"
        {
            color3f outputs:out_base_color.connect = </Looks/worleynoise2d_vector3/NG_worleynoise2d_vector3/base_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector2"
                float2 inputs:in1.connect = </Looks/worleynoise2d_vector3/NG_worleynoise2d_vector3/uv0.outputs:out>
                float2 inputs:in2 = (20, 17)
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_worleynoise2d_vector3"
                float inputs:jitter = 0.65
                int inputs:style = 1
                float2 inputs:texcoord.connect = </Looks/worleynoise2d_vector3/NG_worleynoise2d_vector3/coords_under_test.outputs:out>
                float3 outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/worleynoise2d_vector3/NG_worleynoise2d_vector3/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/worleynoise2d_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/worleynoise2d_vector3.exr"
        }
    }
}
