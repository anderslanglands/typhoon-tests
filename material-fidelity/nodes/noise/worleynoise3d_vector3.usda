#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "worleynoise3d_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/worleynoise3d_vector3/worleynoise3d_vector3.mtlx"
                string sourceMaterial = "M_worleynoise3d_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/worleynoise3d_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/worleynoise3d_vector3/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/worleynoise3d_vector3/NG_worleynoise3d_vector3.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/worleynoise3d_vector3/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_worleynoise3d_vector3"
        {
            color3f outputs:out_base_color.connect = </Looks/worleynoise3d_vector3/NG_worleynoise3d_vector3/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/worleynoise3d_vector3/NG_worleynoise3d_vector3/pos0.outputs:out>
                float3 inputs:in2 = (5, 6, 7)
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_worleynoise3d_vector3"
                float inputs:jitter = 0.65
                float3 inputs:position.connect = </Looks/worleynoise3d_vector3/NG_worleynoise3d_vector3/coords_under_test.outputs:out>
                int inputs:style = 1
                float3 outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_convert_vector3_color3"
                float3 inputs:in.connect = </Looks/worleynoise3d_vector3/NG_worleynoise3d_vector3/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/worleynoise3d_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/worleynoise3d_vector3.exr"
        }
    }
}
