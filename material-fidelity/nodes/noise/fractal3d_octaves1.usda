#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal3d_octaves1" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal3d_octaves1/fractal3d_octaves1.mtlx"
                string sourceMaterial = "M_fractal3d_octaves1"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal3d_octaves1/SR_fractal3d_octaves1.outputs:out>
        token outputs:surface.connect = </Looks/fractal3d_octaves1/SR_fractal3d_octaves1.outputs:out>

        def Shader "SR_fractal3d_octaves1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_fractal3d_octaves1"
        {
            color3f outputs:out_base_color.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/pos0.outputs:out>
                float3 inputs:in2 = (6, 6, 6)
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_fractal3d_float"
                float inputs:amplitude = 1.35
                float inputs:diminish = 0.55
                float inputs:lacunarity = 2.25
                int inputs:octaves = 1
                float3 inputs:position.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/coords_under_test.outputs:out>
                float outputs:out
            }

            def Shader "noise_01"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/node_under_test.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_r"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_g"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_b"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0.47
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/tint_r.outputs:out>
                float inputs:in2.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/tint_g.outputs:out>
                float inputs:in3.connect = </Looks/fractal3d_octaves1/NG_fractal3d_octaves1/tint_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal3d_octaves1>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal3d_octaves1.exr"
        }
    }
}
