#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_noise3d_vector4 on the plane with object-space position scaled by (6, 6, 6), per-channel vector4 amplitude (0.9, 0.65, 0.45, 0.25), and pivot 0. noise3d should render a non-uniform zero-centered 3D Perlin noise pattern rather than a flat color. The signed vector4 output is clamped and remapped from [-1, 1] to [0, 1] per component for display, then packed into RGB as (x, y, z + w); the packed blue channel may saturate where both source channels are high. This is a visual coverage fixture for the typed NodeDef variant, so the important result is visible procedural variation in the packed RGB channels."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "noise3d_vector4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/noise3d/noise3d_vector4.mtlx"
                string sourceMaterial = "M_noise3d_vector4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/noise3d_vector4/surface.outputs:out>
        token outputs:surface.connect = </Looks/noise3d_vector4/surface.outputs:out>

        def Shader "base_coord"
        {
            uniform token info:id = "ND_position_vector3"
            float3 outputs:out
        }
        def Shader "coords_under_test"
        {
            uniform token info:id = "ND_multiply_vector3"
            float3 inputs:in1.connect = </Looks/noise3d_vector4/base_coord.outputs:out>
            float3 inputs:in2 = (6, 6, 6)
            float3 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_noise3d_vector4"
            float4 inputs:amplitude = (0.9, 0.65, 0.45, 0.25)
            float inputs:pivot = 0
            float3 inputs:position.connect = </Looks/noise3d_vector4/coords_under_test.outputs:out>
            float4 outputs:out
        }
        def Shader "display_remap"
        {
            uniform token info:id = "ND_range_vector4"
            bool inputs:doclamp = 1
            float4 inputs:in.connect = </Looks/noise3d_vector4/node_under_test.outputs:out>
            float4 inputs:inlow = (-1, -1, -1, -1)
            float4 inputs:inhigh = (1, 1, 1, 1)
            float4 inputs:outlow = (0, 0, 0, 0)
            float4 inputs:outhigh = (1, 1, 1, 1)
            float4 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Looks/noise3d_vector4/display_remap.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/noise3d_vector4/display_channels.outputs:outz>
            float inputs:in2.connect = </Looks/noise3d_vector4/display_channels.outputs:outw>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/noise3d_vector4/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/noise3d_vector4/display_channels.outputs:outy>
            float inputs:in3.connect = </Looks/noise3d_vector4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/noise3d_vector4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/noise3d_vector4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/noise3d_vector4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/noise3d_vector4.exr"
        }
    }
}
