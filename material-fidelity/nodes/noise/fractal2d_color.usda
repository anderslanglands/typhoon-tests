#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal2d_color" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal2d_color/fractal2d_color.mtlx"
                string sourceMaterial = "M_fractal2d_color"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal2d_color/surface.outputs:out>
        token outputs:surface.connect = </Looks/fractal2d_color/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/fractal2d_color/NG_fractal2d_color.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/fractal2d_color/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_fractal2d_color"
        {
            color3f outputs:out_base_color.connect = </Looks/fractal2d_color/NG_fractal2d_color/color_01.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector2"
                float2 inputs:in1.connect = </Looks/fractal2d_color/NG_fractal2d_color/uv0.outputs:out>
                float2 inputs:in2 = (20, 17)
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_fractal2d_color3"
                float3 inputs:amplitude = (0.9, 0.75, 0.6)
                float inputs:diminish = 0.55
                float inputs:lacunarity = 2.25
                int inputs:octaves = 5
                float2 inputs:texcoord.connect = </Looks/fractal2d_color/NG_fractal2d_color/coords_under_test.outputs:out>
                color3f outputs:out
            }

            def Shader "color_01"
            {
                uniform token info:id = "ND_range_color3"
                bool inputs:doclamp = 1
                color3f inputs:in.connect = </Looks/fractal2d_color/NG_fractal2d_color/node_under_test.outputs:out>
                color3f inputs:inhigh = (1, 1, 1)
                color3f inputs:inlow = (-1, -1, -1)
                color3f inputs:outhigh = (1, 1, 1)
                color3f inputs:outlow = (0, 0, 0)
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal2d_color>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal2d_color.exr"
        }
    }
}
