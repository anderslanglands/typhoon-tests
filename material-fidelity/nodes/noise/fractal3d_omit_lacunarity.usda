#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal3d_omit_lacunarity" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal3d_omit_lacunarity/fractal3d_omit_lacunarity.mtlx"
                string sourceMaterial = "M_fractal3d_omit_lacunarity"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal3d_omit_lacunarity/surface.outputs:out>
        token outputs:surface.connect = </Looks/fractal3d_omit_lacunarity/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/fractal3d_omit_lacunarity/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_fractal3d_omit_lacunarity"
        {
            color3f outputs:out_base_color.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "pos_scale"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 5.5
                float inputs:in2 = 5.5
                float inputs:in3 = 5.5
                float3 outputs:out
            }

            def Shader "pos_scaled"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/pos0.outputs:out>
                float3 inputs:in2.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/pos_scale.outputs:out>
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_fractal3d_float"
                float inputs:amplitude = 1.4
                float inputs:diminish = 0.58
                int inputs:octaves = 5
                float3 inputs:position.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/pos_scaled.outputs:out>
                float outputs:out
            }

            def Shader "noise_01"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/node_under_test.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_r"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_g"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_b"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0.62
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/tint_r.outputs:out>
                float inputs:in2.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/tint_g.outputs:out>
                float inputs:in3.connect = </Looks/fractal3d_omit_lacunarity/NG_fractal3d_omit_lacunarity/tint_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal3d_omit_lacunarity>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal3d_omit_lacunarity.exr"
        }
    }
}
