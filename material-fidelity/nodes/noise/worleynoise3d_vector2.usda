#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "worleynoise3d_vector2" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/worleynoise3d_vector2/worleynoise3d_vector2.mtlx"
                string sourceMaterial = "M_worleynoise3d_vector2"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/worleynoise3d_vector2/SR_worleynoise3d_vector2.outputs:out>
        token outputs:surface.connect = </Looks/worleynoise3d_vector2/SR_worleynoise3d_vector2.outputs:out>

        def Shader "SR_worleynoise3d_vector2"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/worleynoise3d_vector2/NG_worleynoise3d_vector2.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_worleynoise3d_vector2"
        {
            color3f outputs:out_base_color.connect = </Looks/worleynoise3d_vector2/NG_worleynoise3d_vector2/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/worleynoise3d_vector2/NG_worleynoise3d_vector2/pos0.outputs:out>
                float3 inputs:in2 = (5, 6, 7)
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_worleynoise3d_vector2"
                float inputs:jitter = 0.65
                float3 inputs:position.connect = </Looks/worleynoise3d_vector2/NG_worleynoise3d_vector2/coords_under_test.outputs:out>
                int inputs:style = 1
                float2 outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_convert_vector2_color3"
                float2 inputs:in.connect = </Looks/worleynoise3d_vector2/NG_worleynoise3d_vector2/node_under_test.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/worleynoise3d_vector2>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/worleynoise3d_vector2.exr"
        }
    }
}
