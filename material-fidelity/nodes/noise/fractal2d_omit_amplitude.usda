#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal2d_omit_amplitude" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal2d_omit_amplitude/fractal2d_omit_amplitude.mtlx"
                string sourceMaterial = "M_fractal2d_omit_amplitude"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal2d_omit_amplitude/SR_fractal2d_omit_amplitude.outputs:out>
        token outputs:surface.connect = </Looks/fractal2d_omit_amplitude/SR_fractal2d_omit_amplitude.outputs:out>

        def Shader "SR_fractal2d_omit_amplitude"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_fractal2d_omit_amplitude"
        {
            color3f outputs:out_base_color.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/base_color.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_scale"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1 = 18
                float inputs:in2 = 18
                float2 outputs:out
            }

            def Shader "uv_scaled"
            {
                uniform token info:id = "ND_multiply_vector2"
                float2 inputs:in1.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/uv0.outputs:out>
                float2 inputs:in2.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/uv_scale.outputs:out>
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_fractal2d_float"
                float inputs:diminish = 0.55
                float inputs:lacunarity = 2.25
                int inputs:octaves = 5
                float2 inputs:texcoord.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/uv_scaled.outputs:out>
                float outputs:out
            }

            def Shader "noise_01"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/node_under_test.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_r"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0.65
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_g"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_b"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/tint_r.outputs:out>
                float inputs:in2.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/tint_g.outputs:out>
                float inputs:in3.connect = </Looks/fractal2d_omit_amplitude/NG_fractal2d_omit_amplitude/tint_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal2d_omit_amplitude>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal2d_omit_amplitude.exr"
        }
    }
}
