#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "unifiednoise3d_defaults" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/unifiednoise3d_defaults/unifiednoise3d_defaults.mtlx"
                string sourceMaterial = "M_unifiednoise3d_defaults"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/unifiednoise3d_defaults/surface.outputs:out>
        token outputs:surface.connect = </Looks/unifiednoise3d_defaults/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/unifiednoise3d_defaults/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_unifiednoise3d_defaults"
        {
            color3f outputs:out_base_color.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "pos_scale"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 5
                float inputs:in2 = 5
                float inputs:in3 = 5
                float3 outputs:out
            }

            def Shader "pos_scaled"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/pos0.outputs:out>
                float3 inputs:in2.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/pos_scale.outputs:out>
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_unifiednoise3d_float"
                bool inputs:clampoutput = 1
                float inputs:diminish = 0.5
                float3 inputs:freq = (1, 1, 1)
                float inputs:jitter = 1
                float inputs:lacunarity = 2
                int inputs:octaves = 3
                float3 inputs:offset = (0, 0, 0)
                float inputs:outmax = 1
                float inputs:outmin = 0
                float3 inputs:position.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/pos0.outputs:out>
                int inputs:style = 0
                int inputs:type = 0
                float outputs:out
            }

            def Shader "noise_01"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/node_under_test.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_r"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_g"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0.71
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_b"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/tint_r.outputs:out>
                float inputs:in2.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/tint_g.outputs:out>
                float inputs:in3.connect = </Looks/unifiednoise3d_defaults/NG_unifiednoise3d_defaults/tint_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/unifiednoise3d_defaults>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/unifiednoise3d_defaults.exr"
        }
    }
}
