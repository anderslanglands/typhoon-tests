#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "worleynoise3d" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/worleynoise3d/worleynoise3d.mtlx"
                string sourceMaterial = "M_worleynoise3d"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/worleynoise3d/SR_worleynoise3d.outputs:out>
        token outputs:surface.connect = </Looks/worleynoise3d/SR_worleynoise3d.outputs:out>

        def Shader "SR_worleynoise3d"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/worleynoise3d/NG_worleynoise3d.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_worleynoise3d"
        {
            color3f outputs:out_base_color.connect = </Looks/worleynoise3d/NG_worleynoise3d/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "pos_scale"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1 = 6
                float inputs:in2 = 6
                float inputs:in3 = 6
                float3 outputs:out
            }

            def Shader "pos_scaled"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/worleynoise3d/NG_worleynoise3d/pos0.outputs:out>
                float3 inputs:in2.connect = </Looks/worleynoise3d/NG_worleynoise3d/pos_scale.outputs:out>
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_worleynoise3d_float"
                float inputs:jitter = 0.7
                float3 inputs:position.connect = </Looks/worleynoise3d/NG_worleynoise3d/pos_scaled.outputs:out>
                int inputs:style = 1
                float outputs:out
            }

            def Shader "noise_01"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/worleynoise3d/NG_worleynoise3d/node_under_test.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_r"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/worleynoise3d/NG_worleynoise3d/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0.1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_g"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/worleynoise3d/NG_worleynoise3d/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_b"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/worleynoise3d/NG_worleynoise3d/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/worleynoise3d/NG_worleynoise3d/tint_r.outputs:out>
                float inputs:in2.connect = </Looks/worleynoise3d/NG_worleynoise3d/tint_g.outputs:out>
                float inputs:in3.connect = </Looks/worleynoise3d/NG_worleynoise3d/tint_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/worleynoise3d>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/worleynoise3d.exr"
        }
    }
}
