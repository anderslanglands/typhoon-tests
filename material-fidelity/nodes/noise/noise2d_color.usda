#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "noise2d_color" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/noise2d_color/noise2d_color.mtlx"
                string sourceMaterial = "M_noise2d_color"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/noise2d_color/SR_noise2d_color.outputs:out>
        token outputs:surface.connect = </Looks/noise2d_color/SR_noise2d_color.outputs:out>

        def Shader "SR_noise2d_color"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/noise2d_color/NG_noise2d_color.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_noise2d_color"
        {
            color3f outputs:out_base_color.connect = </Looks/noise2d_color/NG_noise2d_color/color_01.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector2"
                float2 inputs:in1.connect = </Looks/noise2d_color/NG_noise2d_color/uv0.outputs:out>
                float2 inputs:in2 = (20, 17)
                float2 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_noise2d_color3"
                float3 inputs:amplitude = (1, 0.85, 0.7)
                float inputs:pivot = 0
                float2 inputs:texcoord.connect = </Looks/noise2d_color/NG_noise2d_color/coords_under_test.outputs:out>
                color3f outputs:out
            }

            def Shader "color_01"
            {
                uniform token info:id = "ND_range_color3"
                bool inputs:doclamp = 1
                color3f inputs:in.connect = </Looks/noise2d_color/NG_noise2d_color/node_under_test.outputs:out>
                color3f inputs:inhigh = (1, 1, 1)
                color3f inputs:inlow = (-1, -1, -1)
                color3f inputs:outhigh = (1, 1, 1)
                color3f inputs:outlow = (0, 0, 0)
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/noise2d_color>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/noise2d_color.exr"
        }
    }
}
