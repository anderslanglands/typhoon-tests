#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_fractal3d_color4 with its MaterialX default inputs: amplitude, octaves, lacunarity, diminish, and position defaulting to object-space P. fractal3d should render a non-uniform 2D slice through a zero-centered 3D fractal noise field using the default octave stack rather than a flat color. The signed color4 output is clamped and remapped from [-1, 1] to [0, 1] per channel for display, then packed into RGB as (r, g, b + a); the packed blue channel may saturate where both source channels are high. This is a visual coverage fixture for the typed NodeDef variant, so the important result is visible procedural variation in the packed RGB channels."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal3d_color4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal3d/fractal3d_color4.mtlx"
                string sourceMaterial = "M_fractal3d_color4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal3d_color4/surface.outputs:out>
        token outputs:surface.connect = </Looks/fractal3d_color4/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_fractal3d_color4"
            color4f outputs:out
        }
        def Shader "display_remap"
        {
            uniform token info:id = "ND_range_color4"
            bool inputs:doclamp = 1
            color4f inputs:in.connect = </Looks/fractal3d_color4/node_under_test.outputs:out>
            color4f inputs:inlow = (-1, -1, -1, -1)
            color4f inputs:inhigh = (1, 1, 1, 1)
            color4f inputs:outlow = (0, 0, 0, 0)
            color4f inputs:outhigh = (1, 1, 1, 1)
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/fractal3d_color4/display_remap.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/fractal3d_color4/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/fractal3d_color4/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/fractal3d_color4/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/fractal3d_color4/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/fractal3d_color4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/fractal3d_color4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/fractal3d_color4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal3d_color4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal3d_color4.exr"
        }
    }
}
