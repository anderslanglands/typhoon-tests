#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "cellnoise3d_large_coords" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/cellnoise3d_large_coords/cellnoise3d_large_coords.mtlx"
                string sourceMaterial = "M_cellnoise3d_large_coords"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/cellnoise3d_large_coords/surface.outputs:out>
        token outputs:surface.connect = </Looks/cellnoise3d_large_coords/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/cellnoise3d_large_coords/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_cellnoise3d_large_coords"
        {
            color3f outputs:out_base_color.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/base_color.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "pos_local"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/pos0.outputs:out>
                float3 inputs:in2 = (3, 4, 5)
                float3 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_add_vector3"
                float3 inputs:in1.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/pos_local.outputs:out>
                float3 inputs:in2 = (100000.125, -100000.375, 65536.625)
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_cellnoise3d_float"
                float3 inputs:position.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/coords_under_test.outputs:out>
                float outputs:out
            }

            def Shader "noise_01"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/node_under_test.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = -1
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_r"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0.59
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_g"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 0
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "tint_b"
            {
                uniform token info:id = "ND_range_float"
                bool inputs:doclamp = 1
                float inputs:in.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/noise_01.outputs:out>
                float inputs:inhigh = 1
                float inputs:inlow = 0
                float inputs:outhigh = 1
                float inputs:outlow = 0
                float outputs:out
            }

            def Shader "base_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/tint_r.outputs:out>
                float inputs:in2.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/tint_g.outputs:out>
                float inputs:in3.connect = </Looks/cellnoise3d_large_coords/NG_cellnoise3d_large_coords/tint_b.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/cellnoise3d_large_coords>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/cellnoise3d_large_coords.exr"
        }
    }
}
