#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal3d_color" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal3d_color/fractal3d_color.mtlx"
                string sourceMaterial = "M_fractal3d_color"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal3d_color/SR_fractal3d_color.outputs:out>
        token outputs:surface.connect = </Looks/fractal3d_color/SR_fractal3d_color.outputs:out>

        def Shader "SR_fractal3d_color"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/fractal3d_color/NG_fractal3d_color.outputs:out_base_color>
            token outputs:out
        }

        def NodeGraph "NG_fractal3d_color"
        {
            color3f outputs:out_base_color.connect = </Looks/fractal3d_color/NG_fractal3d_color/color_01.outputs:out>

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "coords_under_test"
            {
                uniform token info:id = "ND_multiply_vector3"
                float3 inputs:in1.connect = </Looks/fractal3d_color/NG_fractal3d_color/pos0.outputs:out>
                float3 inputs:in2 = (5, 6, 7)
                float3 outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_fractal3d_color3"
                float3 inputs:amplitude = (0.9, 0.75, 0.6)
                float inputs:diminish = 0.55
                float inputs:lacunarity = 2.25
                int inputs:octaves = 5
                float3 inputs:position.connect = </Looks/fractal3d_color/NG_fractal3d_color/coords_under_test.outputs:out>
                color3f outputs:out
            }

            def Shader "color_01"
            {
                uniform token info:id = "ND_range_color3"
                bool inputs:doclamp = 1
                color3f inputs:in.connect = </Looks/fractal3d_color/NG_fractal3d_color/node_under_test.outputs:out>
                color3f inputs:inhigh = (1, 1, 1)
                color3f inputs:inlow = (-1, -1, -1)
                color3f inputs:outhigh = (1, 1, 1)
                color3f inputs:outlow = (0, 0, 0)
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal3d_color>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal3d_color.exr"
        }
    }
}
