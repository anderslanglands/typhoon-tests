#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_fractal3d_vector3 with its MaterialX default inputs: amplitude, octaves, lacunarity, diminish, and position defaulting to object-space P. fractal3d should render a non-uniform 2D slice through a zero-centered 3D fractal noise field using the default octave stack rather than a flat color. The signed vector3 output is clamped and remapped from [-1, 1] to [0, 1] per component for display, then converted to color3. This is a visual coverage fixture for the typed NodeDef variant, so the important result is visible procedural variation in the packed RGB channels."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "fractal3d_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/fractal3d/fractal3d_vector3.mtlx"
                string sourceMaterial = "M_fractal3d_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/fractal3d_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/fractal3d_vector3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_fractal3d_vector3"
            float3 outputs:out
        }
        def Shader "display_remap"
        {
            uniform token info:id = "ND_range_vector3"
            bool inputs:doclamp = 1
            float3 inputs:in.connect = </Looks/fractal3d_vector3/node_under_test.outputs:out>
            float3 inputs:inlow = (-1, -1, -1)
            float3 inputs:inhigh = (1, 1, 1)
            float3 inputs:outlow = (0, 0, 0)
            float3 inputs:outhigh = (1, 1, 1)
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/fractal3d_vector3/display_remap.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/fractal3d_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/fractal3d_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/fractal3d_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/fractal3d_vector3.exr"
        }
    }
}
