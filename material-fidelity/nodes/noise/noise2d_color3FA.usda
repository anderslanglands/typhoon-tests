#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_noise2d_color3FA on the plane with UV0 scaled by (18, 13), scalar float amplitude 0.75, and pivot 0. noise2d should render a non-uniform zero-centered 2D Perlin noise pattern rather than a flat color. The signed color3 output is clamped and remapped from [-1, 1] to [0, 1] for display, then connected to uniform_edf.color. This is a visual coverage fixture for the typed NodeDef variant, so the important result is visible procedural variation in the packed RGB channels."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "noise2d_color3FA" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/noise2d/noise2d_color3FA.mtlx"
                string sourceMaterial = "M_noise2d_color3FA"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/noise2d_color3FA/surface.outputs:out>
        token outputs:surface.connect = </Looks/noise2d_color3FA/surface.outputs:out>

        def Shader "base_coord"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "coords_under_test"
        {
            uniform token info:id = "ND_multiply_vector2"
            float2 inputs:in1.connect = </Looks/noise2d_color3FA/base_coord.outputs:out>
            float2 inputs:in2 = (18, 13)
            float2 outputs:out
        }
        def Shader "node_under_test"
        {
            uniform token info:id = "ND_noise2d_color3FA"
            float inputs:amplitude = 0.75
            float inputs:pivot = 0
            float2 inputs:texcoord.connect = </Looks/noise2d_color3FA/coords_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "display_remap"
        {
            uniform token info:id = "ND_range_color3"
            bool inputs:doclamp = 1
            color3f inputs:in.connect = </Looks/noise2d_color3FA/node_under_test.outputs:out>
            color3f inputs:inlow = (-1, -1, -1)
            color3f inputs:inhigh = (1, 1, 1)
            color3f inputs:outlow = (0, 0, 0)
            color3f inputs:outhigh = (1, 1, 1)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/noise2d_color3FA/display_remap.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/noise2d_color3FA/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/noise2d_color3FA>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/noise/noise2d_color3FA.exr"
        }
    }
}
