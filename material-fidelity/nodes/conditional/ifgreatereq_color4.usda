#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifgreatereq_color4 with value1 = 0.25, value2 = 0.75, in1 = (0.2, 0.3, 0.1, 0.4), and in2 = (0.1, 0.4, 0.2, 0.3). 0.25 < 0.75, so the greater-or-equal comparison is false and the node selects in2, so the node result is (0.1, 0.4, 0.2, 0.3). The color4 result is packed into RGB as (r, g, b + a), so the expected emitted RGB is (0.1, 0.4, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifgreatereq_color4" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifgreatereq/ifgreatereq_color4.mtlx"
                string sourceMaterial = "M_ifgreatereq_color4"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifgreatereq_color4/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifgreatereq_color4/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifgreatereq_color4"
            float inputs:value1 = 0.25
            float inputs:value2 = 0.75
            color4f inputs:in1 = (0.2, 0.3, 0.1, 0.4)
            color4f inputs:in2 = (0.1, 0.4, 0.2, 0.3)
            color4f outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_color4"
            color4f inputs:in.connect = </Looks/ifgreatereq_color4/node_under_test.outputs:out>
            float outputs:outr
            float outputs:outg
            float outputs:outb
            float outputs:outa
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/ifgreatereq_color4/display_channels.outputs:outb>
            float inputs:in2.connect = </Looks/ifgreatereq_color4/display_channels.outputs:outa>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/ifgreatereq_color4/display_channels.outputs:outr>
            float inputs:in2.connect = </Looks/ifgreatereq_color4/display_channels.outputs:outg>
            float inputs:in3.connect = </Looks/ifgreatereq_color4/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifgreatereq_color4/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifgreatereq_color4/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifgreatereq_color4>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifgreatereq_color4.exr"
        }
    }
}
