#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifequal_vector4B with value1 = true, value2 = true, in1 = (0.2, 0.3, 0.1, 0.4), and in2 = (0.1, 0.4, 0.2, 0.3). true == true, so the comparison is true and the node selects in1, so the node result is (0.2, 0.3, 0.1, 0.4). The vector4 result is packed into RGB as (x, y, z + w), so the expected emitted RGB is (0.2, 0.3, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifequal_vector4B" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifequal/ifequal_vector4B.mtlx"
                string sourceMaterial = "M_ifequal_vector4B"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifequal_vector4B/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifequal_vector4B/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifequal_vector4B"
            bool inputs:value1 = true
            bool inputs:value2 = true
            float4 inputs:in1 = (0.2, 0.3, 0.1, 0.4)
            float4 inputs:in2 = (0.1, 0.4, 0.2, 0.3)
            float4 outputs:out
        }
        def Shader "display_channels"
        {
            uniform token info:id = "ND_separate4_vector4"
            float4 inputs:in.connect = </Looks/ifequal_vector4B/node_under_test.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
            float outputs:outw
        }
        def Shader "display_blue"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/ifequal_vector4B/display_channels.outputs:outz>
            float inputs:in2.connect = </Looks/ifequal_vector4B/display_channels.outputs:outw>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/ifequal_vector4B/display_channels.outputs:outx>
            float inputs:in2.connect = </Looks/ifequal_vector4B/display_channels.outputs:outy>
            float inputs:in3.connect = </Looks/ifequal_vector4B/display_blue.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifequal_vector4B/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifequal_vector4B/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifequal_vector4B>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifequal_vector4B.exr"
        }
    }
}
