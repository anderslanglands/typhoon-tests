#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifequal_vector3 with value1 = 0.5, value2 = 0.5, in1 = (0.2, 0.3, 0.4), and in2 = (0.6, 0.1, 0.5). 0.5 == 0.5, so the comparison is true and the node selects in1, so the node result is (0.2, 0.3, 0.4). The vector3 result is converted to color3, so the expected emitted RGB is (0.2, 0.3, 0.4)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifequal_vector3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifequal/ifequal_vector3.mtlx"
                string sourceMaterial = "M_ifequal_vector3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifequal_vector3/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifequal_vector3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifequal_vector3"
            float inputs:value1 = 0.5
            float inputs:value2 = 0.5
            float3 inputs:in1 = (0.2, 0.3, 0.4)
            float3 inputs:in2 = (0.6, 0.1, 0.5)
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/ifequal_vector3/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifequal_vector3/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifequal_vector3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifequal_vector3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifequal_vector3.exr"
        }
    }
}
