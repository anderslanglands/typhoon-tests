#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "switch" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/switch/switch.mtlx"
                string sourceMaterial = "M_switch"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/switch/SR_switch.outputs:out>
        token outputs:surface.connect = </Looks/switch/SR_switch.outputs:out>

        def Shader "SR_switch"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/switch/NG_switch.outputs:out_base_color>
            float inputs:specular = 0.5
            float inputs:specular_roughness = 0.45
            token outputs:out
        }

        def NodeGraph "NG_switch"
        {
            color3f outputs:out_base_color.connect = </Looks/switch/NG_switch/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/switch/NG_switch/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/switch/NG_switch/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/switch/NG_switch/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/switch/NG_switch/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "switch_index"
            {
                uniform token info:id = "ND_ifgreater_integer"
                int inputs:in1 = 3
                int inputs:in2 = 1
                float inputs:value1.connect = </Looks/switch/NG_switch/uv_mix.outputs:out>
                float inputs:value2 = 0.5
                int outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_switch_color3"
                color3f inputs:in1 = (0.95, 0.2, 0.2)
                color3f inputs:in2 = (0.2, 0.95, 0.2)
                color3f inputs:in3 = (0.2, 0.2, 0.95)
                color3f inputs:in4 = (0.95, 0.95, 0.2)
                color3f inputs:in5 = (0.95, 0.2, 0.95)
                float inputs:which.connect = </Looks/switch/NG_switch/convert_1.outputs:out>
                color3f outputs:out
            }

            def Shader "convert_1"
            {
                uniform token info:id = "ND_convert_integer_float"
                int inputs:in.connect = </Looks/switch/NG_switch/switch_index.outputs:out>
                float outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/switch>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/switch.exr"
        }
    }
}
