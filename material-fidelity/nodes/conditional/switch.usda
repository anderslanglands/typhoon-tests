#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_switch_color3 on the plane using explicit UV0 texcoords. The graph computes float selector clamp(floor(U * 10), 0, 9) + 0.5, partitioning U into ten vertical sections; those sections select switch inputs in1 through in10 across the plane. The color3 output is connected directly to uniform_edf.color. The expected emitted RGB stripes from left to right are (0.9000, 0.1000, 0.1000), (0.1000, 0.7500, 0.1500), (0.1000, 0.2000, 0.9000), (0.8500, 0.7000, 0.1000), (0.7500, 0.1500, 0.8500), (0.1000, 0.7500, 0.8000), (0.5500, 0.3500, 0.1500), (0.3500, 0.5500, 0.9000), (0.7500, 0.4500, 0.4500), (0.2500, 0.8500, 0.4500)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "switch" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/switch/switch.mtlx"
                string sourceMaterial = "M_switch"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/switch/surface.outputs:out>
        token outputs:surface.connect = </Looks/switch/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "uv_split"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/switch/uv0.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "u_scaled"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/switch/uv_split.outputs:outx>
            float inputs:in2 = 10
            float outputs:out
        }
        def Shader "section_raw"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Looks/switch/u_scaled.outputs:out>
            float outputs:out
        }
        def Shader "section_index"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Looks/switch/section_raw.outputs:out>
            float inputs:low = 0
            float inputs:high = 9
            float outputs:out
        }
        def Shader "selector_float"
        {
            uniform token info:id = "ND_add_float"
            float inputs:in1.connect = </Looks/switch/section_index.outputs:out>
            float inputs:in2 = 0.5
            float outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_switch_color3"
            color3f inputs:in1 = (0.9000, 0.1000, 0.1000)
            color3f inputs:in2 = (0.1000, 0.7500, 0.1500)
            color3f inputs:in3 = (0.1000, 0.2000, 0.9000)
            color3f inputs:in4 = (0.8500, 0.7000, 0.1000)
            color3f inputs:in5 = (0.7500, 0.1500, 0.8500)
            color3f inputs:in6 = (0.1000, 0.7500, 0.8000)
            color3f inputs:in7 = (0.5500, 0.3500, 0.1500)
            color3f inputs:in8 = (0.3500, 0.5500, 0.9000)
            color3f inputs:in9 = (0.7500, 0.4500, 0.4500)
            color3f inputs:in10 = (0.2500, 0.8500, 0.4500)
            float inputs:which.connect = </Looks/switch/selector_float.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/switch/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/switch/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/switch>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/switch.exr"
        }
    }
}
