#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifgreater_float with value1 = 0.75, value2 = 0.25, in1 = 0.25, and in2 = 0.75. 0.75 > 0.25, so the greater-than comparison is true and the node selects in1, so the node result is 0.25. The scalar result is packed into RGB as (value, 0, 0), so the expected emitted RGB is (0.25, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifgreater_float" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifgreater/ifgreater_float.mtlx"
                string sourceMaterial = "M_ifgreater_float"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifgreater_float/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifgreater_float/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifgreater_float"
            float inputs:value1 = 0.75
            float inputs:value2 = 0.25
            float inputs:in1 = 0.25
            float inputs:in2 = 0.75
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/ifgreater_float/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifgreater_float/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifgreater_float/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifgreater_float>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifgreater_float.exr"
        }
    }
}
