#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifequal_color3 with value1 = 0.5, value2 = 0.5, in1 = (0.2, 0.4, 0.6), and in2 = (0.7, 0.1, 0.3). 0.5 == 0.5, so the comparison is true and the node selects in1, so the node result is (0.2, 0.4, 0.6). The color3 result is connected directly to uniform_edf.color, so the expected emitted RGB is (0.2, 0.4, 0.6)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifequal_color3" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifequal/ifequal_color3.mtlx"
                string sourceMaterial = "M_ifequal_color3"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifequal_color3/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifequal_color3/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifequal_color3"
            float inputs:value1 = 0.5
            float inputs:value2 = 0.5
            color3f inputs:in1 = (0.2, 0.4, 0.6)
            color3f inputs:in2 = (0.7, 0.1, 0.3)
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifequal_color3/node_under_test.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifequal_color3/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifequal_color3>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifequal_color3.exr"
        }
    }
}
