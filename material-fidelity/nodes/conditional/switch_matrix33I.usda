#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_switch_matrix33I on the plane using explicit UV0 texcoords. The graph computes integer selector clamp(floor(U * 10), 0, 9), partitioning U into ten vertical sections; those sections select switch inputs in1 through in10 across the plane. The matrix33 output rows are added component-wise and converted to color3 for display. The expected emitted RGB stripes from left to right are (0.9000, 0.1000, 0.1000), (0.1000, 0.7500, 0.1500), (0.1000, 0.2000, 0.9000), (0.8500, 0.7000, 0.1000), (0.7500, 0.1500, 0.8500), (0.1000, 0.7500, 0.8000), (0.5500, 0.3500, 0.1500), (0.3500, 0.5500, 0.9000), (0.7500, 0.4500, 0.4500), (0.2500, 0.8500, 0.4500)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "switch_matrix33I" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/switch/switch_matrix33I.mtlx"
                string sourceMaterial = "M_switch_matrix33I"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/switch_matrix33I/surface.outputs:out>
        token outputs:surface.connect = </Looks/switch_matrix33I/surface.outputs:out>

        def Shader "uv0"
        {
            uniform token info:id = "ND_texcoord_vector2"
            float2 outputs:out
        }
        def Shader "uv_split"
        {
            uniform token info:id = "ND_separate2_vector2"
            float2 inputs:in.connect = </Looks/switch_matrix33I/uv0.outputs:out>
            float outputs:outx
            float outputs:outy
        }
        def Shader "u_scaled"
        {
            uniform token info:id = "ND_multiply_float"
            float inputs:in1.connect = </Looks/switch_matrix33I/uv_split.outputs:outx>
            float inputs:in2 = 10
            float outputs:out
        }
        def Shader "section_raw"
        {
            uniform token info:id = "ND_floor_float"
            float inputs:in.connect = </Looks/switch_matrix33I/u_scaled.outputs:out>
            float outputs:out
        }
        def Shader "section_index"
        {
            uniform token info:id = "ND_clamp_float"
            float inputs:in.connect = </Looks/switch_matrix33I/section_raw.outputs:out>
            float inputs:low = 0
            float inputs:high = 9
            float outputs:out
        }
        def Shader "section_ge_1"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 1
            int inputs:in1 = 1
            int inputs:in2 = 0
            int outputs:out
        }
        def Shader "section_ge_2"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 2
            int inputs:in1 = 2
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_1.outputs:out>
            int outputs:out
        }
        def Shader "section_ge_3"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 3
            int inputs:in1 = 3
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_2.outputs:out>
            int outputs:out
        }
        def Shader "section_ge_4"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 4
            int inputs:in1 = 4
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_3.outputs:out>
            int outputs:out
        }
        def Shader "section_ge_5"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 5
            int inputs:in1 = 5
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_4.outputs:out>
            int outputs:out
        }
        def Shader "section_ge_6"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 6
            int inputs:in1 = 6
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_5.outputs:out>
            int outputs:out
        }
        def Shader "section_ge_7"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 7
            int inputs:in1 = 7
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_6.outputs:out>
            int outputs:out
        }
        def Shader "section_ge_8"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 8
            int inputs:in1 = 8
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_7.outputs:out>
            int outputs:out
        }
        def Shader "selector_integer"
        {
            uniform token info:id = "ND_ifgreatereq_integer"
            float inputs:value1.connect = </Looks/switch_matrix33I/section_index.outputs:out>
            float inputs:value2 = 9
            int inputs:in1 = 9
            int inputs:in2.connect = </Looks/switch_matrix33I/section_ge_8.outputs:out>
            int outputs:out
        }

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_switch_matrix33I"
            matrix3d inputs:in1 = ( (0.30000000, 0.03333333, 0.03333333), (0.30000000, 0.03333333, 0.03333333), (0.30000000, 0.03333333, 0.03333333) )
            matrix3d inputs:in2 = ( (0.03333333, 0.25000000, 0.05000000), (0.03333333, 0.25000000, 0.05000000), (0.03333333, 0.25000000, 0.05000000) )
            matrix3d inputs:in3 = ( (0.03333333, 0.06666667, 0.30000000), (0.03333333, 0.06666667, 0.30000000), (0.03333333, 0.06666667, 0.30000000) )
            matrix3d inputs:in4 = ( (0.28333333, 0.23333333, 0.03333333), (0.28333333, 0.23333333, 0.03333333), (0.28333333, 0.23333333, 0.03333333) )
            matrix3d inputs:in5 = ( (0.25000000, 0.05000000, 0.28333333), (0.25000000, 0.05000000, 0.28333333), (0.25000000, 0.05000000, 0.28333333) )
            matrix3d inputs:in6 = ( (0.03333333, 0.25000000, 0.26666667), (0.03333333, 0.25000000, 0.26666667), (0.03333333, 0.25000000, 0.26666667) )
            matrix3d inputs:in7 = ( (0.18333333, 0.11666667, 0.05000000), (0.18333333, 0.11666667, 0.05000000), (0.18333333, 0.11666667, 0.05000000) )
            matrix3d inputs:in8 = ( (0.11666667, 0.18333333, 0.30000000), (0.11666667, 0.18333333, 0.30000000), (0.11666667, 0.18333333, 0.30000000) )
            matrix3d inputs:in9 = ( (0.25000000, 0.15000000, 0.15000000), (0.25000000, 0.15000000, 0.15000000), (0.25000000, 0.15000000, 0.15000000) )
            matrix3d inputs:in10 = ( (0.08333333, 0.28333333, 0.15000000), (0.08333333, 0.28333333, 0.15000000), (0.08333333, 0.28333333, 0.15000000) )
            int inputs:which.connect = </Looks/switch_matrix33I/selector_integer.outputs:out>
            matrix3d outputs:out
        }

        def Shader "display_row0"
        {
            uniform token info:id = "ND_extract_matrix33"
            matrix3d inputs:in.connect = </Looks/switch_matrix33I/node_under_test.outputs:out>
            int inputs:index = 0
            float3 outputs:out
        }
        def Shader "display_row1"
        {
            uniform token info:id = "ND_extract_matrix33"
            matrix3d inputs:in.connect = </Looks/switch_matrix33I/node_under_test.outputs:out>
            int inputs:index = 1
            float3 outputs:out
        }
        def Shader "display_row2"
        {
            uniform token info:id = "ND_extract_matrix33"
            matrix3d inputs:in.connect = </Looks/switch_matrix33I/node_under_test.outputs:out>
            int inputs:index = 2
            float3 outputs:out
        }
        def Shader "display_row01"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Looks/switch_matrix33I/display_row0.outputs:out>
            float3 inputs:in2.connect = </Looks/switch_matrix33I/display_row1.outputs:out>
            float3 outputs:out
        }
        def Shader "display_packed"
        {
            uniform token info:id = "ND_add_vector3"
            float3 inputs:in1.connect = </Looks/switch_matrix33I/display_row01.outputs:out>
            float3 inputs:in2.connect = </Looks/switch_matrix33I/display_row2.outputs:out>
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/switch_matrix33I/display_packed.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/switch_matrix33I/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/switch_matrix33I/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/switch_matrix33I>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/switch_matrix33I.exr"
        }
    }
}
