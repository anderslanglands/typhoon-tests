#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifequal_booleanB with value1 = true and value2 = true. true == true, so the node result is true. The boolean result is converted to color3, so the expected emitted RGB is (1, 1, 1)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifequal_booleanB" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifequal/ifequal_booleanB.mtlx"
                string sourceMaterial = "M_ifequal_booleanB"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifequal_booleanB/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifequal_booleanB/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifequal_booleanB"
            bool inputs:value1 = true
            bool inputs:value2 = true
            bool outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_boolean_color3"
            bool inputs:in.connect = </Looks/ifequal_booleanB/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifequal_booleanB/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifequal_booleanB/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifequal_booleanB>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifequal_booleanB.exr"
        }
    }
}
