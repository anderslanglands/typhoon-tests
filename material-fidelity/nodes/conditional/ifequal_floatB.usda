#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifequal_floatB with value1 = true, value2 = true, in1 = 0.25, and in2 = 0.75. true == true, so the comparison is true and the node selects in1, so the node result is 0.25. The scalar result is packed into RGB as (value, 0, 0), so the expected emitted RGB is (0.25, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifequal_floatB" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifequal/ifequal_floatB.mtlx"
                string sourceMaterial = "M_ifequal_floatB"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifequal_floatB/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifequal_floatB/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifequal_floatB"
            bool inputs:value1 = true
            bool inputs:value2 = true
            float inputs:in1 = 0.25
            float inputs:in2 = 0.75
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/ifequal_floatB/node_under_test.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifequal_floatB/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifequal_floatB/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifequal_floatB>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifequal_floatB.exr"
        }
    }
}
