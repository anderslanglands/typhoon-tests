#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "switch_integer_zero_based" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/switch_integer_zero_based/switch_integer_zero_based.mtlx"
                string sourceMaterial = "M_switch_integer_zero_based"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/switch_integer_zero_based/surface.outputs:out>
        token outputs:surface.connect = </Looks/switch_integer_zero_based/surface.outputs:out>

        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based.outputs:out_base_color>
            token outputs:out
        }

        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/switch_integer_zero_based/uniform_edf.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_switch_integer_zero_based"
        {
            color3f outputs:out_base_color.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "switch_index"
            {
                uniform token info:id = "ND_ifgreater_integer"
                int inputs:in1 = 4
                int inputs:in2 = 0
                float inputs:value1.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/uv_mix.outputs:out>
                float inputs:value2 = 0.5
                int outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_switch_color3I"
                color3f inputs:in1 = (0.95, 0.2, 0.2)
                color3f inputs:in2 = (0.2, 0.95, 0.2)
                color3f inputs:in3 = (0.2, 0.2, 0.95)
                color3f inputs:in4 = (0.95, 0.95, 0.2)
                color3f inputs:in5 = (0.95, 0.2, 0.95)
                int inputs:which.connect = </Looks/switch_integer_zero_based/NG_switch_integer_zero_based/switch_index.outputs:out>
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/switch_integer_zero_based>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/switch_integer_zero_based.exr"
        }
    }
}
