#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifgreatereq_booleanI with value1 = 2 and value2 = 2. 2 >= 2, so the node result is true. The boolean result is converted to color3, so the expected emitted RGB is (1, 1, 1)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifgreatereq_booleanI" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifgreatereq/ifgreatereq_booleanI.mtlx"
                string sourceMaterial = "M_ifgreatereq_booleanI"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifgreatereq_booleanI/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifgreatereq_booleanI/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifgreatereq_booleanI"
            int inputs:value1 = 2
            int inputs:value2 = 2
            bool outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_boolean_color3"
            bool inputs:in.connect = </Looks/ifgreatereq_booleanI/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifgreatereq_booleanI/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifgreatereq_booleanI/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifgreatereq_booleanI>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifgreatereq_booleanI.exr"
        }
    }
}
