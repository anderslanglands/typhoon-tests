#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifgreater_vector3I with value1 = 2, value2 = 2, in1 = (0.2, 0.3, 0.4), and in2 = (0.6, 0.1, 0.5). 2 is not greater than 2, so the greater-than comparison is false and the node selects in2, so the node result is (0.6, 0.1, 0.5). The vector3 result is converted to color3, so the expected emitted RGB is (0.6, 0.1, 0.5)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifgreater_vector3I" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifgreater/ifgreater_vector3I.mtlx"
                string sourceMaterial = "M_ifgreater_vector3I"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifgreater_vector3I/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifgreater_vector3I/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifgreater_vector3I"
            int inputs:value1 = 2
            int inputs:value2 = 2
            float3 inputs:in1 = (0.2, 0.3, 0.4)
            float3 inputs:in2 = (0.6, 0.1, 0.5)
            float3 outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_convert_vector3_color3"
            float3 inputs:in.connect = </Looks/ifgreater_vector3I/node_under_test.outputs:out>
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifgreater_vector3I/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifgreater_vector3I/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifgreater_vector3I>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifgreater_vector3I.exr"
        }
    }
}
