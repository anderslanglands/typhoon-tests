#usda 1.0
(
    customLayerData = {
        string doc = "Tests ND_ifequal_integerI with value1 = 1, value2 = 2, in1 = 0, and in2 = 1. 1 != 2, so the comparison is false and the node selects in2, so the node result is 1. The integer result is converted to float and packed into RGB as (value, 0, 0), so the expected emitted RGB is (1, 0, 0)."
    }
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/plane.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ifequal_integerI" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/nodes/ifequal/ifequal_integerI.mtlx"
                string sourceMaterial = "M_ifequal_integerI"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ifequal_integerI/surface.outputs:out>
        token outputs:surface.connect = </Looks/ifequal_integerI/surface.outputs:out>

        def Shader "node_under_test"
        {
            uniform token info:id = "ND_ifequal_integerI"
            int inputs:value1 = 1
            int inputs:value2 = 2
            int inputs:in1 = 0
            int inputs:in2 = 1
            int outputs:out
        }
        def Shader "display_float"
        {
            uniform token info:id = "ND_convert_integer_float"
            int inputs:in.connect = </Looks/ifequal_integerI/node_under_test.outputs:out>
            float outputs:out
        }
        def Shader "display_color"
        {
            uniform token info:id = "ND_combine3_color3"
            float inputs:in1.connect = </Looks/ifequal_integerI/display_float.outputs:out>
            float inputs:in2 = 0
            float inputs:in3 = 0
            color3f outputs:out
        }
        def Shader "uniform_edf"
        {
            uniform token info:id = "ND_uniform_edf"
            color3f inputs:color.connect = </Looks/ifequal_integerI/display_color.outputs:out>
            token outputs:out
        }
        def Shader "surface"
        {
            uniform token info:id = "ND_surface"
            token inputs:edf.connect = </Looks/ifequal_integerI/uniform_edf.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ifequal_integerI>
    }
}

over "Render"
{
    over "Settings"
    {
        uniform int ty:convergedSamplesPerPixel = 4

        over "Product"
        {
            token productName = "material-fidelity/nodes/conditional/ifequal_integerI.exr"
        }
    }
}
