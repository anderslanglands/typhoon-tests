#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_iridescence" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/feature_iridescence/feature_iridescence.mtlx"
                string sourceMaterial = "M_feature_iridescence"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_iridescence/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_iridescence/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.12, 0.12, 0.12)
            float inputs:iridescence = 1
            float inputs:iridescence_thickness = 400
            float inputs:roughness = 0.15
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_iridescence>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/feature_iridescence.exr"
        }
    }
}
