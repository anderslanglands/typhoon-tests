#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "coat_color_variation" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/coat_color_variation/coat_color_variation.mtlx"
                string sourceMaterial = "CoatColorVariation"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/coat_color_variation/SR_coat_color_variation.outputs:out>
        token outputs:surface.connect = </Looks/coat_color_variation/SR_coat_color_variation.outputs:out>

        def Shader "SR_coat_color_variation"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha = 1
            float inputs:alpha_cutoff = 0.5
            int inputs:alpha_mode = 0
            color3f inputs:base_color = (0.8, 0.8, 0.8)
            float inputs:clearcoat = 1
            float inputs:clearcoat_roughness = 0.05
            float inputs:ior = 1.5
            float inputs:metallic = 0
            float inputs:occlusion = 1
            float inputs:roughness = 0.25
            float inputs:specular = 1
            color3f inputs:specular_color = (0.2, 0.35, 0.9)
            float inputs:transmission = 0
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/coat_color_variation>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/coat_color_variation.exr"
        }
    }
}
