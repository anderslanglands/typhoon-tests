#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "alpha_mode_mask" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/alpha_mode_mask/alpha_mode_mask.mtlx"
                string sourceMaterial = "M_gltf_alpha_mode_mask"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/alpha_mode_mask/SR_gltf_alpha_mode_mask.outputs:out>
        token outputs:surface.connect = </Looks/alpha_mode_mask/SR_gltf_alpha_mode_mask.outputs:out>

        def Shader "SR_gltf_alpha_mode_mask"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha.connect = </Looks/alpha_mode_mask/NG_gltf_alpha_mode_mask.outputs:out_alpha>
            float inputs:alpha_cutoff = 0.5
            int inputs:alpha_mode = 1
            color3f inputs:base_color = (0.2, 0.9, 0.2)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            token outputs:out
        }

        def NodeGraph "NG_gltf_alpha_mode_mask"
        {
            float outputs:out_alpha.connect = </Looks/alpha_mode_mask/NG_gltf_alpha_mode_mask/alpha_u.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "alpha_u"
            {
                uniform token info:id = "ND_extract_vector2"
                float2 inputs:in.connect = </Looks/alpha_mode_mask/NG_gltf_alpha_mode_mask/uv0.outputs:out>
                int inputs:index = 0
                float outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/alpha_mode_mask>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/alpha_mode_mask.exr"
        }
    }
}
