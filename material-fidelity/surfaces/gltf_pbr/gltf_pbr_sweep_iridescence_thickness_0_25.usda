#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "gltf_pbr_sweep_iridescence_thickness_0_25" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/gltf_pbr_sweep_iridescence_thickness_0_25/gltf_pbr_sweep_iridescence_thickness_0_25.mtlx"
                string sourceMaterial = "gltf_pbr_sweep_iridescence_thickness_0_25"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/gltf_pbr_sweep_iridescence_thickness_0_25/SR_gltf_pbr_sweep_iridescence_thickness_0_25.outputs:out>
        token outputs:surface.connect = </Looks/gltf_pbr_sweep_iridescence_thickness_0_25/SR_gltf_pbr_sweep_iridescence_thickness_0_25.outputs:out>

        def Shader "SR_gltf_pbr_sweep_iridescence_thickness_0_25"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha = 1
            int inputs:alpha_mode = 2
            color3f inputs:base_color = (0.02, 0.02, 0.02)
            float inputs:clearcoat = 0
            float inputs:clearcoat_roughness = 0.2
            float inputs:iridescence = 1
            float inputs:iridescence_ior = 1.3
            float inputs:iridescence_thickness = 100
            float inputs:metallic = 0
            float inputs:roughness = 0.2
            color3f inputs:sheen_color = (0, 0, 0)
            float inputs:sheen_roughness = 0
            float inputs:transmission = 0
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/gltf_pbr_sweep_iridescence_thickness_0_25>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/gltf_pbr_sweep_iridescence_thickness_0_25.exr"
        }
    }
}
