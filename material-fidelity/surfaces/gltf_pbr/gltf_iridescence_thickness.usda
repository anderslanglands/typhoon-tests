#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "gltf_iridescence_thickness" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/gltf_iridescence_thickness/gltf_iridescence_thickness.mtlx"
                string sourceMaterial = "M_gltf_iridescence_thickness"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/gltf_iridescence_thickness/SR_gltf_iridescence_thickness.outputs:out>
        token outputs:surface.connect = </Looks/gltf_iridescence_thickness/SR_gltf_iridescence_thickness.outputs:out>

        def Shader "SR_gltf_iridescence_thickness"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.14, 0.16, 0.18)
            float inputs:ior = 1.5
            float inputs:iridescence = 1
            float inputs:iridescence_ior = 1.33
            float inputs:iridescence_thickness.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness.outputs:out_iridescence_thickness>
            float inputs:metallic = 0
            float inputs:roughness = 0.08
            float inputs:specular = 1
            token outputs:out
        }

        def NodeGraph "NG_gltf_iridescence_thickness"
        {
            float outputs:out_iridescence_thickness.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/node_under_test.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "pos0"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "uv_sum"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mul"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float outputs:out
            }

            def Shader "uv_mix"
            {
                uniform token info:id = "ND_fract_float"
                float inputs:in.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_sum.outputs:out>
                float outputs:out
            }

            def Shader "uv_times4"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float inputs:in2 = 4
                float outputs:out
            }

            def Shader "uv_i_float"
            {
                uniform token info:id = "ND_floor_float"
                float inputs:in.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_times4.outputs:out>
                float outputs:out
            }

            def Shader "uv_i"
            {
                uniform token info:id = "ND_constant_integer"
                int inputs:value = 0
                int outputs:out
            }

            def Shader "uv_bool"
            {
                uniform token info:id = "ND_ifgreater_boolean"
                float inputs:value1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float inputs:value2 = 0.5
                bool outputs:out
            }

            def Shader "uv_scale"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1 = 1
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "uv_offset"
            {
                uniform token info:id = "ND_combine2_vector2"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mul.outputs:out>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float2 outputs:out
            }

            def Shader "uv_vec3"
            {
                uniform token info:id = "ND_combine3_vector3"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float3 outputs:out
            }

            def Shader "uv_normal"
            {
                uniform token info:id = "ND_normalize_vector3"
                float3 inputs:in.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_vec3.outputs:out>
                float3 outputs:out
            }

            def Shader "uv_vec4"
            {
                uniform token info:id = "ND_combine4_vector4"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float inputs:in4 = 1
                float4 outputs:out
            }

            def Shader "uv_color4"
            {
                uniform token info:id = "ND_combine4_color4"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float inputs:in4 = 1
                color4f outputs:out
            }

            def Shader "uv_color"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float inputs:in3.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                color3f outputs:out
            }

            def Shader "uv_color_hot"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.95
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outx>
                float inputs:in3 = 0.2
                color3f outputs:out
            }

            def Shader "uv_color_cool"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1 = 0.1
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_split.outputs:outy>
                float inputs:in3 = 0.8
                color3f outputs:out
            }

            def Shader "temp_driver"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 2500
                float inputs:in2 = 4000
                float outputs:out
            }

            def Shader "ior_driver"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 1.1
                float inputs:in2.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mul.outputs:out>
                float outputs:out
            }

            def Shader "uv_rotate"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_mix.outputs:out>
                float inputs:in2 = 0.785398
                float outputs:out
            }

            def Shader "node_under_test"
            {
                uniform token info:id = "ND_gltf_iridescence_thickness_float_1_0"
                float3 inputs:default.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_vec3.outputs:out>
                asset inputs:file = @../../_assets/Materials/surfaces/gltf_pbr/gltf_iridescence_thickness/textures/grid.png@
                string inputs:filtertype = "linear"
                float2 inputs:offset.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_offset.outputs:out>
                float2 inputs:pivot = (0.5, 0.5)
                float inputs:rotate.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_rotate.outputs:out>
                float2 inputs:scale.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv_scale.outputs:out>
                float2 inputs:texcoord.connect = </Looks/gltf_iridescence_thickness/NG_gltf_iridescence_thickness/uv0.outputs:out>
                float inputs:thicknessMax = 900
                float inputs:thicknessMin = 120
                string inputs:uaddressmode = "periodic"
                string inputs:vaddressmode = "periodic"
                float outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/gltf_iridescence_thickness>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/gltf_iridescence_thickness.exr"
        }
    }
}
