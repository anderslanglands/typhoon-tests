#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "alpha_mode_blend" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/alpha_mode_blend/alpha_mode_blend.mtlx"
                string sourceMaterial = "M_gltf_alpha_mode_blend"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/alpha_mode_blend/SR_gltf_alpha_mode_blend.outputs:out>
        token outputs:surface.connect = </Looks/alpha_mode_blend/SR_gltf_alpha_mode_blend.outputs:out>

        def Shader "SR_gltf_alpha_mode_blend"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha = 0.35
            float inputs:alpha_cutoff = 0.5
            int inputs:alpha_mode = 2
            color3f inputs:base_color = (0.2, 0.2, 0.9)
            float inputs:metallic = 0
            float inputs:roughness = 0.5
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/alpha_mode_blend>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/alpha_mode_blend.exr"
        }
    }
}
