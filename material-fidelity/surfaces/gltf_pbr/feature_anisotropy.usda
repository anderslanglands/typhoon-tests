#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_anisotropy" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/feature_anisotropy/feature_anisotropy.mtlx"
                string sourceMaterial = "M_feature_anisotropy"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_anisotropy/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_anisotropy/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:anisotropy_strength = 1
            color3f inputs:base_color = (0.3, 0.85, 0.8)
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_anisotropy>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/feature_anisotropy.exr"
        }
    }
}
