#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_sheen" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/feature_sheen/feature_sheen.mtlx"
                string sourceMaterial = "M_feature_sheen"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_sheen/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_sheen/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.04, 0.06, 0.02)
            float inputs:metallic = 0
            float inputs:roughness = 0.35
            color3f inputs:sheen_color = (0.9, 0.12, 0.04)
            float inputs:sheen_roughness = 0.5
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_sheen>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/feature_sheen.exr"
        }
    }
}
