#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_normal_space_object" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/feature_normal_space_object/feature_normal_space_object.mtlx"
                string sourceMaterial = "M_feature_normal_space_object"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_normal_space_object/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_normal_space_object/surface_shader1.outputs:out>

        def Shader "surface_normal"
        {
            uniform token info:id = "ND_normal_vector3"
            string inputs:space = "object"
            float3 outputs:out
        }

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.95, 0.35, 0.7)
            float3 inputs:normal.connect = </Looks/feature_normal_space_object/surface_normal.outputs:out>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_normal_space_object>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/feature_normal_space_object.exr"
        }
    }
}
