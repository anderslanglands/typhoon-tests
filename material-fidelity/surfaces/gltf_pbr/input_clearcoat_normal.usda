#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_clearcoat_normal" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/input_clearcoat_normal/input_clearcoat_normal.mtlx"
                string sourceMaterial = "input_clearcoat_normal"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_clearcoat_normal/SR_default.outputs:out>
        token outputs:surface.connect = </Looks/input_clearcoat_normal/SR_default.outputs:out>

        def Shader "SR_default"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.0518895, 0.29606, 0.425324)
            float inputs:clearcoat = 1
            float inputs:clearcoat_roughness = 0.15
            float inputs:metallic = 0
            float inputs:roughness = 0.4
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_clearcoat_normal>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/input_clearcoat_normal.exr"
        }
    }
}
