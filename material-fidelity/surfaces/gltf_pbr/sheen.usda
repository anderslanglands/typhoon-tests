#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sheen" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/sheen/sheen.mtlx"
                string sourceMaterial = "M_gltf_sheen"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sheen/SR_gltf_sheen.outputs:out>
        token outputs:surface.connect = </Looks/sheen/SR_gltf_sheen.outputs:out>

        def Shader "SR_gltf_sheen"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha = 1
            float inputs:alpha_cutoff = 0.5
            int inputs:alpha_mode = 0
            color3f inputs:base_color = (0.2, 0.4, 0.8)
            float inputs:metallic = 0
            float inputs:roughness = 0.8
            color3f inputs:sheen_color = (1, 0.9, 0.7)
            float inputs:sheen_roughness = 0.3
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/sheen>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/sheen.exr"
        }
    }
}
