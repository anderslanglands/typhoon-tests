#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "gltf_anisotropy_image" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/gltf_anisotropy_image/gltf_anisotropy_image.mtlx"
                string sourceMaterial = "M_gltf_anisotropy_image"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/gltf_anisotropy_image/SR_gltf_anisotropy_image.outputs:out>
        token outputs:surface.connect = </Looks/gltf_anisotropy_image/SR_gltf_anisotropy_image.outputs:out>

        def Shader "world_tangent"
        {
            uniform token info:id = "ND_tangent_vector3"
            string inputs:space = "world"
            float3 outputs:out
        }

        def Shader "SR_gltf_anisotropy_image"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:anisotropy_rotation.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image.outputs:out_anisotropy_rotation>
            float inputs:anisotropy_strength.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image.outputs:out_anisotropy_strength>
            color3f inputs:base_color = (0.16, 0.2, 0.26)
            float inputs:metallic = 1
            float inputs:roughness = 0.2
            float inputs:specular = 1
            float3 inputs:tangent.connect = </Looks/gltf_anisotropy_image/world_tangent.outputs:out>
            token outputs:out
        }

        def NodeGraph "NG_gltf_anisotropy_image"
        {
            float outputs:out_anisotropy_rotation.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/anisotropy_rotation_proc.outputs:out>
            float outputs:out_anisotropy_strength.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/anisotropy_strength_proc.outputs:out>

            def Shader "uv0"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "uv_split"
            {
                uniform token info:id = "ND_separate2_vector2"
                float2 inputs:in.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/uv0.outputs:out>
                float outputs:outx
                float outputs:outy
            }

            def Shader "brush_freq_u"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/uv_split.outputs:outx>
                float inputs:in2 = 380
                float outputs:out
            }

            def Shader "brush_wave"
            {
                uniform token info:id = "ND_sin_float"
                float inputs:in.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/brush_freq_u.outputs:out>
                float outputs:out
            }

            def Shader "brush_wave_abs"
            {
                uniform token info:id = "ND_absval_float"
                float inputs:in.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/brush_wave.outputs:out>
                float outputs:out
            }

            def Shader "strength_mod"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/brush_wave_abs.outputs:out>
                float inputs:in2 = 0.22
                float outputs:out
            }

            def Shader "anisotropy_strength_proc"
            {
                uniform token info:id = "ND_subtract_float"
                float inputs:in1 = 0.95
                float inputs:in2.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/strength_mod.outputs:out>
                float outputs:out
            }

            def Shader "rotation_from_v"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/uv_split.outputs:outy>
                float inputs:in2 = 6.283185
                float outputs:out
            }

            def Shader "rotation_brush_mod"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/brush_wave.outputs:out>
                float inputs:in2 = 0.35
                float outputs:out
            }

            def Shader "anisotropy_rotation_proc"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/rotation_from_v.outputs:out>
                float inputs:in2.connect = </Looks/gltf_anisotropy_image/NG_gltf_anisotropy_image/rotation_brush_mod.outputs:out>
                float outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/gltf_anisotropy_image>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/gltf_anisotropy_image.exr"
        }
    }
}
