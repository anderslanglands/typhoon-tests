#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_dispersion" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/feature_dispersion/feature_dispersion.mtlx"
                string sourceMaterial = "M_feature_dispersion"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_dispersion/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_dispersion/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.45, 0.55, 0.95)
            float inputs:dispersion = 1
            float inputs:transmission = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_dispersion>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/feature_dispersion.exr"
        }
    }
}
