#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_emissive" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/input_emissive/input_emissive.mtlx"
                string sourceMaterial = "input_emissive"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_emissive/SR_default.outputs:out>
        token outputs:surface.connect = </Looks/input_emissive/SR_default.outputs:out>

        def Shader "SR_default"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.0518895, 0.29606, 0.425324)
            color3f inputs:emissive.connect = </Looks/input_emissive/NG_emissive_uv.outputs:emissive_out>
            float inputs:emissive_strength.connect = </Looks/input_emissive/NG_emissive_uv.outputs:emissive_strength_out>
            float inputs:metallic = 0
            float inputs:roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_emissive_uv"
        {
            color3f outputs:emissive_out.connect = </Looks/input_emissive/NG_emissive_uv/emissive_color_uv.outputs:out>
            float outputs:emissive_strength_out.connect = </Looks/input_emissive/NG_emissive_uv/emissive_strength_uv.outputs:out>

            def Shader "emissive_uv"
            {
                uniform token info:id = "ND_texcoord_vector2"
                int inputs:index = 0
                float2 outputs:out
            }

            def Shader "emissive_u"
            {
                uniform token info:id = "ND_extract_vector2"
                float2 inputs:in.connect = </Looks/input_emissive/NG_emissive_uv/emissive_uv.outputs:out>
                int inputs:index = 0
                float outputs:out
            }

            def Shader "emissive_v"
            {
                uniform token info:id = "ND_extract_vector2"
                float2 inputs:in.connect = </Looks/input_emissive/NG_emissive_uv/emissive_uv.outputs:out>
                int inputs:index = 1
                float outputs:out
            }

            def Shader "emissive_r"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 0.1
                float inputs:in2.connect = </Looks/input_emissive/NG_emissive_uv/emissive_u.outputs:out>
                float outputs:out
            }

            def Shader "emissive_g"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1 = 0.8
                float inputs:in2.connect = </Looks/input_emissive/NG_emissive_uv/emissive_v.outputs:out>
                float outputs:out
            }

            def Shader "emissive_color_uv"
            {
                uniform token info:id = "ND_combine3_color3"
                float inputs:in1.connect = </Looks/input_emissive/NG_emissive_uv/emissive_r.outputs:out>
                float inputs:in2.connect = </Looks/input_emissive/NG_emissive_uv/emissive_g.outputs:out>
                float inputs:in3 = 1
                color3f outputs:out
            }

            def Shader "emissive_strength_uv"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1 = 0.5
                float inputs:in2.connect = </Looks/input_emissive/NG_emissive_uv/emissive_u.outputs:out>
                float outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_emissive>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/input_emissive.exr"
        }
    }
}
