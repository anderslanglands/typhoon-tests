#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_alpha_mode_opaque" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/input_alpha_mode_opaque/input_alpha_mode_opaque.mtlx"
                string sourceMaterial = "input_alpha_mode_opaque"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_alpha_mode_opaque/SR_default.outputs:out>
        token outputs:surface.connect = </Looks/input_alpha_mode_opaque/SR_default.outputs:out>

        def Shader "SR_default"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque.outputs:out_alpha>
            float inputs:alpha_cutoff = 0.5
            int inputs:alpha_mode = 0
            color3f inputs:base_color = (0.0518895, 0.29606, 0.425324)
            float inputs:metallic = 0
            float inputs:roughness = 0.4
            token outputs:out
        }

        def NodeGraph "NG_input_alpha_mode_opaque"
        {
            float outputs:out_alpha.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque/wave_to_zero_one.outputs:out>

            def Shader "obj_pos"
            {
                uniform token info:id = "ND_position_vector3"
                float3 outputs:out
            }

            def Shader "wave_driver"
            {
                uniform token info:id = "ND_dotproduct_vector3"
                float3 inputs:in1.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque/obj_pos.outputs:out>
                float3 inputs:in2 = (1, 0, 1)
                float outputs:out
            }

            def Shader "wave_scale"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque/wave_driver.outputs:out>
                float inputs:in2 = 7
                float outputs:out
            }

            def Shader "wave"
            {
                uniform token info:id = "ND_sin_float"
                float inputs:in.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque/wave_scale.outputs:out>
                float outputs:out
            }

            def Shader "wave_to_zero_one_scale"
            {
                uniform token info:id = "ND_multiply_float"
                float inputs:in1.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque/wave.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }

            def Shader "wave_to_zero_one"
            {
                uniform token info:id = "ND_add_float"
                float inputs:in1.connect = </Looks/input_alpha_mode_opaque/NG_input_alpha_mode_opaque/wave_to_zero_one_scale.outputs:out>
                float inputs:in2 = 0.5
                float outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_alpha_mode_opaque>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/input_alpha_mode_opaque.exr"
        }
    }
}
