#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "boombox" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/gltf_pbr/boombox/boombox.mtlx"
                string sourceMaterial = "Material_boombox"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/boombox/SR_boombox.outputs:out>
        token outputs:surface.connect = </Looks/boombox/SR_boombox.outputs:out>

        def Shader "image_basecolor"
        {
            uniform token info:id = "ND_gltf_colorimage"
            asset inputs:file = @../../_assets/Materials/surfaces/gltf_pbr/boombox/textures/BoomBox_baseColor.png@ (
                colorSpace = "srgb_texture"
            )
            float outputs:outa
            color3f outputs:outcolor
        }

        def Shader "image_orm"
        {
            uniform token info:id = "ND_gltf_image_vector3_vector3_1_0"
            asset inputs:file = @../../_assets/Materials/surfaces/gltf_pbr/boombox/textures/BoomBox_occlusionRoughnessMetallic.png@
            float3 outputs:out
        }

        def Shader "image_normal"
        {
            uniform token info:id = "ND_gltf_normalmap_vector3_1_0"
            asset inputs:file = @../../_assets/Materials/surfaces/gltf_pbr/boombox/textures/BoomBox_normal.png@
            float3 outputs:out
        }

        def Shader "image_emission"
        {
            uniform token info:id = "ND_gltf_image_color3_color3_1_0"
            asset inputs:file = @../../_assets/Materials/surfaces/gltf_pbr/boombox/textures/BoomBox_emissive.png@ (
                colorSpace = "srgb_texture"
            )
            color3f outputs:out
        }

        def Shader "image_orm_channels"
        {
            uniform token info:id = "ND_separate3_vector3"
            float3 inputs:in.connect = </Looks/boombox/image_orm.outputs:out>
            float outputs:outx
            float outputs:outy
            float outputs:outz
        }

        def Shader "SR_boombox"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:alpha.connect = </Looks/boombox/image_basecolor.outputs:outa>
            color3f inputs:base_color.connect = </Looks/boombox/image_basecolor.outputs:outcolor>
            color3f inputs:emissive.connect = </Looks/boombox/image_emission.outputs:out>
            float inputs:metallic.connect = </Looks/boombox/image_orm_channels.outputs:outz>
            float3 inputs:normal.connect = </Looks/boombox/image_normal.outputs:out>
            float inputs:occlusion.connect = </Looks/boombox/image_orm_channels.outputs:outx>
            float inputs:roughness.connect = </Looks/boombox/image_orm_channels.outputs:outy>
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/boombox>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/gltf_pbr/boombox.exr"
        }
    }
}
