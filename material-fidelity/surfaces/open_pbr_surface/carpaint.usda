#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "carpaint" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/carpaint/carpaint.mtlx"
                string sourceMaterial = "Car_Paint"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/carpaint/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/carpaint/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.1, 0.6, 0.9)
            float inputs:coat_ior = 1.6
            float inputs:coat_roughness = 0.02
            float inputs:coat_weight = 1
            float inputs:specular_ior = 1.6
            float inputs:specular_roughness = 0.3
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/carpaint>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/carpaint.exr"
        }
    }
}
