#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "coat_color_variation" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/coat_color_variation/coat_color_variation.mtlx"
                string sourceMaterial = "CoatColorVariation"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/coat_color_variation/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/coat_color_variation/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.8, 0.8, 0.8)
            float inputs:base_metalness = 0
            float inputs:base_weight = 1
            color3f inputs:coat_color = (0.2, 0.9, 0.35)
            float inputs:coat_roughness = 0.05
            float inputs:coat_weight = 1
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_roughness = 0.25
            float inputs:specular_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/coat_color_variation>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/coat_color_variation.exr"
        }
    }
}
