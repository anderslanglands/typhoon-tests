#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ketchup" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/ketchup/ketchup.mtlx"
                string sourceMaterial = "Ketchup"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ketchup/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/ketchup/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.164, 0.006, 0.002)
            float inputs:specular_ior = 1.3
            float inputs:specular_roughness = 0
            color3f inputs:subsurface_color = (0.164, 0.006, 0.002)
            float inputs:subsurface_radius = 0.01
            color3f inputs:subsurface_radius_scale = (0.476, 0.058, 0.039)
            float inputs:subsurface_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ketchup>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/ketchup.exr"
        }
    }
}
