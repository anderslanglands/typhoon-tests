#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "velvet" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/velvet/velvet.mtlx"
                string sourceMaterial = "Velvet"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/velvet/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/velvet/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.02, 0.02, 0.02)
            color3f inputs:fuzz_color = (0.4, 0.4, 0.4)
            float inputs:fuzz_roughness = 0.5
            float inputs:fuzz_weight = 1
            float inputs:specular_roughness = 0.8
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/velvet>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/velvet.exr"
        }
    }
}
