#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_fuzz_sheenlike" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/input_fuzz_sheenlike/input_fuzz_sheenlike.mtlx"
                string sourceMaterial = "input_fuzz_sheenlike"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_fuzz_sheenlike/open_pbr_surface_sheen.outputs:out>
        token outputs:surface.connect = </Looks/input_fuzz_sheenlike/open_pbr_surface_sheen.outputs:out>

        def Shader "open_pbr_surface_sheen"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.2, 0.4, 0.8)
            float inputs:base_metalness = 0
            float inputs:base_weight = 1
            color3f inputs:fuzz_color = (1, 0.9, 0.7)
            float inputs:fuzz_roughness = 0.3
            float inputs:fuzz_weight = 0.8
            float inputs:geometry_opacity = 1
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_roughness = 0.8
            float inputs:specular_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_fuzz_sheenlike>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/input_fuzz_sheenlike.exr"
        }
    }
}
