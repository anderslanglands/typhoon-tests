#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_coat_roughness_anisotropy" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/input_coat_roughness_anisotropy/input_coat_roughness_anisotropy.mtlx"
                string sourceMaterial = "input_coat_roughness_anisotropy"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_coat_roughness_anisotropy/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/input_coat_roughness_anisotropy/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:coat_roughness = 0.4
            float inputs:coat_roughness_anisotropy = 0.8
            float inputs:coat_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_coat_roughness_anisotropy>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/input_coat_roughness_anisotropy.exr"
        }
    }
}
