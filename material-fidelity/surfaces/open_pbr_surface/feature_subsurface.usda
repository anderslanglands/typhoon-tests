#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_subsurface" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/feature_subsurface/feature_subsurface.mtlx"
                string sourceMaterial = "M_feature_subsurface"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_subsurface/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_subsurface/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.55, 0.9, 0.35)
            float inputs:subsurface_radius = 0.01
            float inputs:subsurface_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_subsurface>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/feature_subsurface.exr"
        }
    }
}
