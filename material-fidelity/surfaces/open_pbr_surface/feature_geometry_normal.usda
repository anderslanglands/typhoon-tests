#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_geometry_normal" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/feature_geometry_normal/feature_geometry_normal.mtlx"
                string sourceMaterial = "M_feature_geometry_normal"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_geometry_normal/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_geometry_normal/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.65, 0.45, 0.95)
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_geometry_normal>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/feature_geometry_normal.exr"
        }
    }
}
