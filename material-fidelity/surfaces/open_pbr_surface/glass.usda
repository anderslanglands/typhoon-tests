#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "glass" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/glass/glass.mtlx"
                string sourceMaterial = "Glass"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/glass/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/glass/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:specular_ior = 1.52
            float inputs:specular_roughness = 0
            float inputs:transmission_dispersion_abbe_number = 64
            float inputs:transmission_dispersion_scale = 1
            float inputs:transmission_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/glass>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/glass.exr"
        }
    }
}
