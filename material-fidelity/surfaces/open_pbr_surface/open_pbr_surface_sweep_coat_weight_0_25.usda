#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "open_pbr_surface_sweep_coat_weight_0_25" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/open_pbr_surface_sweep_coat_weight_0_25/open_pbr_surface_sweep_coat_weight_0_25.mtlx"
                string sourceMaterial = "open_pbr_surface_sweep_coat_weight_0_25"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/open_pbr_surface_sweep_coat_weight_0_25/SR_open_pbr_surface_sweep_coat_weight_0_25.outputs:out>
        token outputs:surface.connect = </Looks/open_pbr_surface_sweep_coat_weight_0_25/SR_open_pbr_surface_sweep_coat_weight_0_25.outputs:out>

        def Shader "SR_open_pbr_surface_sweep_coat_weight_0_25"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.2, 0.78, 0.82)
            float inputs:base_metalness = 0
            float inputs:base_weight = 1
            float inputs:coat_roughness = 0.12
            float inputs:coat_weight = 0.25
            float inputs:fuzz_weight = 0
            float inputs:geometry_opacity = 1
            float inputs:specular_roughness = 0.18
            float inputs:specular_weight = 1
            float inputs:thin_film_thickness = 0
            float inputs:thin_film_weight = 0
            float inputs:transmission_weight = 0
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/open_pbr_surface_sweep_coat_weight_0_25>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/open_pbr_surface_sweep_coat_weight_0_25.exr"
        }
    }
}
