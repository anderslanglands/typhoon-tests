#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_thin_film" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/feature_thin_film/feature_thin_film.mtlx"
                string sourceMaterial = "M_feature_thin_film"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_thin_film/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_thin_film/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.3, 0.85, 0.8)
            float inputs:thin_film_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_thin_film>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/feature_thin_film.exr"
        }
    }
}
