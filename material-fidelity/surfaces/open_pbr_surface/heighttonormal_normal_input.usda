#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "heighttonormal_normal_input" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/heighttonormal_normal_input/heighttonormal_normal_input.mtlx"
                string sourceMaterial = "HeightToNormal_NormalInput"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/heighttonormal_normal_input/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/heighttonormal_normal_input/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.5, 0.5, 0.5)
            float3 inputs:geometry_normal.connect = </Looks/heighttonormal_normal_input/NG_heighttonormal_normal_input.outputs:out_normal>
            float inputs:specular_roughness = 0.25
            token outputs:out
        }

        def NodeGraph "NG_heighttonormal_normal_input"
        {
            float3 outputs:out_normal.connect = </Looks/heighttonormal_normal_input/NG_heighttonormal_normal_input/normal_from_height.outputs:out>

            def Shader "height_image"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 0.5
                asset inputs:file = @../../_assets/Materials/open_pbr_surface/heighttonormal_normal_input/textures/grid.png@
                float outputs:out
            }

            def Shader "height_to_normal"
            {
                uniform token info:id = "ND_heighttonormal_vector3"
                float inputs:in.connect = </Looks/heighttonormal_normal_input/NG_heighttonormal_normal_input/height_image.outputs:out>
                float inputs:scale = 2
                float3 outputs:out
            }

            def Shader "normal_from_height"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </Looks/heighttonormal_normal_input/NG_heighttonormal_normal_input/height_to_normal.outputs:out>
                float inputs:scale = 1
                float3 outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/heighttonormal_normal_input>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/heighttonormal_normal_input.exr"
        }
    }
}
