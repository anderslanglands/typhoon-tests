#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_base_diffuse_roughness" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/input_base_diffuse_roughness/input_base_diffuse_roughness.mtlx"
                string sourceMaterial = "input_base_diffuse_roughness"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_base_diffuse_roughness/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/input_base_diffuse_roughness/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:base_diffuse_roughness = 0.7
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_base_diffuse_roughness>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/input_base_diffuse_roughness.exr"
        }
    }
}
