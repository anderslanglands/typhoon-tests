#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "input_transmission_scatter_anisotropy" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/open_pbr_surface/input_transmission_scatter_anisotropy/input_transmission_scatter_anisotropy.mtlx"
                string sourceMaterial = "input_transmission_scatter_anisotropy"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/input_transmission_scatter_anisotropy/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/input_transmission_scatter_anisotropy/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:transmission_depth = 0.3
            color3f inputs:transmission_scatter = (0.4, 0.2, 0.1)
            float inputs:transmission_scatter_anisotropy = 0.85
            float inputs:transmission_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/input_transmission_scatter_anisotropy>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/open_pbr_surface/input_transmission_scatter_anisotropy.exr"
        }
    }
}
