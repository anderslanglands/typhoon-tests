#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "transmission_only" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/transmission_only/transmission_only.mtlx"
                string sourceMaterial = "mat_transmission_only_test"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/transmission_only/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/transmission_only/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (1, 1, 1)
            float inputs:metalness = 0
            float inputs:specular_IOR = 1.5
            float inputs:specular_roughness = 0.05
            float inputs:transmission = 1
            color3f inputs:transmission_color = (1, 1, 1)
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/transmission_only>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/transmission_only.exr"
        }
    }
}
