#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_emission" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/feature_emission/feature_emission.mtlx"
                string sourceMaterial = "M_feature_emission"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_emission/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_emission/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.08, 0.08, 0.1)
            float inputs:emission = 0.5
            color3f inputs:emission_color = (0.2, 0.42, 0.5)
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_emission>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/feature_emission.exr"
        }
    }
}
