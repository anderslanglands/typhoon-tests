#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "jade_translucent" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/jade_translucent/jade_translucent.mtlx"
                string sourceMaterial = "Jade"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/jade_translucent/SR_jade.outputs:out>
        token outputs:surface.connect = </Looks/jade_translucent/SR_jade.outputs:out>

        def Shader "SR_jade"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0.5
            color3f inputs:base_color = (0.0603, 0.4398, 0.1916)
            float inputs:specular_anisotropy = 0.5
            float inputs:specular_IOR = 2.418
            float inputs:specular_roughness = 0.25
            float inputs:subsurface = 0.4
            color3f inputs:subsurface_color = (0.0603, 0.4398, 0.1916)
            float inputs:subsurface_scale = 0.01
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/jade_translucent>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/jade_translucent.exr"
        }
    }
}
