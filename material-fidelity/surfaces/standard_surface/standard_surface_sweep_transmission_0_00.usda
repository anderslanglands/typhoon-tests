#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "standard_surface_sweep_transmission_0_00" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/standard_surface_sweep_transmission_0_00/standard_surface_sweep_transmission_0_00.mtlx"
                string sourceMaterial = "standard_surface_sweep_transmission_0_00"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/standard_surface_sweep_transmission_0_00/SR_standard_surface_sweep_transmission_0_00.outputs:out>
        token outputs:surface.connect = </Looks/standard_surface_sweep_transmission_0_00/SR_standard_surface_sweep_transmission_0_00.outputs:out>

        def Shader "SR_standard_surface_sweep_transmission_0_00"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0.7
            color3f inputs:base_color = (0.06, 0.14, 0.32)
            float inputs:coat = 0
            float inputs:metalness = 0
            color3f inputs:opacity = (1, 1, 1)
            float inputs:sheen = 0
            float inputs:specular = 1
            float inputs:specular_roughness = 0.08
            float inputs:thin_film_thickness = 0
            float inputs:transmission = 0
            color3f inputs:transmission_color = (0.95, 0.98, 1)
            float inputs:transmission_depth = 0.7
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/standard_surface_sweep_transmission_0_00>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/standard_surface_sweep_transmission_0_00.exr"
        }
    }
}
