#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "ior" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/ior/ior.mtlx"
                string sourceMaterial = "mat_ior_test"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/ior/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/ior/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.9, 0.9, 0.9)
            float inputs:metalness = 0
            float inputs:specular_IOR = 2.4
            float inputs:specular_roughness = 0
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/ior>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/ior.exr"
        }
    }
}
