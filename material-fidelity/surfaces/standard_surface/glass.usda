#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "glass" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/glass/glass.mtlx"
                string sourceMaterial = "Glass"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/glass/SR_glass.outputs:out>
        token outputs:surface.connect = </Looks/glass/SR_glass.outputs:out>

        def Shader "SR_glass"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            color3f inputs:opacity = (1, 1, 1) (
                colorSpace = "lin_rec709"
            )
            float inputs:specular = 1
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_IOR = 1.52
            float inputs:specular_roughness = 0.01
            float inputs:transmission = 1
            color3f inputs:transmission_color = (1, 1, 1)
            float inputs:transmission_depth = 0
            float inputs:transmission_dispersion = 0
            float inputs:transmission_extra_roughness = 0
            color3f inputs:transmission_scatter = (0, 0, 0)
            float inputs:transmission_scatter_anisotropy = 0
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/glass>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/glass.exr"
        }
    }
}
