#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "sheen" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/sheen/sheen.mtlx"
                string sourceMaterial = "mat_sheen_test"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/sheen/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/sheen/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.2, 0.4, 0.8)
            float inputs:metalness = 0
            float inputs:sheen = 0.8
            color3f inputs:sheen_color = (1, 0.9, 0.7)
            float inputs:sheen_roughness = 0.3
            float inputs:specular_roughness = 0.8
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/sheen>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/sheen.exr"
        }
    }
}
