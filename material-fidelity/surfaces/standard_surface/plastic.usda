#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "plastic" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/plastic/plastic.mtlx"
                string sourceMaterial = "Plastic"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/plastic/SR_plastic.outputs:out>
        token outputs:surface.connect = </Looks/plastic/SR_plastic.outputs:out>

        def Shader "SR_plastic"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.10470402, 0.24188282, 0.818)
            float inputs:specular_roughness = 0.32467532
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/plastic>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/plastic.exr"
        }
    }
}
