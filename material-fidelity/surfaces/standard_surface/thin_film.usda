#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "thin_film" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/thin_film/thin_film.mtlx"
                string sourceMaterial = "ThinFilm"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/thin_film/SR_thin_film.outputs:out>
        token outputs:surface.connect = </Looks/thin_film/SR_thin_film.outputs:out>

        def Shader "SR_thin_film"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            color3f inputs:base_color = (1, 1, 1)
            float inputs:diffuse_roughness = 0
            float inputs:metalness = 0
            float inputs:specular = 1
            float inputs:specular_anisotropy = 0
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_IOR = 2.5
            float inputs:specular_rotation = 0
            float inputs:specular_roughness = 0.02
            float inputs:thin_film_IOR = 1.5
            float inputs:thin_film_thickness = 550
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/thin_film>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/thin_film.exr"
        }
    }
}
