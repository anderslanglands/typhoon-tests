#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "greysphere" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/greysphere/greysphere.mtlx"
                string sourceMaterial = "Greysphere"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/greysphere/SR_greysphere.outputs:out>
        token outputs:surface.connect = </Looks/greysphere/SR_greysphere.outputs:out>

        def Shader "SR_greysphere"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.18, 0.18, 0.18)
            float inputs:specular_roughness = 0.7
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/greysphere>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/greysphere.exr"
        }
    }
}
