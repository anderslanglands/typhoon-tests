#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "specular" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/specular/specular.mtlx"
                string sourceMaterial = "mat_specular_test"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/specular/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/specular/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.2, 0.2, 0.8)
            float inputs:metalness = 0
            float inputs:specular = 0.8
            color3f inputs:specular_color = (1, 0.8, 0.6)
            float inputs:specular_roughness = 0.05
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/specular>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/specular.exr"
        }
    }
}
