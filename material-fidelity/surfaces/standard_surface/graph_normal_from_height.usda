#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "graph_normal_from_height" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/graph_normal_from_height/graph_normal_from_height.mtlx"
                string sourceMaterial = "graph_normal_from_height"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/graph_normal_from_height/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/graph_normal_from_height/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.5, 0.5, 0.5)
            float3 inputs:normal.connect = </Looks/graph_normal_from_height/height_to_normal_example.outputs:out_normal>
            token outputs:out
        }

        def NodeGraph "height_to_normal_example"
        {
            float3 outputs:out_normal.connect = </Looks/graph_normal_from_height/height_to_normal_example/normal_from_height.outputs:out>

            def Shader "height_image"
            {
                uniform token info:id = "ND_image_float"
                float inputs:default = 0.5
                asset inputs:file = @../../_assets/Materials/surfaces/standard_surface/graph_normal_from_height/textures/grid.png@
                float outputs:out
            }

            def Shader "height_to_normal"
            {
                uniform token info:id = "ND_heighttonormal_vector3"
                float inputs:in.connect = </Looks/graph_normal_from_height/height_to_normal_example/height_image.outputs:out>
                float inputs:scale = 1
                float3 outputs:out
            }

            def Shader "normal_from_height"
            {
                uniform token info:id = "ND_normalmap_float"
                float3 inputs:in.connect = </Looks/graph_normal_from_height/height_to_normal_example/height_to_normal.outputs:out>
                float inputs:scale = 1
                float3 outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/graph_normal_from_height>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/graph_normal_from_height.exr"
        }
    }
}
