#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "feature_specular" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/feature_specular/feature_specular.mtlx"
                string sourceMaterial = "M_feature_specular"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/feature_specular/surface_shader1.outputs:out>
        token outputs:surface.connect = </Looks/feature_specular/surface_shader1.outputs:out>

        def Shader "surface_shader1"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color = (0.95, 0.75, 0.3)
            float inputs:specular = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/feature_specular>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/feature_specular.exr"
        }
    }
}
