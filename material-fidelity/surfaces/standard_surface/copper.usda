#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "copper" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/copper/copper.mtlx"
                string sourceMaterial = "Copper"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/copper/SR_copper.outputs:out>
        token outputs:surface.connect = </Looks/copper/SR_copper.outputs:out>

        def Shader "SR_copper"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (1, 1, 1)
            float inputs:coat = 1
            color3f inputs:coat_color = (0.96467984, 0.37626296, 0.25818297)
            float inputs:coat_roughness = 0.2
            float inputs:metalness = 1
            float inputs:specular = 0
            float inputs:specular_roughness = 0.25
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/copper>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/copper.exr"
        }
    }
}
