#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "greysphere_calibration" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/greysphere_calibration/greysphere_calibration.mtlx"
                string sourceMaterial = "Greysphere_Calibration"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/greysphere_calibration/SR_Greysphere_Calibration.outputs:out>
        token outputs:surface.connect = </Looks/greysphere_calibration/SR_Greysphere_Calibration.outputs:out>

        def Shader "SR_Greysphere_Calibration"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            color3f inputs:base_color.connect = </Looks/greysphere_calibration/NG_Greysphere_Calibration.outputs:out1>
            float inputs:specular_roughness = 0.7
            token outputs:out
        }

        def NodeGraph "NG_Greysphere_Calibration"
        {
            color3f outputs:out1.connect = </Looks/greysphere_calibration/NG_Greysphere_Calibration/image1.outputs:out>

            def Shader "texcoord1"
            {
                uniform token info:id = "ND_texcoord_vector2"
                float2 outputs:out
            }

            def Shader "place2d"
            {
                uniform token info:id = "ND_place2d_vector2"
                float2 inputs:offset = (-1.66, -0.49)
                float2 inputs:pivot = (0.5, 0.5)
                float2 inputs:scale = (0.21, 0.21)
                float2 inputs:texcoord.connect = </Looks/greysphere_calibration/NG_Greysphere_Calibration/texcoord1.outputs:out>
                float2 outputs:out
            }

            def Shader "image1"
            {
                uniform token info:id = "ND_image_color3"
                asset inputs:file = @../../_assets/Materials/surfaces/standard_surface/greysphere_calibration/textures/greysphere_calibration.png@ (
                    colorSpace = "srgb_texture"
                )
                float2 inputs:texcoord.connect = </Looks/greysphere_calibration/NG_Greysphere_Calibration/place2d.outputs:out>
                string inputs:uaddressmode = "clamp"
                string inputs:vaddressmode = "clamp"
                color3f outputs:out
            }
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/greysphere_calibration>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/greysphere_calibration.exr"
        }
    }
}
