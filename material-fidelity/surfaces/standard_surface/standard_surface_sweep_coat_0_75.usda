#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "standard_surface_sweep_coat_0_75" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/surfaces/standard_surface/standard_surface_sweep_coat_0_75/standard_surface_sweep_coat_0_75.mtlx"
                string sourceMaterial = "standard_surface_sweep_coat_0_75"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/standard_surface_sweep_coat_0_75/SR_standard_surface_sweep_coat_0_75.outputs:out>
        token outputs:surface.connect = </Looks/standard_surface_sweep_coat_0_75/SR_standard_surface_sweep_coat_0_75.outputs:out>

        def Shader "SR_standard_surface_sweep_coat_0_75"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0.8
            color3f inputs:base_color = (0.2, 0.78, 0.82)
            float inputs:coat = 0.75
            float inputs:coat_roughness = 0.12
            float inputs:metalness = 0
            color3f inputs:opacity = (1, 1, 1)
            float inputs:sheen = 0
            float inputs:specular = 0.8
            float inputs:specular_roughness = 0.2
            float inputs:thin_film_thickness = 0
            float inputs:transmission = 0
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/standard_surface_sweep_coat_0_75>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/surfaces/standard_surface/standard_surface_sweep_coat_0_75.exr"
        }
    }
}
