#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "metal_brushed" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/metal_brushed/metal_brushed.mtlx"
                string sourceMaterial = "Metal_Brushed"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/metal_brushed/SR_metal_brushed.outputs:out>
        token outputs:surface.connect = </Looks/metal_brushed/SR_metal_brushed.outputs:out>

        def Shader "SR_metal_brushed"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.5, 0.5, 0.5)
            float inputs:metalness = 1
            float inputs:specular = 0
            float inputs:specular_anisotropy = 0.65
            color3f inputs:specular_color = (0, 0, 0)
            float inputs:specular_IOR = 1.52
            float inputs:specular_rotation = 0
            float inputs:specular_roughness = 0.25
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/metal_brushed>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/standard_surface/metal_brushed.exr"
        }
    }
}
