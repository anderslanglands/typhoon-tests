#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "glass_tinted" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/glass_tinted/glass_tinted.mtlx"
                string sourceMaterial = "GlassTinted"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/glass_tinted/SR_glass_tinted.outputs:out>
        token outputs:surface.connect = </Looks/glass_tinted/SR_glass_tinted.outputs:out>

        def Shader "SR_glass_tinted"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 0
            float inputs:specular = 1
            color3f inputs:specular_color = (1, 1, 1)
            float inputs:specular_IOR = 1.54
            float inputs:specular_roughness = 0.15
            float inputs:transmission = 1
            color3f inputs:transmission_color = (0.2, 0.1, 1)
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/glass_tinted>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/standard_surface/glass_tinted.exr"
        }
    }
}
