#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "velvet" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/velvet/velvet.mtlx"
                string sourceMaterial = "Velvet"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/velvet/SR_velvet.outputs:out>
        token outputs:surface.connect = </Looks/velvet/SR_velvet.outputs:out>

        def Shader "SR_velvet"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.7, 0.05, 0.08)
            float inputs:sheen = 1
            color3f inputs:sheen_color = (1, 0.12, 0.18)
            float inputs:sheen_roughness = 0.3
            float inputs:specular = 0
            color3f inputs:specular_color = (0, 0, 0)
            float inputs:specular_IOR = 1.5
            float inputs:specular_roughness = 0.693
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/velvet>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/standard_surface/velvet.exr"
        }
    }
}
