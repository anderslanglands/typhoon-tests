#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "gold" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/standard_surface/gold/gold.mtlx"
                string sourceMaterial = "Gold"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/gold/SR_gold.outputs:out>
        token outputs:surface.connect = </Looks/gold/SR_gold.outputs:out>

        def Shader "SR_gold"
        {
            uniform token info:id = "ND_standard_surface_surfaceshader"
            float inputs:base = 1
            color3f inputs:base_color = (0.944, 0.776, 0.373)
            float inputs:metalness = 1
            float inputs:specular = 1
            color3f inputs:specular_color = (0.998, 0.981, 0.751)
            float inputs:specular_roughness = 0.02
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/gold>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/standard_surface/gold.exr"
        }
    }
}
