#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "pearl" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/pearl/pearl.mtlx"
                string sourceMaterial = "Pearl"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/pearl/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/pearl/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            color3f inputs:base_color = (0.8, 0.75, 0.7)
            float inputs:coat_ior = 1.68
            float inputs:coat_roughness = 0.15
            float inputs:coat_weight = 1
            float inputs:specular_ior = 1.5
            float inputs:specular_roughness = 0.35
            color3f inputs:subsurface_color = (0.8, 0.75, 0.7)
            color3f inputs:subsurface_radius_scale = (0.003, 0.005, 0.003)
            float inputs:subsurface_weight = 1
            float inputs:thin_film_ior = 2
            float inputs:thin_film_thickness = 0.42
            float inputs:thin_film_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/pearl>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/open_pbr_surface/pearl.exr"
        }
    }
}
