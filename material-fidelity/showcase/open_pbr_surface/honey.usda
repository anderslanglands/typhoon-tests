#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "honey" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/honey/honey.mtlx"
                string sourceMaterial = "Honey"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/honey/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/honey/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            float inputs:specular_ior = 1.504
            float inputs:specular_roughness = 0
            color3f inputs:transmission_color = (0.83, 0.4, 0.04)
            float inputs:transmission_depth = 2
            color3f inputs:transmission_scatter = (0.9, 0.9, 0.9)
            float inputs:transmission_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/honey>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/open_pbr_surface/honey.exr"
        }
    }
}
