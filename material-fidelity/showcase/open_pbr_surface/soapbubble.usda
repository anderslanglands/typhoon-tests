#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "soapbubble" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/open_pbr_surface/soapbubble/soapbubble.mtlx"
                string sourceMaterial = "Soap_Bubble"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/soapbubble/open_pbr_surface_surfaceshader.outputs:out>
        token outputs:surface.connect = </Looks/soapbubble/open_pbr_surface_surfaceshader.outputs:out>

        def Shader "open_pbr_surface_surfaceshader"
        {
            uniform token info:id = "ND_open_pbr_surface_surfaceshader"
            bool inputs:geometry_thin_walled = 1
            float inputs:specular_ior = 1
            float inputs:specular_roughness = 0
            float inputs:thin_film_ior = 1.4
            float inputs:thin_film_thickness = 0.5
            float inputs:thin_film_weight = 1
            float inputs:transmission_weight = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/soapbubble>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/open_pbr_surface/soapbubble.exr"
        }
    }
}
