#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "glass" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/gltf_pbr/glass/glass.mtlx"
                string sourceMaterial = "PBR_Glass"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/glass/SR_glass.outputs:out>
        token outputs:surface.connect = </Looks/glass/SR_glass.outputs:out>

        def Shader "SR_glass"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            float inputs:ior = 1.52
            float inputs:metallic = 0
            float inputs:roughness = 0.01
            float inputs:transmission = 1
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/glass>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/gltf_pbr/glass.exr"
        }
    }
}
