#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "carpaint" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/gltf_pbr/carpaint/carpaint.mtlx"
                string sourceMaterial = "PBR_Car_Paint"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/carpaint/SR_carpaint.outputs:out>
        token outputs:surface.connect = </Looks/carpaint/SR_carpaint.outputs:out>

        def Shader "SR_carpaint"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.0518895, 0.29606, 0.425324)
            float inputs:clearcoat = 1
            float inputs:metallic = 0
            float inputs:roughness = 0.4
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/carpaint>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/gltf_pbr/carpaint.exr"
        }
    }
}
