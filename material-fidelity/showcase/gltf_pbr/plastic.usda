#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    renderSettingsPrimPath = "/Render/Settings"
    subLayers = [
        @../../_assets/base.usda@,
        @../../_assets/Geometry/shaderball.usda@,
        @../../_assets/Lights/dome.usda@
    ]
    upAxis = "Y"
)

def Scope "Looks"
{
    def Material "plastic" (
        customData = {
            dictionary materialFidelity = {
                string source = "materials/showcase/gltf_pbr/plastic/plastic.mtlx"
                string sourceMaterial = "PBR_Plastic"
            }
        }
    )
    {
        token outputs:mtlx:surface.connect = </Looks/plastic/SR_plastic.outputs:out>
        token outputs:surface.connect = </Looks/plastic/SR_plastic.outputs:out>

        def Shader "SR_plastic"
        {
            uniform token info:id = "ND_gltf_pbr_surfaceshader"
            color3f inputs:base_color = (0.104704, 0.241883, 0.818)
            float inputs:metallic = 0
            float inputs:roughness = 0.324675
            token outputs:out
        }
    }
}

over "World"
{
    over "Geometry" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Looks/plastic>
    }
}

over "Render"
{
    over "Settings"
    {
        over "Product"
        {
            token productName = "material-fidelity/showcase/gltf_pbr/plastic.exr"
        }
    }
}
